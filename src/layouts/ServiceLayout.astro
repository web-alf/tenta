---
import BaseLayout from './BaseLayout.astro';
import ServiceHero from '@components/sections/service/ServiceHero.astro';
import FeaturesGrid from '@components/sections/service/FeaturesGrid.astro';
import PricingSection from '@components/sections/service/PricingSection.astro';
import ServiceProcess from '@components/sections/service/ServiceProcess.astro';
import ServiceFAQ from '@components/sections/service/ServiceFAQ.astro';
import ServiceCTA from '@components/sections/service/ServiceCTA.astro';
import { serviceJsonLd, faqJsonLd, breadcrumbJsonLd } from '@lib/seo';
import { site } from '@data/site';
import { getLang, useT } from '@i18n/utils';

interface Props {
  data: {
    title: string;
    title_en?: string;
    titleAccent: string;
    titleAccent_en?: string;
    eyebrow: string;
    eyebrow_en?: string;
    desc: string;
    desc_en?: string;
    icon: 'web' | 'google' | 'meta' | 'konsul';
    features: { icon?: string; iconId?: string; title: string; desc: string }[];
    features_en?: { icon?: string; iconId?: string; title: string; desc: string }[];
    plans: { name: string; tagline: string; price: string; unit: string; featured?: boolean; features: string[] }[];
    plans_en?: { name: string; tagline: string; price: string; unit: string; featured?: boolean; features: string[] }[];
    process: { title: string; desc: string }[];
    process_en?: { title: string; desc: string }[];
    faqs: { q: string; a: string }[];
    faqs_en?: { q: string; a: string }[];
    seo: { title: string; title_en?: string; description: string; description_en?: string; };
  };
  slug: string;
}

const { data, slug } = Astro.props;
const lang = getLang(Astro.currentLocale);
const t = useT(lang);

const serviceImages: Record<string, string> = {
  web:    '/assets/services/webdev.png',
  google: '/assets/services/google.png',
  meta:   '/assets/services/meta.png',
  konsul: '/assets/services/konsul.png',
};
const imgSrc = serviceImages[data.icon];

const url = lang === 'en' ? `${site.url}/en/layanan/${slug}` : `${site.url}/layanan/${slug}`;
const serviceKeywordMap: Record<string, string[]> = lang === 'en' ? {
  'website':     ['website development services', 'web developer indonesia', 'landing page services', 'company profile services', 'e-commerce website development'],
  'google-ads':  ['google ads services', 'google ads specialist', 'google advertising agency', 'search ads services', 'performance max indonesia', 'youtube ads agency'],
  'meta-ads':    ['meta ads services', 'facebook ads services', 'instagram ads services', 'meta ads specialist', 'facebook advertising agency', 'instagram advertising agency'],
  'konsultasi':  ['digital marketing consulting', 'digital marketing audit', 'online marketing consultant', 'digital marketing strategy'],
} : {
  'website':     ['jasa pembuatan website', 'jasa website semarang', 'web developer indonesia', 'jasa landing page', 'jasa company profile', 'jasa e-commerce'],
  'google-ads':  ['jasa google ads', 'google ads specialist', 'jasa iklan google', 'jasa search ads', 'performance max indonesia', 'jasa youtube ads'],
  'meta-ads':    ['jasa meta ads', 'jasa facebook ads', 'jasa instagram ads', 'meta ads specialist', 'jasa iklan facebook', 'jasa iklan instagram'],
  'konsultasi':  ['konsultasi digital marketing', 'audit digital marketing', 'konsultan marketing online', 'strategi marketing digital'],
};
const jsonLd = [
  serviceJsonLd({
    name: lang === 'en' && data.seo.title_en ? data.seo.title_en : data.seo.title,
    description: lang === 'en' && data.seo.description_en ? data.seo.description_en : data.seo.description,
    url,
    serviceType: data.eyebrow,
    plans: (lang === 'en' && data.plans_en ? data.plans_en : data.plans).map(p => ({ name: p.name, price: p.price })),
  }),
  faqJsonLd(lang === 'en' && data.faqs_en ? data.faqs_en : data.faqs),
  breadcrumbJsonLd([
    { name: lang === 'en' ? 'Home' : 'Beranda', url: lang === 'en' ? `${site.url}/en` : site.url },
    { name: lang === 'en' ? 'Services' : 'Layanan', url: lang === 'en' ? `${site.url}/en#layanan` : `${site.url}/#layanan` },
    { name: lang === 'en' && data.eyebrow_en ? data.eyebrow_en : data.eyebrow, url },
  ]),
];
---
<BaseLayout
  title={lang === 'en' && data.seo.title_en ? data.seo.title_en : data.seo.title}
  description={lang === 'en' && data.seo.description_en ? data.seo.description_en : data.seo.description}
  active="layanan"
  jsonLd={jsonLd}
  keywords={serviceKeywordMap[slug] ?? [data.eyebrow.toLowerCase()]}
>
  <ServiceHero
    eyebrow={lang === 'en' && data.eyebrow_en ? data.eyebrow_en : data.eyebrow}
    title={lang === 'en' && data.title_en ? data.title_en : data.title}
    titleAccent={lang === 'en' && data.titleAccent_en ? data.titleAccent_en : data.titleAccent}
    desc={lang === 'en' && data.desc_en ? data.desc_en : data.desc}
  >
    <!-- Ilustrasi per layanan dengan float animation (konsisten dengan beranda) -->
    <div slot="illustration" class="service-img-wrap">
      <picture>
        <source type="image/avif" srcset={imgSrc.replace('.png', '.avif')} />
        <source type="image/webp" srcset={imgSrc.replace('.png', '.webp')} />
        <img src={imgSrc} alt={data.eyebrow} class="service-hero-img" width="600" height="600" loading="eager" fetchpriority="high" decoding="async" />
      </picture>
    </div>
  </ServiceHero>
  <FeaturesGrid title={t('svc.features.title')} sub={t('svc.features.sub')} items={lang === 'en' && data.features_en ? data.features_en : data.features} />
  <PricingSection plans={lang === 'en' && data.plans_en ? data.plans_en : data.plans} service={data.eyebrow} />
  <ServiceProcess steps={lang === 'en' && data.process_en ? data.process_en : data.process} />
  <ServiceFAQ items={lang === 'en' && data.faqs_en ? data.faqs_en : data.faqs} />
  <ServiceCTA />
</BaseLayout>

<style>
  .service-img-wrap {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    /* Float animation — sama dengan kraken-float di beranda */
    animation: krakenFloat 4.5s ease-in-out infinite;
    filter: drop-shadow(0 24px 48px rgba(255, 107, 26, 0.18));
    will-change: transform;
  }
  .service-hero-img {
    width: 100%;
    max-width: 420px;
    height: auto;
    display: block;
  }
  @keyframes krakenFloat {
    0%, 100% { transform: translateY(0px) rotate(0deg); }
    25%       { transform: translateY(-14px) rotate(0.8deg); }
    75%       { transform: translateY(-6px) rotate(-0.5deg); }
  }
  @media (prefers-reduced-motion: reduce) {
    .service-img-wrap { animation: none; }
  }
  @media (max-width: 760px) {
    .service-hero-img { max-width: min(340px, 85vw); }
  }
</style>
