---
import '@styles/global.css';
import interWoff2 from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import jakartaWoff2 from '@fontsource-variable/plus-jakarta-sans/files/plus-jakarta-sans-latin-wght-normal.woff2?url';
import Header from '@components/layout/Header.astro';
import Footer from '@components/layout/Footer.astro';
import StickyWA from '@components/layout/StickyWA.astro';
import { site } from '@data/site';
import { organizationJsonLd, localBusinessJsonLd, websiteJsonLd } from '@lib/seo';
import { PUBLIC_GA_ID } from 'astro:env/client';
import { getAbsoluteLocaleUrl } from 'astro:i18n';
import { getLang, stripLocale } from '@i18n/utils';

const gaId = PUBLIC_GA_ID || 'G-7TZENR9L4G';
const gscVerification = site.verification.google;

const propLang = Astro.props.lang as 'en' | 'id' | undefined;
const lang = propLang || getLang(Astro.currentLocale);
// Cloudflare Pages menyajikan URL folder-style dengan trailing slash (versi 200).
// Samakan canonical/hreflang/og:url ke bentuk itu agar tak kena 307 redirect
// (yang memutus handshake Tag Assistant + inkonsisten SEO). Query & hash tak dipakai di sini.
const withSlash = (u: string): string => {
  const [base, ...rest] = u.split(/([?#])/);
  const tail = rest.length ? rest.join('') : '';
  if (/\.[a-z0-9]+$/i.test(base)) return u; // file (mis. .xml) — jangan tambah slash
  return (base.endsWith('/') ? base : base + '/') + tail;
};
const basePath = stripLocale(Astro.url.pathname);
const hrefId = withSlash(getAbsoluteLocaleUrl('id', basePath));
const hrefEn = withSlash(getAbsoluteLocaleUrl('en', basePath));
const ogLocale = lang === 'en' ? 'en_US' : 'id_ID';
const ogLocaleAlt = lang === 'en' ? 'id_ID' : 'en_US';

// Scoped tracking: Khusus di Landing Page target iklan
const TARGET_LP_SLUGS = [
  'akun-meta-ads-whitelist',
  'akun-google-ads-whitelist',
  'akun-tiktok-ads-whitelist',
  'sewa-akun-whitelist',
  'jasa-pembuatan-website-after-sales-terbaik',
  'konsultasi-digital-marketing',
];
const rawPath = Astro.url.pathname.toLowerCase().replace(/\/+$/, '');
const isTargetLp = TARGET_LP_SLUGS.some((slug) => rawPath.endsWith(slug) || rawPath.includes(`/${slug}`));

export interface Props {
  lang?: 'en' | 'id';
  title: string;
  description?: string;
  image?: string;
  canonical?: string;
  noindex?: boolean;
  active?: 'beranda' | 'layanan' | 'case' | 'tentang' | 'karir' | 'snk' | 'faq' | 'kontak';
  preloadHeroSrc?: string;
  jsonLd?: Record<string, unknown>[];
  keywords?: string[];
  bareLayout?: boolean;
  bareHeader?: boolean;
  pageType?: 'website' | 'article' | 'profile';
  publishedTime?: string;
  modifiedTime?: string;
  gtmId?: string;
  disableGads?: boolean;
  themeColor?: string;
}

const {
  title,
  description = lang === 'en' ? site.description_en : site.description,
  image = site.defaultOgImage,
  canonical,
  noindex = false,
  active = 'beranda',
  preloadHeroSrc,
  jsonLd = [],
  keywords,
  bareLayout = false,
  bareHeader = false,
  pageType = 'website',
  publishedTime,
  modifiedTime,
  gtmId = 'GTM-N6FD2GVL',
  disableGads = false,
  themeColor = '#FF6B1A',
} = Astro.props;

const fullTitle = title.toLowerCase().includes('tentaklik') ? title : `${title} — Tentaklik`;
const url = new URL(Astro.url.pathname, site.url).toString();
const canonicalUrl = canonical ?? withSlash(url);
const ogImage = image.startsWith('http') ? image : new URL(image, site.url).toString();

const orgLd = organizationJsonLd();
const localBusinessLd = localBusinessJsonLd();
const websiteLd = websiteJsonLd();
const allLd = [orgLd, localBusinessLd, websiteLd, ...jsonLd];

const metaKeywords = (keywords ?? (lang === 'en' ? site.keywords_en : site.keywords) as unknown as string[]).join(', ');
const robotsContent = noindex
  ? 'noindex, nofollow'
  : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1';

const JSONLD_ESCAPE = new RegExp('[<>&\u2028\u2029]', 'g');
function safeJsonLd(value: unknown): string {
  return JSON.stringify(value).replace(JSONLD_ESCAPE, (ch) => '\\u' + ch.charCodeAt(0).toString(16).padStart(4, '0'));
}
---
<!DOCTYPE html>
<html lang={lang} dir="ltr">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />

    <!-- Block any outgoing AddToCart beacon to facebook.com/tr across all pages -->
    <script is:inline>
      (function() {
        function isBlocked(u, d) {
          var s = (String(u || '') + ' ' + String(d || '')).toLowerCase();
          return s.indexOf('facebook.com/tr') !== -1 && s.indexOf('addtocart') !== -1;
        }
        try {
          var imgDesc = Object.getOwnPropertyDescriptor(HTMLImageElement.prototype, 'src');
          if (imgDesc && imgDesc.set) {
            Object.defineProperty(HTMLImageElement.prototype, 'src', {
              set: function(url) {
                if (isBlocked(url)) return;
                return imgDesc.set.call(this, url);
              },
              get: function() { return imgDesc.get.call(this); }
            });
          }
        } catch(e) {}
        try {
          if (navigator.sendBeacon) {
            var sb = navigator.sendBeacon.bind(navigator);
            navigator.sendBeacon = function(url, data) {
              if (isBlocked(url, data)) return true;
              return sb(url, data);
            };
          }
        } catch(e) {}
        try {
          if (window.fetch) {
            var origFetch = window.fetch;
            window.fetch = function(input, init) {
              var u = typeof input === 'string' ? input : (input && input.url ? input.url : '');
              var b = init && init.body ? init.body : '';
              if (isBlocked(u, b)) return Promise.resolve(new Response(''));
              return origFetch.apply(this, arguments);
            };
          }
        } catch(e) {}
        try {
          var open = XMLHttpRequest.prototype.open;
          var send = XMLHttpRequest.prototype.send;
          XMLHttpRequest.prototype.open = function(_m, url) {
            this._blk = isBlocked(url);
            return open.apply(this, arguments);
          };
          XMLHttpRequest.prototype.send = function(data) {
            if (this._blk || isBlocked('', data)) return;
            return send.apply(this, arguments);
          };
        } catch(e) {}
      })();
    </script>

    {gtmId && (
      <Fragment>
        <!-- Google Tag Manager (stub sinkron; gtm.js dimuat deferred di bawah agar tidak memblokir main thread) -->
        <script is:inline set:html={`window.dataLayer=window.dataLayer||[];window.dataLayer.push({'gtm.start':new Date().getTime(),event:'gtm.js'});`}></script>
        <!-- End Google Tag Manager -->
      </Fragment>
    )}

    {isTargetLp && (
      <Fragment>
        <!-- Meta Pixel Code (stub sinkron; fbevents.js dimuat deferred agar tidak menambah TBT) -->
        <script is:inline set:html={`
          !function(f,b,e,v,n,t,s)
          {if(f.fbq)return;
          var _cm;
          n=f.fbq=function(){
            if(arguments[0]==='track' && arguments[1]==='AddToCart') return;
            n.callMethod?n.callMethod.apply(n,arguments):n.queue.push(arguments)
          };
          Object.defineProperty(n,'callMethod',{
            configurable:true,enumerable:true,
            get:function(){return _cm;},
            set:function(fn){
              _cm=function(){
                if(arguments[0]==='track' && arguments[1]==='AddToCart') return;
                return fn.apply(this,arguments);
              };
            }
          });
          if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
          n.queue=[]}(window, document,'script',
          'https://connect.facebook.net/en_US/fbevents.js');
          fbq('set', 'autoConfig', false, '1341980327384883');
          fbq('init', '1341980327384883');
          fbq('track', 'PageView');
        `}></script>
        <noscript><img height="1" width="1" style="display:none"
          src="https://www.facebook.com/tr?id=1341980327384883&ev=PageView&noscript=1"
        /></noscript>
        <!-- End Meta Pixel Code -->

        <!-- TikTok Pixel Code (stub sinkron; events.js dimuat deferred agar tidak menambah TBT) -->
        <script is:inline set:html={`
          !function (w, d, t) {
            w.TiktokAnalyticsObject=t;var ttq=w[t]=w[t]||[];ttq.methods=["page","track","identify","instances","debug","on","off","once","ready","alias","group","enableCookie","disableCookie","holdConsent","revokeConsent","grantConsent"],ttq.setAndDefer=function(t,e){t[e]=function(){t.push([e].concat(Array.prototype.slice.call(arguments,0)))}};for(var i=0;i<ttq.methods.length;i++)ttq.setAndDefer(ttq,ttq.methods[i]);ttq.instance=function(t){for(
            var e=ttq._i[t]||[],n=0;n<ttq.methods.length;n++)ttq.setAndDefer(e,ttq.methods[n]);return e},ttq.load=function(e,n){var r="https://analytics.tiktok.com/i18n/pixel/events.js";ttq._i=ttq._i||{},ttq._i[e]=[],ttq._i[e]._u=r,ttq._t=ttq._t||{},ttq._t[e]=+new Date,ttq._o=ttq._o||{},ttq._o[e]=n||{};ttq._pending=ttq._pending||[];ttq._pending.push(r+"?sdkid="+e+"&lib="+t)};
            ttq.load('DAOI0C3C77U88MSNV1I0');
            ttq.page();
          }(window, document, 'ttq');
        `}></script>
        <!-- End TikTok Pixel Code -->
      </Fragment>
    )}

    <meta http-equiv="X-Content-Type-Options" content="nosniff" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />

    {gscVerification && <meta name="google-site-verification" content={gscVerification} />}

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={metaKeywords} />
    <meta name="author" content={site.legalName} />
    <meta name="publisher" content={site.legalName} />
    <meta name="copyright" content={site.legalName} />
    <meta name="robots" content={robotsContent} />
    <meta name="googlebot" content={robotsContent} />
    <meta name="bingbot" content={robotsContent} />
    <meta name="rating" content="general" />
    <meta name="language" content="Indonesian" />
    <meta name="distribution" content="global" />
    <meta name="revisit-after" content="7 days" />
    <meta name="format-detection" content="telephone=yes" />

    <meta name="theme-color" content={themeColor} media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content={themeColor} media="(prefers-color-scheme: dark)" />
    <meta name="msapplication-TileColor" content={themeColor} />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content={site.name} />
    <meta name="application-name" content={site.name} />
    <meta name="mobile-web-app-capable" content="yes" />

    <meta name="geo.region" content="ID-JT" />
    <meta name="geo.placename" content={`${site.geo.addressLocality}, ${site.geo.addressRegion}`} />
    <meta name="geo.position" content={`${site.geo.latitude};${site.geo.longitude}`} />
    <meta name="ICBM" content={`${site.geo.latitude}, ${site.geo.longitude}`} />

    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="id" href={hrefId} />
    <link rel="alternate" hreflang="en" href={hrefEn} />
    <link rel="alternate" hreflang="x-default" href={hrefId} />

    <meta property="og:type" content={pageType} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:secure_url" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.name} — ${description}`} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:locale:alternate" content={ogLocaleAlt} />
    {pageType === 'article' && publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {pageType === 'article' && modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    {pageType === 'article' && <meta property="article:publisher" content={site.social.facebook} />}
    {pageType === 'article' && <meta property="article:author" content={site.legalName} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content={site.twitterHandle} />
    <meta name="twitter:creator" content={site.twitterHandle} />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={`${site.name} — ${description}`} />
    <meta name="twitter:domain" content="tentaklik.com" />
    <meta name="twitter:url" content={canonicalUrl} />

    <link rel="icon" type="image/png" sizes="512x512" href="/icon-512.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/icon-32.png" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="mask-icon" href="/favicon.ico" color="#FF6B1A" />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
    <link rel="manifest" href="/manifest.webmanifest" />

    {preloadHeroSrc && preloadHeroSrc.includes('tentaklik-home-hero') ? (
      <Fragment set:html={`<link rel="preload" as="image" imagesrcset="/assets/brand/tentaklik-home-hero-480.avif 480w, /assets/brand/tentaklik-home-hero-720.avif 720w, /assets/brand/tentaklik-home-hero.avif 900w" imagesizes="(max-width: 768px) min(480px, 95vw), 440px" type="image/avif" fetchpriority="high" />`} />
    ) : preloadHeroSrc ? (
      <Fragment set:html={`<link rel="preload" as="image" imagesrcset="/assets/kraken-hero-400.avif 400w, /assets/kraken-hero-560.avif 560w, /assets/kraken-hero-800.avif 800w" imagesizes="(max-width: 760px) min(480px, 95vw), 560px" type="image/avif" fetchpriority="high" />`} />
    ) : null}

    <link rel="dns-prefetch" href="https://wa.me" />
    <!-- Font self-hosted (@fontsource-variable via global.css); preload subset latin untuk FCP/LCP teks -->
    <link rel="preload" as="font" type="font/woff2" href={interWoff2} crossorigin="anonymous" />
    <link rel="preload" as="font" type="font/woff2" href={jakartaWoff2} crossorigin="anonymous" />

    <link rel="preconnect" href="https://www.googletagmanager.com" crossorigin />
    {gaId && <link rel="dns-prefetch" href="https://www.google-analytics.com" />}
    <!-- Google tag (gtag.js) — GA4 (opsional via env) + Google Ads conversion AW-304997094.
         Stub gtag sinkron agar semua pemanggilan gtag() tetap ter-queue; gtag.js dimuat deferred. -->
    {(!disableGads || gaId) && (
      <script
        is:inline
        set:html={`window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}gtag('js',new Date());${gaId ? `gtag('config','${gaId}');` : ''}${!disableGads ? `gtag('config','AW-304997094');` : ''}`}
      />
    )}
    <!-- End Google tag -->

    <!-- Deferred third-party loader: muat GTM/gtag/pixel setelah first interaction atau idle setelah load.
         Semua event yang terjadi sebelum script termuat tetap aman karena di-queue di dataLayer/fbq.queue/ttq. -->
    <script is:inline set:html={`
      (function(){
        var loaded=false;
        function inject(src){var s=document.createElement('script');s.async=true;s.src=src;document.head.appendChild(s);}
        function loadAll(){
          if(loaded)return;loaded=true;
          ${gtmId ? `inject('https://www.googletagmanager.com/gtm.js?id=${gtmId}');` : ''}
          ${(!disableGads || gaId) ? `inject('https://www.googletagmanager.com/gtag/js?id=${gaId || 'AW-304997094'}');` : ''}
          ${isTargetLp ? `inject('https://connect.facebook.net/en_US/fbevents.js');
          if(window.ttq&&window.ttq._pending){window.ttq._pending.forEach(inject);window.ttq._pending=[];}` : ''}
          ['pointerdown','keydown','touchstart','scroll'].forEach(function(ev){removeEventListener(ev,loadAll,{passive:true});});
        }
        ['pointerdown','keydown','touchstart','scroll'].forEach(function(ev){addEventListener(ev,loadAll,{passive:true,once:true});});
        if(document.readyState==='complete'){setTimeout(loadAll,3000);}
        else{addEventListener('load',function(){setTimeout(loadAll,3000);});}
      })();
    `}></script>


    <Fragment set:html={allLd.map(ld => `<script type="application/ld+json">${safeJsonLd(ld)}</script>`).join('\n')} />
    <slot name="head" />
  </head>
  <body>
    {gtmId && (
      <Fragment>
        <!-- Google Tag Manager (noscript) -->
        <noscript><iframe src={`https://www.googletagmanager.com/ns.html?id=${gtmId}`}
        height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
        <!-- End Google Tag Manager (noscript) -->
      </Fragment>
    )}
    {!bareHeader && <Header active={active} lang={lang} />}
    <main>
      <slot />
    </main>
    <Footer lang={lang} />
    {!bareLayout && <StickyWA />}

    <script>
      import { initReveal } from '@lib/reveal';
      import { trackLead, detectServiceFromUrl, type LeadService } from '@lib/tracking';

      initReveal();

      // Expose to window for inline scripts across any component
      (window as any).tentaklikTrackLead = trackLead;
      (window as any).detectServiceFromUrl = detectServiceFromUrl;

      // Centralized Lead Tracking on click (WhatsApp & Contact/CTA links)
      document.addEventListener('click', (e) => {
        const target = e.target as HTMLElement | null;
        const link = target?.closest('a') as HTMLAnchorElement | null;
        if (!link) return;

        try {
          const href = link.href || '';
          const url = new URL(href, window.location.origin);
          const isWhatsApp = url.hostname.includes('wa.me') || url.hostname.includes('whatsapp.com') || link.classList.contains('sticky-wa');
          const isContact = (url.pathname === '/kontak' || url.pathname === '/kontak/') && link.classList.contains('btn');
          const isForm = url.pathname.includes('/form-') && link.classList.contains('btn');

          if (isWhatsApp || isContact || isForm) {
            const currentPath = window.location.pathname.toLowerCase().replace(/\/+$/, '');
            const TARGET_LP_SLUGS = [
              'akun-meta-ads-whitelist',
              'akun-google-ads-whitelist',
              'akun-tiktok-ads-whitelist',
              'sewa-akun-whitelist',
              'jasa-pembuatan-website-after-sales-terbaik',
              'konsultasi-digital-marketing',
            ];
            const isLp = TARGET_LP_SLUGS.some((slug) => currentPath.endsWith(slug) || currentPath.includes('/' + slug));

            if (isLp) {
              const explicitService = link.getAttribute('data-service') as LeadService | null;
              let service: LeadService = explicitService || 'konsultasi';
              if (!explicitService) {
                if (currentPath.includes('akun-meta-ads-whitelist')) service = 'meta';
                else if (currentPath.includes('akun-google-ads-whitelist')) service = 'google';
                else if (currentPath.includes('akun-tiktok-ads-whitelist')) service = 'tiktok';
                else if (currentPath.includes('jasa-pembuatan-website-after-sales-terbaik')) service = 'website';
                else if (currentPath.includes('konsultasi-digital-marketing')) service = 'konsultasi';
              }

              trackLead({
                service: service,
                action: 'click_button',
                label: isWhatsApp ? 'WhatsApp Click' : 'CTA Click',
                sourceUrl: window.location.pathname,
              });
            }
          }

          // Zaraz fallback
          if ((window as any).zaraz) {
            if (url.pathname === '/kontak' || url.pathname === '/kontak/') {
              (window as any).zaraz.track('begin_checkout');
            }
            if (url.hostname === 'wa.me') {
              (window as any).zaraz.track('whatsapp_click');
            }
          }
        } catch {}
      });

      document.addEventListener('submit', () => {
        if (window.location.pathname.indexOf('/kontak') === 0 && (window as any).zaraz) {
          (window as any).zaraz.track('generate_lead');
        }
      });
    </script>
  </body>
</html>
