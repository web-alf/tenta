---
import { Image } from 'astro:assets';
import BaseLayout from '@layouts/BaseLayout.astro';
import ArrowRight from '@components/icons/ArrowRight.astro';
import { aboutPageJsonLd, breadcrumbJsonLd } from '@lib/seo';
import { site } from '@data/site';

import imgSono from '@/assets/tentang/sonoprabowo.avif';
import imgZabarjad from '@/assets/tentang/zabarjad.avif';
import imgAhzelan from '@/assets/tentang/ahzelan.avif';

const galeriImages = [
  '/assets/galeri/1.jpg', '/assets/galeri/2.jpg', '/assets/galeri/3.jpg',
  '/assets/galeri/4.jpg', '/assets/galeri/5.jpg', '/assets/galeri/6.jpg',
  '/assets/galeri/7.jpg', '/assets/galeri/8.jpg',
  '/assets/galeri/9.jpeg', '/assets/galeri/10.jpeg',
];

const values = [
  { iconId: 'target', title: 'Results > Vanity',     desc: 'What matters is conversion & ROI, not just reach or likes.' },
  { iconId: 'search', title: 'Transparent',         desc: 'Client owns the ad account, open data, clear fees from the start.' },
  { iconId: 'partner', title: 'Long-term Partner',  desc: 'Not a one-off vendor — we invest in your growth.' },
];

const team = [
  { name: 'Sono Prabowo. S.Kep., M.M., M.Pd.', role: 'Founder',                  image: imgSono },
  { name: 'Zabarjad Dliya U, S.H',             role: 'Chief Operating Officer',  image: imgZabarjad },
  { name: 'Ahzelan',                           role: 'Chief Technology Officer', image: imgAhzelan },
];

const url = `${site.url}/en/tentang`;
const jsonLd = [
  aboutPageJsonLd({ url }),
  breadcrumbJsonLd([
    { name: 'Home', url: site.url },
    { name: 'About Us', url },
  ]),
];
---
<BaseLayout
  title="About Tentaklik — Digital Marketing Agency in Semarang"
  description="Tentaklik is a digital marketing agency in Semarang focusing on real results — website development, Google Ads, Meta Ads, and consulting for brands in Indonesia."
  active="tentang"
  jsonLd={jsonLd}
  keywords={['about tentaklik', 'digital marketing agency semarang', 'tentaklik team', 'agency profile', 'digital agency semarang']}
>
  <section style="padding-top:56px;padding-bottom:40px;background:var(--bg-warm);">
    <div class="container" style="display:grid;grid-template-columns:1.2fr 1fr;gap:48px;align-items:center;">
      <div>
        <span class="eyebrow">About Tentaklik</span>
        <h1 style="font-size:48px;margin-top:18px;margin-bottom:18px;">
          A small kraken serious about <span style="color:var(--orange-500);">business growth</span>.
        </h1>
        <p style="font-size:17px;color:var(--ink-500);max-width:540px;">
          Tentaklik was born out of frustration: too many agencies promising the world but only delivering pretty reports. We chose a different path — focusing on meaningful numbers, neat execution, and long-term partnerships.
        </p>
      </div>
      <div style="display:flex;justify-content:center;">
        <div class="tentang-kraken-wrap">
          <picture>
            <source
              type="image/avif"
              srcset="/assets/kraken-hero-400.avif 400w, /assets/kraken-hero-560.avif 560w, /assets/kraken-hero-800.avif 800w, /assets/kraken-hero.avif 1200w"
              sizes="(max-width: 760px) min(480px, 92vw), 560px"
            />
            <source
              type="image/webp"
              srcset="/assets/kraken-hero-400.webp 400w, /assets/kraken-hero-560.webp 560w, /assets/kraken-hero-800.webp 800w, /assets/kraken-hero.webp 1200w"
              sizes="(max-width: 760px) min(480px, 92vw), 560px"
            />
            <img
              src="/assets/kraken-hero.png"
              alt="Tentaklik kraken"
              width="1200"
              height="960"
              loading="eager"
              fetchpriority="high"
              decoding="async"
              class="tentang-kraken"
            />
          </picture>
        </div>
      </div>
    </div>
  </section>

  <section>
    <div class="container">
      <h2 class="section-title">Our Values</h2>
      <p class="section-sub" style="margin-bottom:40px;">Three things we don't compromise on.</p>
      <div style="display:grid;grid-template-columns:repeat(3, 1fr);gap:20px;">
        {values.map(v => (
          <div class="card reveal">
            <div style="width:50px;height:50px;border-radius:14px;background:var(--orange-100);color:var(--orange-700);display:flex;align-items:center;justify-content:center;margin-bottom:14px;" aria-hidden="true">
              {v.iconId === 'target' && <svg width="26" height="26" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.8"/><circle cx="12" cy="12" r="3" fill="currentColor"/></svg>}
              {v.iconId === 'search' && <svg width="26" height="26" viewBox="0 0 24 24" fill="none"><circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="1.8"/><path d="M21 21l-4.35-4.35" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>}
              {v.iconId === 'partner' && <svg width="26" height="26" viewBox="0 0 24 24" fill="none"><path d="M20.84 4.61a5.5 5.5 0 00-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 00-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 000-7.78z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>}
            </div>
            <h3 style="font-size:18px;margin-bottom:8px;">{v.title}</h3>
            <p style="font-size:14px;color:var(--ink-500);">{v.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section style="background:var(--bg-warm);">
    <div class="container">
      <h2 class="section-title">Core Team</h2>
      <p class="section-sub" style="margin-bottom:40px;">The people working directly on your project.</p>
      <div style="display:flex;justify-content:center;gap:30px;flex-wrap:wrap;">
        {team.map(t => (
          <div class="card reveal" style="text-align:center;width:100%;max-width:340px;padding:36px 24px;">
            <div style="width:140px;height:140px;border-radius:50%;margin:0 auto 20px;overflow:hidden;padding:0;background:var(--ink-50);border:4px solid white;box-shadow:0 8px 24px rgba(14,27,42,0.08);">
              <Image src={t.image} alt={t.name} style="width:100%;height:100%;object-fit:cover;display:block;" />
            </div>
            <h3 style="font-size:18px;margin-bottom:8px;line-height:1.4;">{t.name}</h3>
            <p style="font-size:14px;color:var(--orange-600);font-weight:600;margin:0;">{t.role}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Galeri section -->
  <section>
    <div class="container">
      <h2 class="section-title">Gallery</h2>
      <p class="section-sub" style="margin-bottom:36px;">A glimpse into Tentaklik's team and atmosphere.</p>
      <div class="galeri-grid">
        {galeriImages.map((src, i) => (
          <div class={`galeri-item reveal ${i === 0 || i === 7 ? 'galeri-wide' : ''}`}>
            <img src={src} alt={`Tentaklik gallery ${i + 1}`} loading="lazy" decoding="async" />
          </div>
        ))}
      </div>
    </div>
  </section>

  <style>
    /* Galeri */
    .galeri-grid {
      display: grid;
      /* Desktop: 4 cols, image 1 & 8 wide for balanced 3-row layout */
      grid-template-columns: repeat(4, 1fr);
      grid-auto-rows: 220px;
      gap: 14px;
    }
    /* Wide images span 2 columns */
    .galeri-wide { grid-column: span 2; }

    .galeri-item {
      border-radius: 16px;
      overflow: hidden;
      position: relative;
      background: var(--ink-50);
    }
    .galeri-item img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
      transition: transform 0.45s ease;
    }
    .galeri-item::after {
      content: "";
      position: absolute;
      inset: 0;
      background: linear-gradient(to bottom, transparent 60%, rgba(14,27,42,0.18));
      transition: opacity 0.3s ease;
      border-radius: inherit;
      opacity: 0;
    }
    .galeri-item:hover img { transform: scale(1.06); }
    .galeri-item:hover::after { opacity: 1; }

    @media (max-width: 1100px) {
      .galeri-grid {
        grid-template-columns: repeat(3, 1fr);
        grid-auto-rows: 200px;
      }
      .galeri-wide { grid-column: span 2; }
    }
    @media (max-width: 760px) {
      .galeri-grid {
        grid-template-columns: 1fr 1fr;
        grid-auto-rows: 180px;
        gap: 10px;
      }
      .galeri-wide { grid-column: span 2; }
    }
    @media (max-width: 480px) {
      .galeri-grid {
        grid-auto-rows: 150px;
        gap: 8px;
      }
    }

    .tentang-kraken-wrap {
      width: 100%;
      max-width: 560px;
      animation: krakenFloat 4.5s ease-in-out infinite;
      will-change: transform;
    }
    .tentang-kraken-wrap :global(picture) { display: block; width: 100%; }
    :global(.tentang-kraken) {
      width: 100%;
      height: auto;
      display: block;
      filter: drop-shadow(0 20px 40px rgba(255, 107, 26, 0.18));
    }
    @keyframes krakenFloat {
      0%, 100% { transform: translateY(0px) rotate(0deg); }
      25%       { transform: translateY(-14px) rotate(0.8deg); }
      75%       { transform: translateY(-6px) rotate(-0.5deg); }
    }
    @media (prefers-reduced-motion: reduce) { .tentang-kraken-wrap { animation: none; } }
    @media (max-width: 760px) { .tentang-kraken-wrap { max-width: min(480px, 92vw); } }
  </style>

  <section style="padding-bottom:24px;">
    <div class="container">
      <div class="cta-banner reveal" style="background:var(--orange-500);">
        <div style="flex:1;position:relative;z-index:1;">
          <h3>Want to talk about your business?</h3>
          <p style="margin-top:8px;font-size:15px;opacity:0.95;">Free 30-minute consultation, no hard-selling.</p>
        </div>
        <a href="/en/kontak" class="btn btn-ghost">Free Consultation <ArrowRight size={14} /></a>
      </div>
    </div>
  </section>
</BaseLayout>
