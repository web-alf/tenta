---
import BaseLayout from '@layouts/BaseLayout.astro';
import Hero from '@components/sections/Hero.astro';
import ServicesGrid from '@components/sections/ServicesGrid.astro';
import CTABanner from '@components/sections/CTABanner.astro';
import Process from '@components/sections/Process.astro';
import Testimonials from '@components/sections/lp/LpTestimonials.astro';
import CaseStudiesPreview from '@components/sections/CaseStudiesPreview.astro';
import HomePricing from '@components/sections/HomePricing.astro';
import FAQ from '@components/sections/FAQ.astro';
import FinalCTA from '@components/sections/FinalCTA.astro';
import { faqJsonLd, itemListJsonLd } from '@lib/seo';
import { site } from '@data/site';
import { getCollection } from 'astro:content';
import { getLang, useT } from '@i18n/utils';

const lang = getLang(Astro.currentLocale);
const tr = useT(lang);

const faqs = await getCollection('faqs');
const services = await getCollection('services');

const serviceItems = services
  .sort((a, b) => a.id.localeCompare(b.id))
  .map(s => ({
    name: lang === 'en' && s.data.seo.title_en ? s.data.seo.title_en : s.data.seo.title,
    url: `${site.url}/en/layanan/${s.id}`,
    description: lang === 'en' && s.data.seo.description_en ? s.data.seo.description_en : s.data.seo.description,
  }));

const jsonLd = [
  faqJsonLd(faqs.map(f => ({ q: lang === 'en' && f.data.q_en ? f.data.q_en : f.data.q, a: lang === 'en' && f.data.a_en ? f.data.a_en : f.data.a }))),
  itemListJsonLd(serviceItems, 'Tentaklik Digital Marketing Services'),
];

---
<BaseLayout
  title="TentaKlik - Digital Marketing Specialist"
  description="Tentaklik.com offers digital marketing services including website development, Google Ads, Meta Ads (Facebook & Instagram), and business consulting."
  active="beranda"
  preloadHeroSrc="/assets/kraken-hero-560.avif"
  jsonLd={jsonLd}
  keywords={[
    'digital marketing agency semarang',
    'semarang digital marketing',
    'website development agency indonesia',
    'google ads agency',
    'meta ads agency',
    'facebook ads services',
    'instagram ads services',
    'digital marketing consultant',
    'online advertising agency indonesia',
    'tentaklik',
  ]}
>
  <Hero />
  <ServicesGrid />
  <CTABanner />
  <Process />
  <Testimonials title={tr('testi.title')} sub={tr('testi.sub')} />
  <CaseStudiesPreview />
  <HomePricing />
  <FAQ />
  <FinalCTA />
</BaseLayout>
