---
import BaseLayout from '@layouts/BaseLayout.astro';
import Check from '@components/icons/Check.astro';
import ArrowRight from '@components/icons/ArrowRight.astro';
import WhatsApp from '@components/icons/WhatsApp.astro';
import { serviceJsonLd, faqJsonLd, breadcrumbJsonLd } from '@lib/seo';
import { site } from '@data/site';

const url = `${site.url}/en/layanan/website`;

const pageSeo = {
  title: "Professional Website Development & High-Conversion Services — Tentaklik",
  description: "Professional website development services in Indonesia: high-converting landing pages, corporate company profiles, and e-commerce stores. Fast loading, mobile-first, SEO-ready, and conversion-focused.",
};

const clientLogos = [
  { src: '/assets/layanan/website/client-alfatihah-min.png', alt: 'Client Al-Fatihah' },
  { src: '/assets/layanan/website/client-alhuffadz-min.png', alt: 'Client Al-Huffadz' },
  { src: '/assets/layanan/website/client-mpa-min.png', alt: 'Client MPA' },
  { src: '/assets/layanan/website/client-bmh-min.png', alt: 'Client BMH' },
  { src: '/assets/layanan/website/client-sandaran-min.png', alt: 'Client Sandaran' },
  { src: '/assets/layanan/website/client-asgatour-min.png', alt: 'Client Asgatour' },
];

const portfolios = [
  {
    title: "PT. Grajevan",
    desc: "Corporate company profile featuring a contemporary and elegant design",
    img: "/assets/layanan/website/grajevan-mockup-min.png",
  },
  {
    title: "PT. Media Pelajar",
    desc: "Official educational equivalence exam platform built to regulatory standards",
    img: "/assets/layanan/website/jasa-ujian-persamaan-mockup-min.png",
  },
  {
    title: "Rumah Yatim Indonesia",
    desc: "Social foundation web platform with seamless online donation and crowdfunding features",
    img: "/assets/layanan/website/rumah-yatim-indonesia-mockup-min.png",
  },
  {
    title: "PT. Karya Kita",
    desc: "Interior architecture website integrated with live chat for direct client inquiries",
    img: "/assets/layanan/website/karya-kita-desain-mockup-min.png",
  },
  {
    title: "PT. Tunas Mobilindo",
    desc: "Luxury BMW showcase portal featuring comprehensive models and pricelists",
    img: "/assets/layanan/website/promo-bmw-mockup-min.png",
  },
  {
    title: "Aksi Indonesia",
    desc: "Non-profit charity foundation platform designed for community fundraising events",
    img: "/assets/layanan/website/aksi-indonesia-mockup-min.png",
  },
];

const features = [
  {
    title: "Elegant design",
    desc: "Modern, refined, and aesthetically compelling visual layout tailored to your brand",
    icon: "brush",
  },
  {
    title: "Stable & optimized hosting",
    desc: "High-performance infrastructure guarantees ultra-fast page load times worldwide",
    icon: "server",
  },
  {
    title: "Fully responsive",
    desc: "Engineered to deliver a flawless browsing experience across smartphones, tablets, and desktops",
    icon: "laptop",
  },
  {
    title: "Complete documentation",
    desc: "Intuitive administration dashboards and clear documentation for effortless management",
    icon: "book",
  },
  {
    title: "Stunning user experience",
    desc: "Keeps visitors engaged longer with intuitive navigation and frictionless interaction",
    icon: "sparkle",
  },
  {
    title: "SEO friendly",
    desc: "Built with clean semantic markup to achieve superior visibility on major search engines",
    icon: "search",
  },
];

const faqs = [
  {
    q: "How long does website development take?",
    a: "Development timelines depend on scope and materials, but standard projects typically take only 1–7 business days.",
  },
  {
    q: "What if I don't have technical skills?",
    a: "No worries at all! We provide personalized onboarding and clear step-by-step guidance until you feel completely confident managing your site.",
  },
  {
    q: "Can pricing be customized to fit my budget?",
    a: "Absolutely. Let's discuss your exact project goals so we can recommend the most effective and economical solution.",
  },
  {
    q: "Do you offer after-sales technical support?",
    a: "Yes! Once you partner with us, you receive continuous technical support and error warranties completely FREE.",
  },
];

const pageKeywords = [
  'website development services',
  'web developer indonesia',
  'professional website creation',
  'landing page services',
  'company profile website',
  'ecommerce website development',
  'custom web design',
  'tentaklik',
];

const jsonLd = [
  serviceJsonLd({
    name: pageSeo.title,
    description: pageSeo.description,
    url,
    serviceType: "Website Development Services",
    plans: [
      { name: "Starter", price: "3990000" },
      { name: "Standard", price: "5940000" },
      { name: "Bisnis", price: "7490000" },
    ],
  }),
  faqJsonLd(faqs),
  breadcrumbJsonLd([
    { name: 'Home', url: `${site.url}/en` },
    { name: 'Services', url: `${site.url}/en/#layanan` },
    { name: 'Website Development', url },
  ]),
];
---

<BaseLayout
  lang="en"
  title={pageSeo.title}
  description={pageSeo.description}
  keywords={pageKeywords}
  image="/assets/services/webdev.png"
  active="layanan"
  jsonLd={jsonLd}
>
  <!-- 1. Hero Section -->
  <section class="v2-hero">
    <div aria-hidden="true" style="position:absolute;inset:0;pointer-events:none;z-index:0;">
      <div style="position:absolute;top:-80px;right:-120px;width:520px;height:520px;border-radius:50%;background:radial-gradient(circle, rgba(255,122,26,0.10), rgba(255,122,26,0) 70%);"></div>
      <div style="position:absolute;bottom:-60px;left:-100px;width:360px;height:360px;border-radius:50%;background:radial-gradient(circle, rgba(255,122,26,0.06), rgba(255,122,26,0) 70%);"></div>
    </div>
    <div class="container v2-hero-grid" style="position:relative;z-index:1;">
      <div class="v2-hero-content">
        <h1 class="v2-hero-title">
          Make your business <span style="color:var(--orange-500);">10X more advanced</span> with a website
        </h1>
        
        <div class="v2-hero-desc">
          <p>Not the #1 website development agency, but always dedicated to delivering peak results for you.</p>
          <p>Starting from an affordable 799K budget, get a professional website custom-built for your business goals.</p>
        </div>
        
        <div class="v2-hero-cta">
          <a href="#buat" class="btn btn-primary" title="buat">
            <span>Build now!</span>
            <ArrowRight size={16} />
          </a>
          <a
            href="https://api.whatsapp.com/send?phone=6285129992225&#038;text=Hello%2C%20I%20would%20like%20to%20consult%20about%20a%20website"
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-ghost"
            title="konsul"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"/></svg>
            <span>Consult now</span>
            <ArrowRight size={16} />
          </a>
        </div>

        <div class="v2-hero-badges">
          <div class="v2-badge-item">
            <span class="v2-badge-icon"><Check size={13} /></span>
            <span>Lifetime warranty</span>
          </div>
          <div class="v2-badge-item">
            <span class="v2-badge-icon"><Check size={13} /></span>
            <span>Free regular revisions</span>
          </div>
          <div class="v2-badge-item">
            <span class="v2-badge-icon"><Check size={13} /></span>
            <span>Free consultation</span>
          </div>
        </div>
      </div>
      
      <div class="v2-hero-visual">
        <div class="v2-hero-img-box">
          <img
            src="/assets/layanan/website/jasa-pembuatan-website-hero.webp"
            alt="Professional Website Development Services"
            width="560"
            height="480"
            fetchpriority="high"
            decoding="async"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- 2. Solusi Masalah Section (4 Poin) -->
  <section class="v2-problem-section">
    <div class="container">
      <div class="v2-section-head">
        <h2 class="v2-sec-title">Often experiencing these issues when creating a website?</h2>
        <p class="v2-sec-subtitle">Many assume building a website is complicated, expensive, and yields no return. In reality, the issue comes down to selecting the wrong development partner.</p>
      </div>

      <div class="v2-problem-grid">
        <div class="v2-prob-card">
          <div class="v2-prob-num">01</div>
          <div class="v2-prob-body">
            <h3>High costs, subpar results</h3>
            <p>You paid millions of rupiah only to end up with an outdated design that falls short of expectations</p>
          </div>
        </div>

        <div class="v2-prob-card">
          <div class="v2-prob-num">02</div>
          <div class="v2-prob-body">
            <h3>Slow & delayed delivery</h3>
            <p>Promised within a week, yet weeks slip past with no clear communication or project updates</p>
          </div>
        </div>

        <div class="v2-prob-card">
          <div class="v2-prob-num">03</div>
          <div class="v2-prob-body">
            <h3>Poor after-sales support</h3>
            <p>As soon as the site launches, you are left abandoned whenever bugs or technical glitches arise</p>
          </div>
        </div>

        <div class="v2-prob-card">
          <div class="v2-prob-num">04</div>
          <div class="v2-prob-body">
            <h3>Not mobile friendly</h3>
            <p>Broken smartphone layouts drive prospective buyers away before they even consider converting</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. Nilai / 3 Pilar Section -->
  <section class="v2-values-section">
    <div class="container v2-values-grid">
      <div class="v2-values-cards">
        <div class="v2-value-card">
          <div class="v2-value-icon">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          </div>
          <div>
            <h3>Trusted credibility</h3>
            <p>A dedicated website instantly elevates your brand reputation and authority far beyond standard social media profiles</p>
          </div>
        </div>

        <div class="v2-value-card">
          <div class="v2-value-icon">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="2" x2="22" y1="12" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
          </div>
          <div>
            <h3>Broader market reach</h3>
            <p>An online presence empowers customers across regions to discover your products easily and accelerate revenue</p>
          </div>
        </div>

        <div class="v2-value-card">
          <div class="v2-value-icon">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="14" x="2" y="3" rx="2"/><line x1="8" x2="16" y1="21" y2="21"/><line x1="12" x2="12" y1="17" y2="21"/></svg>
          </div>
          <div>
            <h3>Systematized operations</h3>
            <p>Beyond marketing, a web platform serves as an operational asset for inquiries, customer support, and order processing</p>
          </div>
        </div>
      </div>

      <div class="v2-values-info">
        <h2 class="v2-sec-title">The ultimate website development solution</h2>
        <div class="v2-sec-desc">
          <p>Don't just take our word for it—our web development solutions have empowered hundreds of entrepreneurs, SMEs, and brands to scale online effortlessly.</p>
          <p>Many businesses hit a ceiling by clinging to manual, inefficient legacy methods. The time to transition into the digital era is now.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 4. Client Logos Bar & Stats -->
  <section class="v2-clients-section">
    <div class="container">
      <div class="v2-clients-header">
        <h2 class="v2-clients-title">Trusted by 742+ clients</h2>
      </div>
      
      <!-- Auto-scrolling Infinite Marquee -->
      <div class="v2-marquee-container">
        <div class="v2-marquee-track">
          {clientLogos.map((client) => (
            <div class="v2-client-item">
              <img src={client.src} alt={client.alt} loading="lazy" />
            </div>
          ))}
          {clientLogos.map((client) => (
            <div class="v2-client-item" aria-hidden="true">
              <img src={client.src} alt={client.alt} loading="lazy" />
            </div>
          ))}
          {clientLogos.map((client) => (
            <div class="v2-client-item" aria-hidden="true">
              <img src={client.src} alt={client.alt} loading="lazy" />
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- 5. Video / Showcase Section -->
  <section class="v2-video-section">
    <div class="container">
      <div class="v2-section-head">
        <h2 class="v2-sec-title">Build a website that doesn't just look great, but drives revenue!</h2>
        <p class="v2-sec-subtitle">We craft high-impact websites combining striking modern design, blazing-fast speed, and conversion-optimized architecture.</p>
      </div>

      <div class="v2-video-wrapper">
        <div class="v2-browser-mockup">
          <div class="v2-browser-header">
            <div class="v2-browser-dots">
              <span class="v2-dot red"></span>
              <span class="v2-dot yellow"></span>
              <span class="v2-dot green"></span>
            </div>
            <div class="v2-browser-address">
              <span>https://tentaklik.com</span>
            </div>
          </div>
          <div class="v2-browser-screen">
            <img
              src="/assets/layanan/website/jasa-pembuatan-website-after-sales-terbaik-min.webp"
              alt="Website Showcase"
              loading="lazy"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 6. Portfolio Showcase Section (6 Project) -->
  <section class="v2-portfolio-section" id="portofolio">
    <div class="container">
      <div class="v2-section-head">
        <h2 class="v2-sec-title">Our website portfolio</h2>
        <p class="v2-sec-subtitle">A showcase of tailored web platforms crafted for diverse enterprises and organizations across Indonesia</p>
      </div>

      <div class="v2-portfolio-grid">
        {portfolios.map((item) => (
          <div class="v2-port-card">
            <div class="v2-port-img">
              <img src={item.img} alt={item.title} loading="lazy" />
            </div>
            <div class="v2-port-content">
              <h3>{item.title}</h3>
              <p>{item.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 7. Fitur Unggulan Grid (6 Poin) -->
  <section class="v2-features-section" id="fitur">
    <div class="container">
      <div class="v2-section-head">
        <h2 class="v2-sec-title">The best choice for your business</h2>
        <p class="v2-sec-subtitle">Core premium features engineered to accelerate your digital growth and streamline operations</p>
      </div>

      <div class="v2-features-grid">
        {features.map((feat) => (
          <div class="v2-feat-card">
            <div class="v2-feat-icon">
              {feat.icon === 'brush' && (
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="m9.06 11.9 8.07-8.06a2.85 2.85 0 1 1 4.03 4.03l-8.06 8.08"/><path d="M7.07 14.94c-1.66 0-3 1.35-3 3.02 0 1.33-2.5 1.52-2 2.02 1.08 1.1 2.49 2.02 4 2.02 2.2 0 4-1.8 4-4.04a3.01 3.01 0 0 0-3-3.02z"/></svg>
              )}
              {feat.icon === 'server' && (
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="8" x="2" y="2" rx="2" ry="2"/><rect width="20" height="8" x="2" y="14" rx="2" ry="2"/><line x1="6" x2="6.01" y1="6" y2="6"/><line x1="6" x2="6.01" y1="18" y2="18"/></svg>
              )}
              {feat.icon === 'laptop' && (
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><rect width="14" height="10" x="8" y="2" rx="2"/><rect width="8" height="14" x="2" y="8" rx="2"/><line x1="15" x2="15" y1="12"/></svg>
              )}
              {feat.icon === 'book' && (
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1-2.5-2.5Z"/><path d="M6 6h10"/><path d="M6 10h10"/></svg>
              )}
              {feat.icon === 'sparkle' && (
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 3-1.9 5.8a2 2 0 0 1-1.3 1.3L3 12l5.8 1.9a2 2 0 0 1 1.3 1.3L12 21l1.9-5.8a2 2 0 0 1 1.3-1.3L21 12l-5.8-1.9a2 2 0 0 1-1.3-1.3Z"/></svg>
              )}
              {feat.icon === 'search' && (
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/><path d="M11 8v6"/><path d="M8 11h6"/></svg>
              )}
            </div>
            <h3>{feat.title}</h3>
            <p>{feat.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 8. Bonus Spesial & After Sales -->
  <section class="v2-bonus-section">
    <div class="container v2-bonus-grid">
      <div class="v2-bonus-visual">
        <img
          src="/assets/layanan/website/pesen-website-banyak-bonus-ahzelan.webp"
          alt="Dedicated Technical Support & After Sales"
          width="768"
          height="697"
          loading="lazy"
        />
      </div>
      <div class="v2-bonus-content">
        <h2 class="v2-sec-title">Beyond code, we are dedicated to helping your business flourish</h2>
        <div class="v2-sec-desc">
          <p>We deliver more than just a functional website; we deliver measurable business impact.</p>
          <p>If you only needed basic template code, you could find cheap alternatives anywhere.</p>
          <p>Our commitment is providing a holistic digital foundation so your brand consistently outpaces market competitors.</p>
        </div>
        <div class="v2-btn-wrap">
          <a href="#buat" class="btn btn-primary" title="buatweb">
            Build now! <ArrowRight size={14} />
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- 9. Pricing Section -->
  <section class="v2-pricing-section" id="buat">
    <div class="container">
      <div class="v2-section-head">
        <h2 class="v2-sec-title">Build your website right now</h2>
        <p class="v2-sec-subtitle">Don't let manual routines hold your business back while competitors leverage digital efficiency</p>
      </div>

      <div class="v2-pricing-grid">
        <!-- Paket 1: Starter -->
        <div class="v2-plan-card">
          <div class="v2-plan-header">
            <h3>Starter</h3>
            <p class="v2-plan-tagline">Ideal for ventures launching online on a lean budget while unlocking the growth potential of a web presence</p>
            <div class="v2-plan-price-box">
              <span class="v2-price-strike">Rp 5.000.000</span>
              <div class="v2-plan-price">
                <span class="v2-price-curr">Rp</span>
                <span class="v2-price-val">3.990.000</span>
              </div>
            </div>
            <a
              href="https://api.whatsapp.com/send?phone=6285129992225&#038;text=Hello%2C%20I%20am%20interested%20in%20the%20Starter%20website%20package"
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn-ghost v2-plan-btn"
              title="pesan"
            >
              Build now! <ArrowRight size={14} />
            </a>
          </div>
          <div class="v2-plan-features">
            <ul>
              <li><Check size={16} /> <span>Free .com domain</span></li>
              <li><Check size={16} /> <span>Free 1-year high-speed hosting</span></li>
              <li><Check size={16} /> <span>Selection of elegant themes</span></li>
              <li><Check size={16} /> <span>2x design revisions</span></li>
              <li><Check size={16} /> <span>Integrated WhatsApp live chat</span></li>
              <li><Check size={16} /> <span>Lifetime error warranty</span></li>
              <li><Check size={16} /> <span>Free digital marketing consultation</span></li>
              <li><Check size={16} /> <span>Delivered in 3-7 business days</span></li>
            </ul>
          </div>
        </div>

        <!-- Paket 2: Standard (Featured) -->
        <div class="v2-plan-card featured">
          <div class="v2-plan-badge">Most popular</div>
          <div class="v2-plan-header">
            <h3>Standard</h3>
            <p class="v2-plan-tagline">Recommended for consumer-facing businesses and retail brands seeking custom visual identity and enhanced reach</p>
            <div class="v2-plan-price-box">
              <span class="v2-price-strike">Rp 7.000.000</span>
              <div class="v2-plan-price">
                <span class="v2-price-curr">Rp</span>
                <span class="v2-price-val">5.940.000</span>
              </div>
            </div>
            <a
              href="https://api.whatsapp.com/send?phone=6285129992225&#038;text=Hello%2C%20I%20am%20interested%20in%20the%20Standard%20website%20package"
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn-primary v2-plan-btn"
              title="pesan"
            >
              Build now! <ArrowRight size={14} />
            </a>
          </div>
          <div class="v2-plan-features">
            <ul>
              <li><Check size={16} /> <span>All Starter plan features included</span></li>
              <li><Check size={16} /> <span>Custom brand-aligned design</span></li>
              <li><Check size={16} /> <span>Up to 5 custom website pages</span></li>
              <li><Check size={16} /> <span>Google Analytics & Meta Pixel setup</span></li>
              <li><Check size={16} /> <span>Foundational on-page SEO optimization</span></li>
              <li><Check size={16} /> <span>5x design revisions</span></li>
              <li><Check size={16} /> <span>Full website management guide</span></li>
              <li><Check size={16} /> <span>Delivered in 5-10 business days</span></li>
            </ul>
          </div>
        </div>

        <!-- Paket 3: Bisnis -->
        <div class="v2-plan-card">
          <div class="v2-plan-header">
            <h3>Bisnis</h3>
            <p class="v2-plan-tagline">Built for B2B enterprises, corporate firms, and manufacturers demanding scale, speed, and tailored integrations</p>
            <div class="v2-plan-price-box">
              <span class="v2-price-strike">Rp 15.000.000</span>
              <div class="v2-plan-price">
                <span class="v2-price-curr">Rp</span>
                <span class="v2-price-val">7.490.000</span>
              </div>
            </div>
