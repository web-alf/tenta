---
import BaseLayout from '@layouts/BaseLayout.astro';
import Check from '@components/icons/Check.astro';
import ArrowRight from '@components/icons/ArrowRight.astro';
import WhatsApp from '@components/icons/WhatsApp.astro';
import { serviceJsonLd, faqJsonLd, breadcrumbJsonLd } from '@lib/seo';
import { site } from '@data/site';

const url = `${site.url}/layanan/website`;

const pageSeo = {
  title: "Jasa Pembuatan Website Profesional & Konversi Tinggi — Tentaklik",
  description: "Jasa pembuatan website profesional untuk bisnis di Indonesia: landing page, company profile, hingga toko online. Fast loading, mobile-first, SEO-ready, dan didesain untuk konversi nyata.",
};

const clientLogos = [
  { src: '/assets/layanan/website/client-alfatihah-min.png', alt: 'client-alfatihah-min.png' },
  { src: '/assets/layanan/website/client-alhuffadz-min.png', alt: 'client-alhuffadz-min.png' },
  { src: '/assets/layanan/website/client-mpa-min.png', alt: 'client-mpa-min.png' },
  { src: '/assets/layanan/website/client-bmh-min.png', alt: 'client-bmh-min.png' },
  { src: '/assets/layanan/website/client-sandaran-min.png', alt: 'client-sandaran-min.png' },
  { src: '/assets/layanan/website/client-asgatour-min.png', alt: 'client-asgatour-min.png' },
];

const portfolios = [
  {
    title: "PT. Grajevan",
    desc: "Company profile perusahaan lengkap dengan desain kekinian dan elegant",
    img: "/assets/layanan/website/grajevan-mockup-min.png",
  },
  {
    title: "PT. Media Pelajar",
    desc: "Website jasa ujian persamaan dan kejar paket kesetaraan legal sesuai standar",
    img: "/assets/layanan/website/jasa-ujian-persamaan-mockup-min.png",
  },
  {
    title: "Rumah Yatim Indonesia",
    desc: "Website lembaga sosial dengan fitur donasi online dan crowdfunding",
    img: "/assets/layanan/website/rumah-yatim-indonesia-mockup-min.png",
  },
  {
    title: "PT. Karya Kita",
    desc: "Website perusahaan desain interior lengkap dengan live chat online",
    img: "/assets/layanan/website/karya-kita-desain-mockup-min.png",
  },
  {
    title: "PT. Tunas Mobilindo",
    desc: "Website untuk kebutuhan showcase mobil BMW lengkap dengan pricelist",
    img: "/assets/layanan/website/promo-bmw-mockup-min.png",
  },
  {
    title: "Aksi Indonesia",
    desc: "Website organisasi sosial untuk event dan kebutuhan donasi online",
    img: "/assets/layanan/website/aksi-indonesia-mockup-min.png",
  },
];

const features = [
  {
    title: "Desain elegant",
    desc: "Tampilan website dengan desain terbaru yang menarik dan cantik",
    icon: "brush",
  },
  {
    title: "Hosting stabil & teroptimasi",
    desc: "Server yang baik membuat loading website jadi jauuh lebih cepat",
    icon: "server",
  },
  {
    title: "Website optimal",
    desc: "Kami pastikan website kamu mudah diakses diseluruh perangkat apapun",
    icon: "laptop",
  },
  {
    title: "Panduan lengkap",
    desc: "Seluruh laporan donasi, data donatur dan hasil donasi bisa diakses semuanya",
    icon: "book",
  },
  {
    title: "Tampilan cantik & ciamik",
    desc: "Membuat pengguna lebih nyaman dan betah di website kamu",
    icon: "sparkle",
  },
  {
    title: "SEO friendly",
    desc: "Website mudah ditemukan dengan baik di mesin pencarian manapun",
    icon: "search",
  },
];

const faqs = [
  {
    q: "Lama pembuatan website?",
    a: "Proses pembuatan website tergantung dari materi dan kesulitan, tapi rata-rata cuma perlu waktu 1-7 hari kerja",
  },
  {
    q: "Saya gaptek gimana dong?",
    a: "Kamu gausah khawatir karena kita juga bakalan ngasih panduan sampe kamu bener-bener paham",
  },
  {
    q: "Biayanya bisa lebih murah?",
    a: "Buat masalah biaya supaya lebih murah kayaknya kita perlu curhat bentar deh biar kamu sama-sama paham",
  },
  {
    q: "Apakah dibantu support?",
    a: "Selama kamu jadi bagian dari kita, udah pasti dibantu support seterusnya GRATIS",
  },
];

const pageKeywords = [
  'jasa pembuatan website',
  'jasa pembuatan website profesional',
  'jasa bikin website',
  'jasa website company profile',
  'jasa landing page',
  'jasa website semarang',
  'web developer indonesia',
  'jasa website toko online',
  'bikin website murah',
  'jasa buat website umkm',
  'tentaklik',
];

const jsonLd = [
  serviceJsonLd({
    name: pageSeo.title,
    description: pageSeo.description,
    url,
    serviceType: "Jasa Pembuatan Website",
    plans: [
      { name: "Starter", price: "3990000" },
      { name: "Standard", price: "5940000" },
      { name: "Bisnis", price: "7490000" },
    ],
  }),
  faqJsonLd(faqs),
  breadcrumbJsonLd([
    { name: 'Beranda', url: site.url },
    { name: 'Layanan', url: `${site.url}/#layanan` },
    { name: 'Jasa Pembuatan Website', url },
  ]),
];
---

<BaseLayout
  title={pageSeo.title}
  description={pageSeo.description}
  keywords={pageKeywords}
  image="/assets/services/webdev.png"
  active="layanan"
  jsonLd={jsonLd}
>
  <!-- 1. Hero Section -->
  <section class="v2-hero">
    <div aria-hidden="true" style="position:absolute;inset:0;pointer-events:none;z-index:0;">
      <div style="position:absolute;top:-80px;right:-120px;width:520px;height:520px;border-radius:50%;background:radial-gradient(circle, rgba(255,122,26,0.10), rgba(255,122,26,0) 70%);"></div>
      <div style="position:absolute;bottom:-60px;left:-100px;width:360px;height:360px;border-radius:50%;background:radial-gradient(circle, rgba(255,122,26,0.06), rgba(255,122,26,0) 70%);"></div>
    </div>
    <div class="container v2-hero-grid" style="position:relative;z-index:1;">
      <div class="v2-hero-content">
        <h1 class="v2-hero-title">
          Buat Bisnis Kamu <span style="color:var(--orange-500);">10X Lebih Maju</span> Pakai Website
        </h1>
        
        <div class="v2-hero-desc">
          <p>Bukan jasa pembuatan website nomor #1 tapi selalu kasih hasil terbaik buat kamu.</p>
          <p>Mulai budget 3 jutaan kamu udah bisa dapet website profesional yang sesuai kebutuhan bisnismu.</p>
        </div>
        
        <div class="v2-hero-cta">
          <a href="#buat" class="btn btn-primary" title="buat">
            <span>Buat sekarang!</span>
            <ArrowRight size={16} />
          </a>
          <a
            href="https://api.whatsapp.com/send?phone=6285129992225&#038;text=Salam%2C%20saya%20ingin%20konsultasi%20website"
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-ghost"
            title="konsul"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"/></svg>
            <span>Konsultasi sekarang</span>
            <ArrowRight size={16} />
          </a>
        </div>
        
        <div class="v2-hero-badges">
          <div class="v2-badge-item">
            <span class="v2-badge-icon"><Check size={13} /></span>
            <span>Sekali bayar</span>
          </div>
          <div class="v2-badge-item">
            <span class="v2-badge-icon"><Check size={13} /></span>
            <span>Akses 100%</span>
          </div>
          <div class="v2-badge-item">
            <span class="v2-badge-icon"><Check size={13} /></span>
            <span>Full support</span>
          </div>
        </div>
      </div>
      
      <div class="v2-hero-visual">
        <div class="v2-hero-img-box">
          <picture>
            <source srcset="/assets/layanan/website/jasa-pembuatan-website-hero.webp" type="image/webp" />
            <img
              src="/assets/layanan/website/jasa-pembuatan-website-hero.png"
              alt="jasa pembuatan website after sales terbaik sepanjang masa"
              width="896"
              height="764"
              class="v2-hero-img"
              loading="eager"
              fetchpriority="high"
            />
          </picture>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. Solusi Terbaik Buat Sukses Di Era Digital -->
  <section class="v2-solution-section" id="tentang">
    <div class="container v2-solution-grid">
      <div class="v2-solution-visual">
        <img
          src="/assets/layanan/website/jasa-pembuatan-website-after-sales-terbaik-min.webp"
          alt="jasa pembuatan website after sales terbaik min"
          width="960"
          height="640"
          loading="lazy"
          class="v2-solution-img"
        />
      </div>
      <div class="v2-solution-content">
        <h2 class="v2-sec-title">Solusi terbaik buat sukses di era digital</h2>
        <div class="v2-sec-desc">
          <p>Perkembangan zaman bikin banyak bisnis jadi gak efektif lagi kalo dilakukan dengan cara konvensional.</p>
          <p>Bisnis kamu bakal jauh lebih cepet tumbuh kalo mampu beradaptasi dan manfaatin media digital, jangan nunggu bangkrut dulu baru sadar. Gerak Sekarang Juga!</p>
        </div>
        <div class="v2-btn-wrap">
          <a href="#buat" class="btn btn-primary" title="buatsekarang">
            Buat sekarang! <ArrowRight size={14} />
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. Value Proposition / 3 Fitur Nilai -->
  <section class="v2-values-section">
    <div class="container v2-values-grid">
      <div class="v2-value-cards">
        <div class="v2-value-card">
          <div class="v2-value-icon">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v18h18"/><path d="m19 9-5 5-4-4-3 3"/></svg>
          </div>
          <div>
            <h3>Traffick lebih melimpah</h3>
            <p>Sekarang makin banyak orang milih buat donasi online karena gak harus keluar rumah untuk beri santunan atau sedekah, jadi website bakal diperlukan banget</p>
          </div>
        </div>

        <div class="v2-value-card">
          <div class="v2-value-icon">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
          </div>
          <div>
            <h3>Target market luas</h3>
            <p>Kalo bisnis kamu udah online, orang jauh lebih mudah nemu produk atau layanan kamu, jadi bisnis bisa makin tumbuh dari sebelumnya</p>
          </div>
        </div>

        <div class="v2-value-card">
          <div class="v2-value-icon">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="14" x="2" y="3" rx="2"/><line x1="8" x2="16" y1="21" y2="21"/><line x1="12" x2="12" y1="17" y2="21"/></svg>
          </div>
          <div>
            <h3>Bisnis makin tersistem</h3>
            <p>Bukan cuma kinerja, website juga bisa dipake jadi aset buat bikin mudah urusan bisnis kamu, misalnya catet laporan, customer service, order dan yang lainnya</p>
          </div>
        </div>
      </div>

      <div class="v2-values-info">
        <h2 class="v2-sec-title">Jasa pembuatan website paling mantep</h2>
        <div class="v2-sec-desc">
          <p>Bukan cuman kata orang aja, tapi jasa pembuatan website ini emang bantu banyak pengusaha, bisnis, UMKM sama individu buat jalanin bisnis online jadi makin mudah.</p>
          <p>Banyak orang kesulitan karena jalanin bisnis pake cara lama yang bikin repot, udah saatnya beralih ke sistem digital.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 4. Client Logos Bar & Stats -->
  <section class="v2-clients-section">
    <div class="container">
      <div class="v2-clients-header">
        <h2 class="v2-clients-title">Dipercaya 742+ client</h2>
      </div>
      
      <!-- Auto-scrolling Infinite Marquee -->
      <div class="v2-marquee-container">
        <div class="v2-marquee-track">
          {clientLogos.map((client) => (
            <div class="v2-client-item">
              <img src={client.src} alt={client.alt} loading="lazy" />
            </div>
          ))}
          {clientLogos.map((client) => (
            <div class="v2-client-item" aria-hidden="true">
              <img src={client.src} alt={client.alt} loading="lazy" />
            </div>
          ))}
          {clientLogos.map((client) => (
            <div class="v2-client-item" aria-hidden="true">
              <img src={client.src} alt={client.alt} loading="lazy" />
            </div>
          ))}
          {clientLogos.map((client) => (
            <div class="v2-client-item" aria-hidden="true">
              <img src={client.src} alt={client.alt} loading="lazy" />
            </div>
          ))}
        </div>
      </div>

      <div class="v2-stats-grid">
        <div class="v2-stat-card">
          <div class="v2-stat-num">172<span>+</span></div>
          <div class="v2-stat-label">Proyek selesai</div>
        </div>
        <div class="v2-stat-card">
          <div class="v2-stat-num">500<span>+</span></div>
          <div class="v2-stat-label">Bisnis online</div>
        </div>
        <div class="v2-stat-card">
          <div class="v2-stat-num">300<span>+</span></div>
          <div class="v2-stat-label">Template desain</div>
        </div>
      </div>
    </div>
  </section>

  <!-- 5. Mengurus Bisnis Jadi Lebih Teratur (Redesigned Video Showcase) -->
  <section class="v2-video-section" id="video">
    <div class="container">
      <div class="v2-video-header">
        <h2 class="v2-sec-title">Mengurus bisnis jadi lebih teratur</h2>
      </div>

      <!-- Modern Cinematic Video Showcase -->
      <div class="v2-video-showcase">
        <div class="v2-video-player-box" id="v2-video-box">
          <img
            id="v2-video-poster"
            src="/assets/layanan/website/ngurusin-bisnis-lebih-mudah-min.webp"
            alt="Mengurus Bisnis Jadi Lebih Teratur"
            class="v2-video-poster-img"
            loading="lazy"
          />
          <button
            type="button"
            id="v2-play-button"
            class="v2-video-play-btn"
            aria-label="Putar Video"
          >
            <span class="v2-video-ripple"></span>
            <span class="v2-video-play-icon">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor">
                <polygon points="6 4 20 12 6 20 6 4"/>
              </svg>
            </span>
          </button>
          <div id="v2-iframe-wrap" class="v2-iframe-container" style="display: none;"></div>
        </div>
      </div>

      <!-- Structured Benefit Cards (Exact Copywriting Verbatim) -->
      <div class="v2-video-cards">
        <div class="v2-benefit-card">
          <div class="v2-benefit-icon">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"></circle>
              <polyline points="12 6 12 12 16 14"></polyline>
            </svg>
          </div>
          <div class="v2-benefit-text">
            <p>
              Sebuah bisnis pasti membutuhkan website karena bisa menghemat waktu dan membuat kita fokus pada hal lain seperti penjualan dan scale up tanpa harus memikirkan sistem lagi.
            </p>
          </div>
        </div>

        <div class="v2-benefit-card highlight">
          <div class="v2-benefit-icon">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"></path>
            </svg>
          </div>
          <div class="v2-benefit-text">
            <p>
              Tampilan kreatif &amp; interaktif adalah yang paling penting, ditambah after sales yang baik dalam memberikan arahan untuk digital marketing. Jadi setelah punya website tidak dibiarkan begitu saja!
            </p>
          </div>
        </div>
      </div>

      <!-- Action Button -->
      <div class="v2-video-cta-wrap">
        <a href="#buat" class="btn btn-primary" title="miliki">
          Miliki sekarang <ArrowRight size={16} />
        </a>
      </div>
    </div>
  </section>

  <!-- 6. Section Portofolio Mockup -->
  <section class="v2-portfolio-section" id="portofolio">
    <div class="container">
      <div class="v2-section-head">
        <h2 class="v2-sec-title">Portofolio</h2>
      </div>

      <div class="v2-portfolio-grid">
        {portfolios.map((item) => (
          <div class="v2-portfolio-card">
            <div class="v2-portfolio-img-wrap">
              <img src={item.img} alt={item.title} loading="lazy" />
            </div>
            <div class="v2-portfolio-content">
              <h5>{item.title}</h5>
              <p>{item.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 7. Fitur Unggulan Grid (6 Poin) -->
  <section class="v2-features-section" id="fitur">
    <div class="container">
      <div class="v2-section-head">
        <h2 class="v2-sec-title">Pilihan terbaik untuk bisnis anda</h2>
        <p class="v2-sec-subtitle">Beberapa fitur unggulan website untuk bantu bisnis kamu jauh lebih maju</p>
      </div>

      <div class="v2-features-grid">
        {features.map((feat) => (
          <div class="v2-feat-card">
            <div class="v2-feat-icon">
              {feat.icon === 'brush' && (
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="m9.06 11.9 8.07-8.06a2.85 2.85 0 1 1 4.03 4.03l-8.06 8.08"/><path d="M7.07 14.94c-1.66 0-3 1.35-3 3.02 0 1.33-2.5 1.52-2 2.02 1.08 1.1 2.49 2.02 4 2.02 2.2 0 4-1.8 4-4.04a3.01 3.01 0 0 0-3-3.02z"/></svg>
              )}
              {feat.icon === 'server' && (
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="8" x="2" y="2" rx="2" ry="2"/><rect width="20" height="8" x="2" y="14" rx="2" ry="2"/><line x1="6" x2="6.01" y1="6" y2="6"/><line x1="6" x2="6.01" y1="18" y2="18"/></svg>
              )}
              {feat.icon === 'laptop' && (
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><rect width="14" height="10" x="8" y="2" rx="2"/><rect width="8" height="14" x="2" y="8" rx="2"/><line x1="15" x2="15" y1="12"/></svg>
              )}
              {feat.icon === 'book' && (
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1-2.5-2.5Z"/><path d="M6 6h10"/><path d="M6 10h10"/></svg>
              )}
              {feat.icon === 'sparkle' && (
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 3-1.9 5.8a2 2 0 0 1-1.3 1.3L3 12l5.8 1.9a2 2 0 0 1 1.3 1.3L12 21l1.9-5.8a2 2 0 0 1 1.3-1.3L21 12l-5.8-1.9a2 2 0 0 1-1.3-1.3Z"/></svg>
              )}
              {feat.icon === 'search' && (
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/><path d="M11 8v6"/><path d="M8 11h6"/></svg>
              )}
            </div>
            <h3>{feat.title}</h3>
            <p>{feat.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 8. Bonus Spesial & After Sales -->
  <section class="v2-bonus-section">
    <div class="container v2-bonus-grid">
      <div class="v2-bonus-visual">
        <img
          src="/assets/layanan/website/pesen-website-banyak-bonus-ahzelan.webp"
          alt="No #1 Jasa Pembuatan Website After Sales Terbaik"
          width="768"
          height="697"
          loading="lazy"
        />
      </div>
      <div class="v2-bonus-content">
        <h2 class="v2-sec-title">Bukan cuma itu, kami juga pengen bisnis kamu bertumbuh</h2>
        <div class="v2-sec-desc">
          <p>Bukan cuma sekedar website doang yang pengen kita kasih, tapi dampak besar buat bisnis kamu.</p>
          <p>Kalo cuma buat website aja, 1 juta juga udah dapet yang bagus kan?</p>
          <p>Tapi kita pengen ngasih strategi digital marketing yang lebih baik dari sebelumnya supaya bisnis kamu bisa jauh lebih maju dari sebelumnya.</p>
        </div>
        <div class="v2-btn-wrap">
          <a href="#buat" class="btn btn-primary" title="buatweb">
            Buat sekarang! <ArrowRight size={14} />
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- 9. Pricing Section (Tabel Paket & Harga SAMA PERSIS /v2) -->
  <section class="v2-pricing-section" id="buat">
