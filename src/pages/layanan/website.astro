          frameborder="0" 
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" 
          allowfullscreen>
        </iframe>
      `;
      iframeWrap.style.display = 'block';
      playBtn.style.display = 'none';
      poster.style.display = 'none';
