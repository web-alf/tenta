---
import BaseLayout from '@layouts/BaseLayout.astro';
---

<BaseLayout
  title="Orange Trail — Advertising Compliance & Agency Ad Accounts"
  description="Orange Trail is the leading provider of advertising support for Meta, Google, TikTok, Snapchat, Twitter, Bing & Taboola."
  active="beranda"
>
  <link rel="stylesheet" href="/assets/v2/css/v2-scoped.css" />

  <div class="v2-page">
    <main class="main">
        <section class="home-hero">
            <div class="home-hero__video">


                <video autoplay preload="auto" muted playsinline id="hero-video">
                    <source src="/assets/v2/videos/orange_header_bg.mp4" type="video/mp4">
                </video>


                <video autoplay preload="auto" muted playsinline loop id="hero-video-loop">
                    <source src="/assets/v2/videos/Orange_Cycle_2k.mp4" type="video/mp4">
                </video>



                <div class="home-hero__image"
                    style="background-image: url('/assets/v2/images/Hero-Static-Image-V1-scaled.webp');">
                </div>
                <div class="home-hero__image mobile" style="background-image: url('/assets/v2/images/Home-375.webp');">
                </div>


            </div>
            <div class="size-main">
                <div class="home-hero__inner">


                    <h1 class="home-hero__title title-hero">
                        <p>Simplify Your</p>
                        <p>Advertising.</p>
                    </h1>

                </div>
            </div>
        </section>
        <section class="home-partnered">
            <div class="home-partnered__inner">

                <div class="size-main">

                    <h2 class="home-partnered__title title-regular">
                        <p><span style="color: var(--orange-500, #FF7A1A);">Partnered</span> with</p>
                    </h2>

                </div>


                <div class="home-partnered__slider">


                    <div id="swiper-partnered-top" class="home-partnered__slider-top swiper swiper-partnered">
                        <div class="home-partnered__slider-inner swiper-wrapper">

                            <div class="home-partnered__slider-item swiper-slide">
                                <img src="/assets/v2/images/billo.webp" alt="billo logo">
                            </div>


                            <div class="home-partnered__slider-item swiper-slide">
                                <img src="/assets/v2/images/tripple.webp" alt="Triple Whale logo">
                            </div>


                            <div class="home-partnered__slider-item swiper-slide">
                                <img src="/assets/v2/images/multilogin.webp" alt="Multilogin logo">
                            </div>


                            <div class="home-partnered__slider-item swiper-slide">
                                <img src="/assets/v2/images/conversion.webp" alt="Conversion Wise logo">
                            </div>


                            <div class="home-partnered__slider-item swiper-slide">
                                <img src="/assets/v2/images/forbes.webp" alt="Forbes Agency Council logo">
                            </div>


                            <div class="home-partnered__slider-item swiper-slide">
                                <img src="/assets/v2/images/tiktok.png" alt="TikTok Agency Partner logo">
                            </div>


                        </div>
                    </div>


                    <div id="swiper-partnered-bottom" class="home-partnered__slider-bottom swiper swiper-partnered">
                        <div class="home-partnered__slider-inner swiper-wrapper">

                            <div class="home-partnered__slider-item swiper-slide">
                                <img src="/assets/v2/images/google.webp" alt="">
                            </div>


                            <div class="home-partnered__slider-item swiper-slide">
                                <img src="/assets/v2/images/Forbes-1.webp" alt="Forbes logo">
                            </div>


                            <div class="home-partnered__slider-item swiper-slide">
                                <img src="/assets/v2/images/voluum.webp" alt="Voluum logo">
                            </div>


                            <div class="home-partnered__slider-item swiper-slide">
                                <img src="/assets/v2/images/gorgias.webp" alt="gorgias logo">
                            </div>


                            <div class="home-partnered__slider-item swiper-slide">
                                <img src="/assets/v2/images/adleaks.webp" alt="ADLeaks Partner">
                            </div>


                            <div class="home-partnered__slider-item swiper-slide">
                                <img src="/assets/v2/images/sornai.png" alt="">
                            </div>


                            <div class="home-partnered__slider-item swiper-slide">
                                <img src="/assets/v2/images/x_agency_partner.png" alt="X Agency Partner">
                            </div>


                            <div class="home-partnered__slider-item swiper-slide">
                                <img src="/assets/v2/images/snapchat.png" alt="Snapchat Agency Partner">
                            </div>


                        </div>
                    </div>


                </div>
            </div>
        </section>
        <section class="home-can-help">
            <div class="size-main">
                <div class="home-can-help__inner">


                    <h2 class="home-can-help__title title-regular">
                        <p>How We<span style="color: var(--orange-500, #FF7A1A);"> Can Help</span></p>
                    </h2>


                    <div class="home-can-help__description home-text">
                        <p>Orange Trail delivers comprehensive advertising infrastructure and compliance support
                            tailored to businesses of all sizes – from established brands to dynamic agencies. We
                            empower marketers across diverse industries, including Ecommerce, Digital Information, Lead
                            Generation, Affiliation, and beyond, ensuring they operate without constraints and navigate
                            advertising restrictions seamlessly.</p>
                    </div>


                    <div class="home-can-help__icons">


                        <div class="home-can-help__icon">
                            <div class="home-can-help__icon-image">
                                <img src="/assets/v2/images/chart-6s-min-1.gif" alt="Ad task icon">
                            </div>
                            <h3 class="home-can-help__icon-title title-small">Advertising<br>Restrictions</h3>
                        </div>


                        <div class="home-can-help__icon">
                            <div class="home-can-help__icon-image">
                                <img src="/assets/v2/images/list-6s-min-1.gif" alt="Ad list icon">
                            </div>
                            <h3 class="home-can-help__icon-title title-small">Compliance<br>Issues</h3>
                        </div>


                        <div class="home-can-help__icon">
                            <div class="home-can-help__icon-image">
                                <img src="/assets/v2/images/megaphone-6s-min-1.gif" alt="Ads icon">
                            </div>
                            <h3 class="home-can-help__icon-title title-small">Struggling<br>To Scale</h3>
                        </div>


                    </div>
                </div>
            </div>
        </section>
        <section class="solutions">
            <div class="solutions-wrapper"
                style="--bg-image: url('/assets/v2/images/63ae2d6baf3312d1b6109a8f520c464f4cf32bf8.jpg')">
                <div class="container animate zoom-in">
                    <div class="content-wrapper">
                        <h2><span class="ot-orange">Our</span> Solutions</h2>
                        <p>Scale Fast, Stay Live, Spend More.</p>
                    </div>
                    <div class="cards-wrapper">
                        <div class="card">
                            <div class="top-content">
                                <img src="/assets/v2/images/Group-310-cropped.svg" alt="Agency Ad Accounts">
                                <h3>Agency Ad Accounts</h3>
                            </div>
                            <div class="card-content">
                                <p><strong>Tier 1 agency ad accounts</strong> across Meta, Google, TikTok and more.
                                    Built for <strong>stable scaling</strong>, <strong>high performance</strong>, and
                                    <strong>priority support</strong>.
                                </p>
                                <a class="button" href="/layanan/sewa-akun">
                                    <span>Learn More</span>
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
                                </a>
                            </div>
                        </div>
                        <div class="card">
                            <div class="top-content">
                                <img src="/assets/v2/images/Group-311.svg" alt="Performance Marketing">
                                <h3>Performance Marketing</h3>
                            </div>
                            <div class="card-content">
                                <p>We handle everything <strong>from A to Z</strong>. Full funnel advertising strategy
                                    built for results, managed across <strong>all major platforms</strong>.</p>
                                <a class="button" href="/layanan/konsultasi">
                                    <span>Learn More</span>
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
        <section class="home-benefits">
            <div class="size-main">
                <div class="home-benefits__inner">


                    <h2 class="home-benefits__title title-regular">
                        <p>Why Clients <span style="color: var(--orange-500, #FF7A1A);">Love Our Service</span></p>
                    </h2>



                    <div class="home-benefits__cards">

                        <div class="home-benefits__card">
                            <div class="home-benefits__card-image">
                                <img src="/assets/v2/images/Icons.svg" alt="diamond vector icon">
                            </div>
                            <h3 class="home-benefits__card-title title-small">
                                <p>Premium Advertising Solutions</p>
                            </h3>
                            <div class="home-text">
                                <p>Orange Trail’s accounts are pre-vetted and have a &#8220;priority&#8221; status</p>
                            </div>
                        </div>


                        <div class="home-benefits__card">
                            <div class="home-benefits__card-image">
                                <img src="/assets/v2/images/Animation.svg" alt="rocket vector icon">
                            </div>
                            <h3 class="home-benefits__card-title title-small">
                                <p>Unlimited Spend Potential</p>
                            </h3>
                            <div class="home-text">
                                <p>Our exclusive ad accounts have unlimited spend from day one. No more “warming
                                    up&#8221; billings or waiting to scale</p>
                            </div>
                        </div>


                        <div class="home-benefits__card">
                            <div class="home-benefits__card-image">
                                <img src="/assets/v2/images/Animation-1.svg" alt="ticket vector icon">
                            </div>
                            <h3 class="home-benefits__card-title title-small">
                                <p>Green Zone Status</p>
                            </h3>
                            <div class="home-text">
                                <p>Our advertising accounts have a &#8220;green status&#8221; with our partnered
                                    platforms and do not get banned easily</p>
                            </div>
                        </div>


                        <div class="home-benefits__card">
                            <div class="home-benefits__card-image">
                                <img src="/assets/v2/images/Animation-2.svg" alt="vector icon">
                            </div>
                            <h3 class="home-benefits__card-title title-small">
                                <p>Training &amp; Consultations</p>
                            </h3>
                            <div class="home-text">
                                <p>As our client, we&#8217;ll support your business and provide key info from partnered
                                    platforms</p>
                            </div>
                        </div>


                        <div class="home-benefits__card">
                            <div class="home-benefits__card-image">
                                <img src="/assets/v2/images/Animation-3.svg" alt="chain vector icon">
                            </div>
                            <h3 class="home-benefits__card-title title-small">
                                <p>Direct-Line Access</p>
                            </h3>
                            <div class="home-text">
                                <p>Orange Trail&#8217;s partnerships with all major advertising platform allow for
                                    direct communication with representatives</p>
                            </div>
                        </div>


                        <div class="home-benefits__card">
                            <div class="home-benefits__card-image">
                                <img src="/assets/v2/images/Animation-4.svg" alt="dollar vector icon">
                            </div>
                            <h3 class="home-benefits__card-title title-small">
                                <p>Easy Payment Solutions</p>
                            </h3>
                            <div class="home-text">
                                <p>Our ad solutions are easily managed via low-cost bank transfers, eliminating hefty
                                    credit card fees</p>
                            </div>
                        </div>


                    </div>
                </div>
        </section>
        <section class="home-icons-slider">
            <div class="size-main">
                <div class="home-icons-slider__inner">
                    <div class="home-icons-slider__content">


                        <h2 class="home-icons-slider__title title-regular">
                            <p>Simplify Your <span style="color: var(--orange-500, #FF7A1A);">Advertising</span></p>
                        </h2>


                        <div class="home-icons-slider__description home-text">
                            <p>Orange Trail is your partner in compliance for all the major advertising platforms.</p>
                        </div>


                        <a href="#price-quote" class="home-icons-slider__button home-button">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"/></svg>
                            <span>Konsultasi Sekarang</span>
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
                        </a>


                    </div>



                    <div id="swiper-icons-slider" class="home-icons-slider__slider swiper">
                        <div class="home-icons-slider__slider-inner swiper-wrapper">


                            <img class="home-icons-slider__slider-item swiper-slide"
                                src="/assets/v2/images/icons-social.webp" alt="social media icons">


                            <img class="home-icons-slider__slider-item swiper-slide"
                                src="/assets/v2/images/icons-social.webp" alt="social media icons">


                            <img class="home-icons-slider__slider-item swiper-slide"
                                src="/assets/v2/images/icons-social.webp" alt="social media icons">


                        </div>
                    </div>


                </div>
            </div>
        </section>
        <section class="home-reviews">
            <div class="size-main">
                <div class="home-reviews__inner">


                    <h2 class="home-reviews__title title-regular">
                        <p>What our <span style="color: var(--orange-500, #FF7A1A);">clients say</span></p>
                    </h2>


                    <div id="swiper-reviews-people" class="swiper swiper-reviews">

                        <div class="home-reviews__cards swiper-wrapper">

                            <div class="swiper-slide">
                                <div class="home-reviews__card has-video">


                                    <div class="home-reviews__card-video">
                                        <video class="video-card" playsinline preload="none"
                                            poster=/assets/v2/images/carl-video-poster.webp>
                                            <source src="/assets/v2/videos/OT-Carl-Testimony-4_5.webm" type="video/webm">
                                        </video>
                                        <div class="custom-video-button">
                                            <div class="custom-video-button__play"></div>
                                            <div class="custom-video-button__pause"></div>
                                        </div>
                                    </div>


                                    <div class="home-reviews__card-top">
                                        <div class="home-reviews__card-icon">

                                            <img src="/assets/v2/images/stars.svg" alt="five stars icon">


                                        </div>


                                    </div>
                                    <div class="home-reviews__card-bottom">
                                        <div class="home-reviews__card-author">
                                            <div class="home-reviews__card-author-photo">


                                                <img src="/assets/v2/images/Carl-Weische-1.webp" alt="">


                                            </div>
                                            <div class="home-reviews__card-author-info">
                                                <h3 class="home-reviews__card-author-name title-extra-small">Carl
                                                    Weische</h3>
                                                <div class="home-reviews__card-author-position home-text">Founder of
                                                    Accelerated Agency</div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="swiper-slide">
                                <div class="home-reviews__card has-video">


                                    <div class="home-reviews__card-video">
                                        <video class="video-card" playsinline preload="none"
                                            poster=/assets/v2/images/Floris-testimony-poster.webp>
                                            <source src="/assets/v2/videos/Floris-testimony-new.webm" type="video/webm">
                                        </video>
                                        <div class="custom-video-button">
                                            <div class="custom-video-button__play"></div>
                                            <div class="custom-video-button__pause"></div>
                                        </div>
                                    </div>


                                    <div class="home-reviews__card-top">
                                        <div class="home-reviews__card-icon">

                                            <img src="/assets/v2/images/stars.svg" alt="five stars icon">


                                        </div>


                                    </div>
                                    <div class="home-reviews__card-bottom">
                                        <div class="home-reviews__card-author">
                                            <div class="home-reviews__card-author-photo">


                                                <img src="/assets/v2/images/Floris-G.webp" alt="">


                                            </div>
                                            <div class="home-reviews__card-author-info">
                                                <h3 class="home-reviews__card-author-name title-extra-small">Floris G.
                                                </h3>
                                                <div class="home-reviews__card-author-position home-text">E-commerce
                                                    Entrepreneur</div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="swiper-slide">
                                <div class="home-reviews__card ">


                                    <div class="home-reviews__card-top">
                                        <div class="home-reviews__card-icon">

                                            <img src="/assets/v2/images/stars.svg" alt="five stars icon">


                                        </div>


                                        <div class="home-reviews__card-text home-text home-text-large">
                                            <p>&#8220;We switched over to orange trail&#8217;s agency accounts when we
                                                kept having issues with our ad accounts and pages.</p>
                                            <p>&nbsp;</p>
                                            <p>Best decision we ever made &#8211; The accounts are not getting randomly
                                                banned and we have been consistently running ads&#8221;</p>
                                        </div>
                                        <span class="line-card"></span>


                                    </div>
                                    <div class="home-reviews__card-bottom">
                                        <div class="home-reviews__card-author">
                                            <div class="home-reviews__card-author-photo">


                                                <img src="/assets/v2/images/Zino-R.webp" alt="Zino R.">


                                            </div>
                                            <div class="home-reviews__card-author-info">
                                                <h3 class="home-reviews__card-author-name title-extra-small">Zino R.
                                                </h3>
                                                <div class="home-reviews__card-author-position home-text">CEO, Tyr Ads
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="swiper-slide">
                                <div class="home-reviews__card ">


                                    <div class="home-reviews__card-top">
                                        <div class="home-reviews__card-icon">

                                            <img src="/assets/v2/images/stars.svg" alt="five stars icon">


                                        </div>


                                        <div class="home-reviews__card-text home-text home-text-large">
                                            <p>“We&#8217;ve been using Orange Trail for assistance in getting restricted
                                                verticals up and running across a variety of channels.</p>
                                            <p>&nbsp;</p>
                                            <p>The team has been great. They answer back quickly and have access to
                                                solid relationships with reps”</p>
                                        </div>
                                        <span class="line-card"></span>


                                    </div>
                                    <div class="home-reviews__card-bottom">
                                        <div class="home-reviews__card-author">
                                            <div class="home-reviews__card-author-photo">


                                                <img src="/assets/v2/images/Emily-L.webp" alt="Emily L.">


                                            </div>
                                            <div class="home-reviews__card-author-info">
                                                <h3 class="home-reviews__card-author-name title-extra-small">Emily L.
                                                </h3>
                                                <div class="home-reviews__card-author-position home-text">VP of
                                                    marketing, Hy.pe</div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>


                        </div>
                        <div class="reviews-swiper-button-prev"></div>
                        <div class="reviews-swiper-button-next"></div>
                    </div>
                </div>
            </div>
        </section>
        <section class="home-slogan">
            <div class="size-main">
                <div class="home-slogan__inner">


                    <h2 class="home-slogan__title title-accent">
                        <p>You are one phone call away from partnering with Orange Trail for smooth and reliable scaling
                        </p>
                    </h2>


                    <img class="home-slogan__img-anim" src="/assets/v2/images/plane-2x.webp" alt="plane icon">


                </div>
            </div>
        </section>

        <section id="home-meetings-iframe" class="home-calendar">
            <div id="price-quote" class="container">
                <div class="book-call-widget">
                    <div class="book-call-modal__choices" data-book-call-view="choices">
                        <div class="book-call-header">
                            <span class="book-call-badge">Schedule A Call</span>
                            <h2 class="book-call-modal__title">You are booking a call for:</h2>
                            <p class="book-call-subtitle">Select the service below to book a 1-on-1 discovery call with our compliance specialists</p>
                        </div>
                        <div class="book-call-modal__cards">
                            <button type="button" class="book-call-card" data-book-call-target="premium-agency">
                                <span class="book-call-card__image">
                                    <img src="/assets/v2/images/24ceeab876d6bcb5beb5e76fc80d1f0bad040afe.png"
                                        alt="Premium Agency Ad Accounts Icon" />
                                </span>
                                <span class="book-call-card__title">Premium Agency Ad Accounts</span>
                                <span class="book-call-card__cta">Book a call &rarr;</span>
                            </button>
                            <button type="button" class="book-call-card" data-book-call-target="performance-marketing">
                                <span class="book-call-card__image">
                                    <img src="/assets/v2/images/3cbab90826edcc51642c4dff4c06137d9024654e.png"
                                        alt="Performance Marketing Service Icon" />
                                </span>
                                <span class="book-call-card__title">Performance Marketing Service</span>
                                <span class="book-call-card__cta">Book a call &rarr;</span>
                            </button>
                        </div>
                    </div>

                    <div class="book-call-modal__panel" data-book-call-view="panel"
                        data-book-call-panel="premium-agency" hidden>
                        <button type="button" class="book-call-modal__back" data-book-call-back>&larr; Back</button>
                        <div class="meetings-iframe-container"
                            data-src="https://portal.orangetrail.io/meetings/marko-kostre/io?embed=true"></div>
                    </div>

                    <div class="book-call-modal__panel" data-book-call-view="panel"
                        data-book-call-panel="performance-marketing" hidden>
                        <button type="button" class="book-call-modal__back" data-book-call-back>&larr; Back</button>
                        <div class="meetings-iframe-container"
                            data-src="https://meetings-eu1.hubspot.com/alex-jankovic/pm?embed=true"></div>
                    </div>
                </div>
            </div>
        </section>
    </main>

    <div id="book-call-modal" class="book-call-modal" aria-hidden="true">
        <div class="book-call-modal__overlay" data-book-call-close></div>
        <div class="book-call-modal__dialog" role="dialog" aria-modal="true" aria-label="Book a call">
            <button type="button" class="book-call-modal__close" data-book-call-close
                aria-label="Close">&times;</button>
            <div class="book-call-widget">
                <div class="book-call-modal__choices" data-book-call-view="choices">
                    <h2 class="book-call-modal__title">You are booking a call for:</h2>
                    <div class="book-call-modal__cards">
                        <button type="button" class="book-call-card" data-book-call-target="premium-agency">
                            <span class="book-call-card__image">
                                <img src="/assets/v2/images/24ceeab876d6bcb5beb5e76fc80d1f0bad040afe.png"
                                    alt="Premium Agency Ad Accounts Icon" />
                            </span>
                            <span class="book-call-card__title">Premium Agency Ad Accounts</span>
                            <span class="book-call-card__cta">Book a call &rarr;</span>
                        </button>
                        <button type="button" class="book-call-card" data-book-call-target="performance-marketing">
                            <span class="book-call-card__image">
                                <img src="/assets/v2/images/3cbab90826edcc51642c4dff4c06137d9024654e.png"
