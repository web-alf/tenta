---
import BaseLayout from '@layouts/BaseLayout.astro';
import { waLink } from '@data/site';

const waWhitelistMsg = 'Halo Tentaklik, saya tertarik dan ingin konsultasi mengenai layanan Sewa Akun Whitelist Ads (Google & Meta Ads).\n\nBoleh minta info lebih lanjut mengenai persyaratan dan ketentuannya? Terima kasih!';
const waWebMarketingMsg = 'Halo Tentaklik, saya tertarik dan ingin konsultasi mengenai layanan Website & Digital Marketing untuk bisnis saya.\n\nBoleh minta info lebih lanjut mengenai paket dan layanannya? Terima kasih!';

const waWhitelistUrl = waLink(waWhitelistMsg);
const waWebMarketingUrl = waLink(waWebMarketingMsg);
---

<BaseLayout
  title="TentaKlik — Digital Marketing Specialist & Akun Whitelist"
  description="Tentaklik menyediakan layanan digital marketing termasuk akun whitelist Google Ads & Meta Ads, pembuatan website berkinerja tinggi, dan konsultasi bisnis."
  active="beranda"
>
  <link rel="stylesheet" href="/assets/v2/css/v2-scoped.css" />

  <div class="v2-page">
    <main class="main">
        <section class="home-hero">
            <div class="home-hero__video">


                <video autoplay preload="auto" muted playsinline id="hero-video">
                    <source src="/assets/v2/videos/orange_header_bg.mp4" type="video/mp4">
                </video>


                <video autoplay preload="auto" muted playsinline loop id="hero-video-loop">
                    <source src="/assets/v2/videos/Orange_Cycle_2k.mp4" type="video/mp4">
                </video>



                <div class="home-hero__image"
                    style="background-image: url('/assets/v2/images/hero-static-desktop.webp');">
                </div>
                <div class="home-hero__image mobile" style="background-image: url('/assets/v2/images/hero-static-mobile.webp');">
                </div>


            </div>
            <div class="size-main">
                <div class="home-hero__inner">


                    <h1 class="home-hero__title title-hero">
                        <p>Buat bisnis kamu</p>
                        <p><span style="color: var(--orange-500, #FF7A1A);">10x lebih maju</span></p>
                    </h1>

                </div>
            </div>
        </section>
        <section class="home-partnered">
            <div class="home-partnered__inner">

                <div class="size-main">

                    <h2 class="home-partnered__title title-regular">
                        <p>Partner <span style="color: var(--orange-500, #FF7A1A);">pilihan</span></p>
                    </h2>

                </div>


                <div class="home-partnered__slider">


                    <div id="swiper-partnered-top" class="home-partnered__slider-top swiper swiper-partnered">
                        <div class="home-partnered__slider-inner swiper-wrapper">

                            <div class="home-partnered__slider-item swiper-slide">
                                <img src="/assets/v2/images/logo-billo.webp" alt="billo logo">
                            </div>


                            <div class="home-partnered__slider-item swiper-slide">
                                <img src="/assets/v2/images/logo-triple-whale.webp" alt="Triple Whale logo">
                            </div>


                            <div class="home-partnered__slider-item swiper-slide">
                                <img src="/assets/v2/images/logo-multilogin.webp" alt="Multilogin logo">
                            </div>


                            <div class="home-partnered__slider-item swiper-slide">
                                <img src="/assets/v2/images/logo-conversion.webp" alt="Conversion Wise logo">
                            </div>


                            <div class="home-partnered__slider-item swiper-slide">
                                <img src="/assets/v2/images/logo-forbes.webp" alt="Forbes Agency Council logo">
                            </div>


                            <div class="home-partnered__slider-item swiper-slide">
                                <img src="/assets/v2/images/logo-tiktok-partner.png" alt="TikTok Agency Partner logo">
                            </div>


                        </div>
                    </div>


                    <div id="swiper-partnered-bottom" class="home-partnered__slider-bottom swiper swiper-partnered">
                        <div class="home-partnered__slider-inner swiper-wrapper">

                            <div class="home-partnered__slider-item swiper-slide">
                                <img src="/assets/v2/images/logo-google-partner.webp" alt="">
                            </div>


                            <div class="home-partnered__slider-item swiper-slide">
                                <img src="/assets/v2/images/forbes-council-badge.webp" alt="Forbes logo">
                            </div>


                            <div class="home-partnered__slider-item swiper-slide">
                                <img src="/assets/v2/images/logo-voluum.webp" alt="Voluum logo">
                            </div>


                            <div class="home-partnered__slider-item swiper-slide">
                                <img src="/assets/v2/images/logo-gorgias.webp" alt="gorgias logo">
                            </div>


                            <div class="home-partnered__slider-item swiper-slide">
                                <img src="/assets/v2/images/logo-adleaks.webp" alt="ADLeaks Partner">
                            </div>


                            <div class="home-partnered__slider-item swiper-slide">
                                <img src="/assets/v2/images/logo-sornai.png" alt="">
                            </div>


                            <div class="home-partnered__slider-item swiper-slide">
                                <img src="/assets/v2/images/logo-x-agency-partner.png" alt="X Agency Partner">
                            </div>


                            <div class="home-partnered__slider-item swiper-slide">
                                <img src="/assets/v2/images/logo-snapchat-partner.png" alt="Snapchat Agency Partner">
                            </div>


                        </div>
                    </div>


                </div>
            </div>
        </section>
        <section class="home-can-help">
            <div class="size-main">
                <div class="home-can-help__inner">


                    <h2 class="home-can-help__title title-regular">
                        <p>Bagaimana kami <span style="color: var(--orange-500, #FF7A1A);">membantu Anda</span></p>
                    </h2>


                    <div class="home-can-help__description home-text">
                        <p>Dunia bisnis bergerak cepat ke digital. Tentaklik menghadirkan solusi digital marketing terintegrasi yang mencakup akses akun whitelist Google Ads &amp; Meta Ads premium, optimasi website berkonversi tinggi, dan konsultasi bisnis untuk mendukung pertumbuhan eksponensial brand Anda tanpa batasan dan kendala akun.</p>
                    </div>


                    <div class="home-can-help__icons">


                        <div class="home-can-help__icon">
                            <div class="home-can-help__icon-image">
                                <img src="/assets/v2/images/anim-chart-6s.gif" alt="Limit Iklan icon">
                            </div>
                            <h3 class="home-can-help__icon-title title-small">Limit iklan &amp;<br>random banned</h3>
                        </div>


                        <div class="home-can-help__icon">
                            <div class="home-can-help__icon-image">
                                <img src="/assets/v2/images/anim-list-6s.gif" alt="Isu Kepatuhan icon">
                            </div>
                            <h3 class="home-can-help__icon-title title-small">Kepatuhan &amp;<br>kebijakan iklan</h3>
                        </div>


                        <div class="home-can-help__icon">
                            <div class="home-can-help__icon-image">
                                <img src="/assets/v2/images/anim-megaphone-6s.gif" alt="Skalabilitas Ads icon">
                            </div>
                            <h3 class="home-can-help__icon-title title-small">Skalabilitas &amp;<br>scale budget</h3>
                        </div>


                    </div>
                </div>
            </div>
        </section>
        <section class="solutions">
            <div class="solutions-wrapper"
                style="--bg-image: url('/assets/v2/images/client-growth.jpg')">
                <div class="container animate zoom-in">
                    <div class="content-wrapper">
                        <h2>Layanan <span class="ot-orange">utama</span></h2>
                        <p>Solusi inti untuk bantu bisnis kamu tampil lebih profesional dan hasilkan leads.</p>
                    </div>
                    <div class="cards-wrapper">
                        <div class="card">
                            <div class="top-content">
                                <img src="/assets/v2/images/illustration-growth-graph.svg" alt="Sewa Akun Whitelist">
                                <h3>Sewa akun whitelist</h3>
                            </div>
                            <div class="card-content">
                                <p><strong>Akun iklan whitelist Google &amp; Meta</strong> — limit tanpa batas, tanpa PPN,
                                    <strong>anti random banned</strong>, dan didukung <strong>priority support</strong> untuk scaling maksimal.
                                </p>
                                <a class="button" href="/layanan/sewa-akun">
                                    <span>Pelajari layanan</span>
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
                                </a>
                            </div>
                        </div>
                        <div class="card">
                            <div class="top-content">
                                <img src="/assets/v2/images/illustration-dashboard-metrics.svg" alt="Website & Konsultasi">
                                <h3>Website &amp; konsultasi</h3>
                            </div>
                            <div class="card-content">
                                <p><strong>Landing page, company profile, dan funnel ads</strong> yang dirancang untuk
                                    <strong>konversi tinggi</strong> dan hasil nyata terukur di semua platform utama.</p>
                                <a class="button" href="/layanan/konsultasi">
                                    <span>Pelajari layanan</span>
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
        <section class="home-benefits">
            <div class="size-main">
                <div class="home-benefits__inner">


                    <h2 class="home-benefits__title title-regular">
                        <p>Kenapa klien <span style="color: var(--orange-500, #FF7A1A);">memilih Tentaklik</span></p>
                    </h2>



                    <div class="home-benefits__cards">

                        <div class="home-benefits__card">
                            <div class="home-benefits__card-image">
                                <img src="/assets/v2/images/icon-arrow.svg" alt="diamond vector icon">
                            </div>
                            <h3 class="home-benefits__card-title title-small">
                                <p>Akun whitelist premium</p>
                            </h3>
                            <div class="home-text">
                                <p>Akun iklan pre-vetted resmi berstatus prioritas dengan trust score tinggi dan performa stabil</p>
                            </div>
                        </div>


                        <div class="home-benefits__card">
                            <div class="home-benefits__card-image">
                                <img src="/assets/v2/images/animation-main.svg" alt="rocket vector icon">
                            </div>
                            <h3 class="home-benefits__card-title title-small">
                                <p>Limit belanja tanpa batas</p>
                            </h3>
                            <div class="home-text">
                                <p>Akun iklan eksklusif dengan limit spend tanpa batas sejak hari pertama, bebas antre warm-up</p>
                            </div>
                        </div>


                        <div class="home-benefits__card">
                            <div class="home-benefits__card-image">
                                <img src="/assets/v2/images/animation-step-1.svg" alt="ticket vector icon">
                            </div>
                            <h3 class="home-benefits__card-title title-small">
                                <p>Status green zone aman</p>
                            </h3>
                            <div class="home-text">
                                <p>Akun berstatus green zone resmi dari platform mitra sehingga aman dan anti random banned</p>
                            </div>
                        </div>


                        <div class="home-benefits__card">
                            <div class="home-benefits__card-image">
                                <img src="/assets/v2/images/animation-step-2.svg" alt="vector icon">
                            </div>
                            <h3 class="home-benefits__card-title title-small">
                                <p>Konsultasi &amp; strategi terukur</p>
                            </h3>
                            <div class="home-text">
                                <p>Didukung tim spesialis yang mendampingi dan memberikan rekomendasi strategi berbasis data</p>
                            </div>
                        </div>


                        <div class="home-benefits__card">
                            <div class="home-benefits__card-image">
                                <img src="/assets/v2/images/animation-step-3.svg" alt="chain vector icon">
                            </div>
                            <h3 class="home-benefits__card-title title-small">
                                <p>Dedicated support responsif</p>
                            </h3>
                            <div class="home-text">
                                <p>Akses komunikasi prioritas yang responsif langsung dari tim spesialis kami, bukan bot</p>
                            </div>
                        </div>


                        <div class="home-benefits__card">
                            <div class="home-benefits__card-image">
                                <img src="/assets/v2/images/animation-step-4.svg" alt="dollar vector icon">
                            </div>
                            <h3 class="home-benefits__card-title title-small">
                                <p>Kemudahan transaksi &amp; bayar</p>
                            </h3>
                            <div class="home-text">
                                <p>Solusi pembayaran mudah via transfer bank lokal, bebas PPN dan tanpa beban fee kartu kredit</p>
                            </div>
                        </div>


                    </div>
                </div>
        </section>
        <section class="home-icons-slider">
            <div class="size-main">
                <div class="home-icons-slider__inner">
                    <div class="home-icons-slider__content">


                        <h2 class="home-icons-slider__title title-regular">
                            <p>Permudah iklan &amp; <span style="color: var(--orange-500, #FF7A1A);">scaling bisnis Anda</span></p>
                        </h2>


                        <div class="home-icons-slider__description home-text">
                            <p>Tentaklik adalah partner resmi Anda dalam solusi akun whitelist, optimasi website, dan strategi periklanan lintas platform.</p>
                        </div>


                        <a href="#price-quote" class="home-icons-slider__button home-button">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"/></svg>
                            <span>Konsultasi sekarang</span>
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
                        </a>


                    </div>



                    <div id="swiper-icons-slider" class="home-icons-slider__slider swiper">
                        <div class="home-icons-slider__slider-inner swiper-wrapper">


                            <img class="home-icons-slider__slider-item swiper-slide"
                                src="/assets/v2/images/icons-social-platforms.webp" alt="social media icons">


                            <img class="home-icons-slider__slider-item swiper-slide"
                                src="/assets/v2/images/icons-social-platforms.webp" alt="social media icons">


                            <img class="home-icons-slider__slider-item swiper-slide"
                                src="/assets/v2/images/icons-social-platforms.webp" alt="social media icons">


                        </div>
                    </div>


                </div>
            </div>
        </section>
        <section class="home-reviews">
            <div class="size-main">
                <div class="home-reviews__inner">


                    <h2 class="home-reviews__title title-regular">
                        <p>Apa kata <span style="color: var(--orange-500, #FF7A1A);">klien kami</span></p>
                    </h2>


                    <div id="swiper-reviews-people" class="swiper swiper-reviews">

                        <div class="home-reviews__cards swiper-wrapper">

                            <div class="swiper-slide">
                                <div class="home-reviews__card has-video">


                                    <div class="home-reviews__card-video">
                                        <video class="video-card" playsinline preload="none"
                                            poster=/assets/v2/images/carl-video-poster.webp>
                                            <source src="/assets/v2/videos/OT-Carl-Testimony-4_5.webm" type="video/webm">
                                        </video>
                                        <div class="custom-video-button">
                                            <div class="custom-video-button__play"></div>
                                            <div class="custom-video-button__pause"></div>
                                        </div>
                                    </div>


                                    <div class="home-reviews__card-top">
                                        <div class="home-reviews__card-icon">

                                            <img src="/assets/v2/images/icon-stars-rating.svg" alt="five stars icon">


                                        </div>


                                    </div>
                                    <div class="home-reviews__card-bottom">
                                        <div class="home-reviews__card-author">
                                            <div class="home-reviews__card-author-photo">


                                                <img src="/assets/v2/images/carl-weische.webp" alt="">


                                            </div>
                                            <div class="home-reviews__card-author-info">
                                                <h3 class="home-reviews__card-author-name title-extra-small">Carl
                                                    Weische</h3>
                                                <div class="home-reviews__card-author-position home-text">Founder, Accelerated Agency</div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="swiper-slide">
                                <div class="home-reviews__card has-video">


                                    <div class="home-reviews__card-video">
                                        <video class="video-card" playsinline preload="none"
                                            poster=/assets/v2/images/floris-testimony-poster.webp>
                                            <source src="/assets/v2/videos/Floris-testimony-new.webm" type="video/webm">
                                        </video>
                                        <div class="custom-video-button">
                                            <div class="custom-video-button__play"></div>
                                            <div class="custom-video-button__pause"></div>
                                        </div>
                                    </div>


                                    <div class="home-reviews__card-top">
                                        <div class="home-reviews__card-icon">

                                            <img src="/assets/v2/images/icon-stars-rating.svg" alt="five stars icon">


                                        </div>


                                    </div>
                                    <div class="home-reviews__card-bottom">
                                        <div class="home-reviews__card-author">
                                            <div class="home-reviews__card-author-photo">


                                                <img src="/assets/v2/images/floris-g.webp" alt="">


                                            </div>
                                            <div class="home-reviews__card-author-info">
                                                <h3 class="home-reviews__card-author-name title-extra-small">Floris G.
                                                </h3>
                                                <div class="home-reviews__card-author-position home-text">E-Commerce Entrepreneur</div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="swiper-slide">
                                <div class="home-reviews__card ">


                                    <div class="home-reviews__card-top">
                                        <div class="home-reviews__card-icon">

                                            <img src="/assets/v2/images/icon-stars-rating.svg" alt="five stars icon">


                                        </div>


                                        <div class="home-reviews__card-text home-text home-text-large">
                                            <p>“Kami beralih ke akun agensi whitelist dari Tentaklik saat sering mengalami kendala akun iklan dan halaman yang dibatalkan.</p>
                                            <p>&nbsp;</p>
                                            <p>Keputusan terbaik yang pernah kami buat — akun tidak terkena random banned dan campaign berjalan stabil setiap hari.”</p>
                                        </div>
                                        <span class="line-card"></span>


                                    </div>
                                    <div class="home-reviews__card-bottom">
                                        <div class="home-reviews__card-author">
                                            <div class="home-reviews__card-author-photo">


                                                <img src="/assets/v2/images/zino-r.webp" alt="Zino R.">


                                            </div>
                                            <div class="home-reviews__card-author-info">
                                                <h3 class="home-reviews__card-author-name title-extra-small">Zino R.
                                                </h3>
                                                <div class="home-reviews__card-author-position home-text">CEO, Tyr Ads
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="swiper-slide">
                                <div class="home-reviews__card ">


                                    <div class="home-reviews__card-top">
                                        <div class="home-reviews__card-icon">

                                            <img src="/assets/v2/images/icon-stars-rating.svg" alt="five stars icon">


                                        </div>


                                        <div class="home-reviews__card-text home-text home-text-large">
                                            <p>“Kami mengandalkan Tentaklik untuk pendampingan campaign dan optimasi di berbagai channel periklanan.</p>
                                            <p>&nbsp;</p>
                                            <p>Timnya sangat hebat, fast response, dan memiliki komunikasi yang solid dengan platform mitra.”</p>
                                        </div>
                                        <span class="line-card"></span>


                                    </div>
                                    <div class="home-reviews__card-bottom">
                                        <div class="home-reviews__card-author">
                                            <div class="home-reviews__card-author-photo">


                                                <img src="/assets/v2/images/emily-l.webp" alt="Emily L.">


                                            </div>
                                            <div class="home-reviews__card-author-info">
                                                <h3 class="home-reviews__card-author-name title-extra-small">Emily L.
                                                </h3>
                                                <div class="home-reviews__card-author-position home-text">VP of Marketing, Hy.pe</div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>


                        </div>
                        <div class="reviews-swiper-button-prev"></div>
                        <div class="reviews-swiper-button-next"></div>
                    </div>
                </div>
            </div>
        </section>
        <section class="home-slogan">
            <div class="size-main">
                <div class="home-slogan__inner">


                    <h2 class="home-slogan__title title-accent">
                        <p>Siap mempercepat pertumbuhan bisnis Anda bersama Tentaklik?</p>
                    </h2>


                    <img class="home-slogan__img-anim" src="/assets/v2/images/icon-paper-plane.webp" alt="plane icon">


                </div>
            </div>
        </section>

        <section id="home-meetings-iframe" class="home-calendar">
            <div id="price-quote" class="container">
                <div class="book-call-widget">
                    <div class="book-call-modal__choices" data-book-call-view="choices">
                        <div class="book-call-header">
                            <span class="book-call-badge">Jadwalkan konsultasi</span>
                            <h2 class="book-call-modal__title">Pilih layanan konsultasi Anda:</h2>
                            <p class="book-call-subtitle">Pilih layanan di bawah untuk konsultasi 1-on-1 langsung bersama tim spesialis kami via WhatsApp</p>
                        </div>
                        <div class="book-call-modal__cards">
                            <a href={waWhitelistUrl} target="_blank" rel="noopener noreferrer" class="book-call-card">
                                <span class="book-call-card__image">
                                    <img src="/assets/v2/images/icon-whitelist-ads.png"
                                        alt="Sewa Akun Whitelist Ads Icon" />
                                </span>
                                <span class="book-call-card__title">Sewa akun whitelist ads</span>
                                <span class="book-call-card__cta">Konsultasi sekarang &rarr;</span>
                            </a>
                            <a href={waWebMarketingUrl} target="_blank" rel="noopener noreferrer" class="book-call-card">
                                <span class="book-call-card__image">
                                    <img src="/assets/v2/images/icon-web-digital-marketing.png"
                                        alt="Website & Digital Marketing Icon" />
                                </span>
                                <span class="book-call-card__title">Website &amp; digital marketing</span>
                                <span class="book-call-card__cta">Konsultasi sekarang &rarr;</span>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </main>

    <div id="book-call-modal" class="book-call-modal" aria-hidden="true">
        <div class="book-call-modal__overlay" data-book-call-close></div>
        <div class="book-call-modal__dialog" role="dialog" aria-modal="true" aria-label="Book a call">
            <button type="button" class="book-call-modal__close" data-book-call-close
                aria-label="Close">&times;</button>
            <div class="book-call-widget">
                <div class="book-call-modal__choices" data-book-call-view="choices">
