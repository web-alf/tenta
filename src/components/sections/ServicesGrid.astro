---
import { getLang, useT } from '@i18n/utils';
const lang = getLang(Astro.currentLocale);
const t = useT(lang);
const L = (p: string) => (lang === 'en' ? '/en' + (p === '/' ? '' : p) : p) || '/';
import ArrowRight from '../icons/ArrowRight.astro';

const services = [
  {
    title: lang === 'en' ? 'Tier 1 Ad Accounts' : 'Akun Iklan Tier 1',
    desc: t('svcgrid.sewaAkun.desc'),
    slug: 'sewa-akun',
    image: '/assets/services/akuniklan.avif'
  },
  {
    title: lang === 'en' ? 'Website Development' : 'Website Development',
    desc: t('svcgrid.website.desc'),
    slug: 'website',
    image: '/assets/services/webdev.avif'
  },
  {
    title: lang === 'en' ? 'Digital Marketing Consulting' : 'Konsultasi Digital Marketing',
    desc: t('svcgrid.konsultasi.desc'),
    slug: 'konsultasi',
    image: '/assets/services/digimar.avif'
  },
] as const;
---
<section id="layanan" style="padding-top: 20px; padding-bottom: 40px;">
  <div class="container">
    <div style="text-align:center;margin-bottom:40px;position:relative;">
      <h2 class="section-title">{t('svcgrid.title')}</h2>
      <p class="section-sub">{t('svcgrid.sub')}</p>
      <span class="spark" style="top:-10px;left:15%;font-size:18px;" aria-hidden="true">✦</span>
      <span class="spark" style="top:20px;right:12%;font-size:14px;" aria-hidden="true">✦</span>
    </div>
    <div class="services-grid-list">
      {services.map(s => (
        <div class="service-card reveal">
          <div class="service-image-box">
            <img src={s.image} alt={s.title} loading="lazy" width="240" height="180" />
          </div>
          <h3 style="font-size:20px;font-weight:700;margin-top:8px;margin-bottom:4px;">{s.title}</h3>
          <p style="font-size:14px;color:var(--ink-500);flex:1;line-height:1.6;">{s.desc}</p>
          <a href={L(`/layanan/${s.slug}`)} class="btn btn-primary" style="padding:12px 20px;font-size:14.5px;justify-content:center;margin-top:8px;">
            {t('svcgrid.cta')} <ArrowRight size={14} />
          </a>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .services-grid-list {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }
  .service-image-box {
    width: 100%;
    height: 190px;
    background: #FFFDF9;
    border: 1px solid rgba(255, 122, 26, 0.12);
    border-radius: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 16px;
    overflow: hidden;
  }
  .service-image-box img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
  }
  @media (max-width: 992px) {
    .services-grid-list {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 640px) {
    .services-grid-list {
      grid-template-columns: 1fr;
    }
  }
</style>
