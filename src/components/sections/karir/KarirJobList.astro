---
import ArrowRight from '../../icons/ArrowRight.astro';
import { getCollection } from 'astro:content';
import { waLink } from '@data/site';

import { getLang } from '@i18n/utils';
const lang = getLang(Astro.currentLocale);

const jobsCol = await getCollection('jobs');
const jobs = jobsCol.sort((a, b) => Number(a.id) - Number(b.id));
---
<section id="lowongan" style="background:var(--bg-warm);">
  <div class="container">
    <h2 class="section-title">{lang === 'en' ? 'Open Positions' : 'Posisi yang Dibuka'}</h2>
    <p class="section-sub" style="margin-bottom:40px;">{jobs.length} {lang === 'en' ? 'active positions available. Click for details and to apply.' : 'posisi sedang aktif kami buka. Klik untuk detail dan apply.'}</p>
    <div style="display:flex;flex-direction:column;gap:14px;max-width:980px;margin:0 auto;">
      {jobs.map(j => (
        <div class="job-card reveal" data-job-card>
          <button class="job-card-head" type="button" aria-expanded="false" data-job-toggle>
            <div style="flex:1;text-align:left;">
              <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin-bottom:8px;">
                <h3 style="font-size:20px;margin:0;">{lang === 'en' && j.data.title_en ? j.data.title_en : j.data.title}</h3>
                <span class="job-pill job-pill-orange">{lang === 'en' && j.data.type_en ? j.data.type_en : j.data.type}</span>
                <span class="job-pill">{lang === 'en' && j.data.location_en ? j.data.location_en : j.data.location}</span>
                <span class="job-pill">{j.data.level}</span>
              </div>
              <p style="font-size:14.5px;color:var(--ink-500);margin:0;">{lang === 'en' && j.data.summary_en ? j.data.summary_en : j.data.summary}</p>
            </div>
            <span class="job-card-toggle" aria-hidden="true">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <line x1="12" y1="5" x2="12" y2="19"/>
                <line x1="5" y1="12" x2="19" y2="12"/>
              </svg>
            </span>
          </button>
          <div class="job-card-body" hidden>
            <div style="display:flex;gap:8px;flex-wrap:wrap;margin-bottom:18px;">
              {j.data.tags.map(t => <span class="job-tag">{t}</span>)}
            </div>
            <h4 style="font-size:14px;font-weight:700;margin-bottom:10px;color:var(--ink-700);">{lang === 'en' ? 'What we are looking for:' : 'Yang kami cari:'}</h4>
            <ul class="job-req-list">
              {(lang === 'en' && j.data.requirements_en ? j.data.requirements_en : j.data.requirements).map(r => <li>{r}</li>)}
            </ul>
            <div style="display:flex;gap:10px;margin-top:22px;flex-wrap:wrap;">
              <a href="#apply" class="btn btn-primary" data-apply-job={j.data.title}>
                {lang === 'en' ? 'Apply for this Position' : 'Apply Posisi Ini'} <ArrowRight size={14} />
              </a>
              <a href={waLink(`Halo Tentaklik, saya tertarik dengan posisi ${j.data.title}`)} target="_blank" rel="noopener noreferrer" class="btn btn-wa">
                {lang === 'en' ? 'Ask via WhatsApp' : 'Tanya via WhatsApp'}
              </a>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-job-toggle]').forEach(btn => {
    btn.addEventListener('click', () => {
      const card = btn.closest('[data-job-card]') as HTMLElement | null;
      const body = card?.querySelector<HTMLElement>('.job-card-body');
      if (!card || !body) return;
      const isOpen = card.classList.contains('open');
      if (isOpen) {
        card.classList.remove('open');
        body.hidden = true;
        btn.setAttribute('aria-expanded', 'false');
      } else {
        card.classList.add('open');
        body.hidden = false;
        btn.setAttribute('aria-expanded', 'true');
      }
    });
  });

  document.querySelectorAll<HTMLAnchorElement>('[data-apply-job]').forEach(link => {
    link.addEventListener('click', (e) => {
      e.preventDefault();
      const role = link.dataset.applyJob;
      const apply = document.getElementById('apply');
      const select = document.getElementById('apply-role') as HTMLSelectElement | null;
      if (select && role) {
        select.value = role;
        // If role doesn't match any option, fall back to the last open-application option
        if (!select.value) {
          const openApp = select.querySelector<HTMLOptionElement>('option[value="Open Application"]');
          if (openApp) select.value = 'Open Application';
        }
      }
      apply?.scrollIntoView({ behavior: 'smooth' });
    });
  });
</script>
