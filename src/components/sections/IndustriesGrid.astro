---
import type { Industry } from '@data/sewa-akun';

interface Props {
  items: Industry[];
  heading: { title: string; sub: string };
  bg?: 'warm' | 'default';
  center?: boolean;
  variant?: 'default' | 'premium';
}
const { items, heading, bg = 'default', center = false, variant = 'default' } = Astro.props;

let sectionClass = 'industri-section';
if (bg === 'warm') sectionClass += ' bg-warm';
if (variant === 'premium') sectionClass += ' premium-variant';
---
<section class={sectionClass} aria-labelledby="industri-heading">
  {variant === 'premium' && (
    <div class="premium-decor-bg">
      <svg class="decor-left" width="400" height="400" viewBox="0 0 400 400" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M-50 200 C100 200, 200 100, 200 -50" stroke="#ffedd5" stroke-width="1.5" stroke-dasharray="6 6" />
        <circle cx="50" cy="50" r="100" fill="url(#grad1)" opacity="0.3" />
        <defs>
          <radialGradient id="grad1" cx="50%" cy="50%" r="50%" fx="50%" fy="50%">
            <stop offset="0%" stop-color="#ffedd5" />
            <stop offset="100%" stop-color="#ffffff" stop-opacity="0" />
          </radialGradient>
        </defs>
      </svg>
      <svg class="decor-right" width="400" height="400" viewBox="0 0 400 400" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M450 200 C300 200, 200 300, 200 450" stroke="#ffedd5" stroke-width="1.5" stroke-dasharray="6 6" />
        <circle cx="350" cy="350" r="100" fill="url(#grad2)" opacity="0.4" />
        <circle cx="280" cy="180" r="4" fill="#f97316" opacity="0.6" />
        <defs>
          <radialGradient id="grad2" cx="50%" cy="50%" r="50%" fx="50%" fy="50%">
            <stop offset="0%" stop-color="#ffedd5" />
            <stop offset="100%" stop-color="#ffffff" stop-opacity="0" />
          </radialGradient>
        </defs>
      </svg>
      <!-- Dots top left -->
      <svg class="dots-tl" width="40" height="40" viewBox="0 0 40 40" fill="none">
        <circle cx="2" cy="2" r="1.5" fill="#f97316" opacity="0.8"/>
        <circle cx="12" cy="2" r="1.5" fill="#f97316" opacity="0.3"/>
        <circle cx="22" cy="2" r="1.5" fill="#f97316" opacity="0.3"/>
        <circle cx="2" cy="12" r="1.5" fill="#f97316" opacity="0.8"/>
        <circle cx="12" cy="12" r="1.5" fill="#f97316" opacity="0.3"/>
        <circle cx="22" cy="12" r="1.5" fill="#f97316" opacity="0.3"/>
        <circle cx="2" cy="22" r="1.5" fill="#f97316" opacity="0.3"/>
        <circle cx="12" cy="22" r="1.5" fill="#f97316" opacity="0.3"/>
      </svg>
      <!-- Dots bottom right -->
      <svg class="dots-br" width="40" height="40" viewBox="0 0 40 40" fill="none">
        <circle cx="38" cy="38" r="1.5" fill="#f97316" opacity="0.8"/>
        <circle cx="28" cy="38" r="1.5" fill="#f97316" opacity="0.3"/>
        <circle cx="18" cy="38" r="1.5" fill="#f97316" opacity="0.3"/>
        <circle cx="38" cy="28" r="1.5" fill="#f97316" opacity="0.8"/>
        <circle cx="28" cy="28" r="1.5" fill="#f97316" opacity="0.3"/>
        <circle cx="18" cy="28" r="1.5" fill="#f97316" opacity="0.3"/>
        <circle cx="38" cy="18" r="1.5" fill="#f97316" opacity="0.3"/>
        <circle cx="28" cy="18" r="1.5" fill="#f97316" opacity="0.3"/>
      </svg>
    </div>
  )}

  <div class="container relative-z">
    <h2 id="industri-heading" class="section-title" set:html={heading.title}></h2>
    <p class="section-sub" set:html={heading.sub}></p>
    
    {variant === 'premium' && (
      <div class="title-accent">
        <span class="dash"></span>
        <span class="dot"></span>
        <span class="dash"></span>
      </div>
    )}

    <div class={`industri-grid ${center ? 'industri-center' : ''}`}>
      {items.map((it) => (
        <article class={`industri-card reveal ${variant === 'premium' ? 'card-premium' : ''}`} style={`--tint:${it.tint}`}>
          {variant === 'premium' ? (
            <div class="icon-orbit-wrapper">
              <div class="orbit-dot dot-1"></div>
              <div class="orbit-dot dot-2"></div>
              <div class="orbit-dot dot-3"></div>
              <div class="orbit-dot dot-4"></div>
              <div class="icon-inner">
                <span class="industri-icon" aria-hidden="true" style="color: var(--orange-500); display: inline-flex;">
                  {it.iconId === 'bottle' && <svg width="1em" height="1em" viewBox="0 0 24 24" fill="none"><path d="M7 10a5 5 0 0 1 10 0v10a2 2 0 0 1-2 2H9a2 2 0 0 1-2-2V10Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><path d="M12 2v3" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><path d="M10 2h4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>}
                  {it.iconId === 'shirt' && <svg width="1em" height="1em" viewBox="0 0 24 24" fill="none"><path d="M20.38 3.46L16 2a8.5 8.5 0 0 1-8 0L3.62 3.46a2 2 0 0 0-1.34 2.23l.58 3.47a1 1 0 0 0 .99.84H6v10c0 1.1.9 2 2 2h8a2 2 0 0 0 2-2V10h2.15a1 1 0 0 0 .99-.84l.58-3.47a2 2 0 0 0-1.34-2.23z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>}
                  {it.iconId === 'shield-cross' && <svg width="1em" height="1em" viewBox="0 0 24 24" fill="none"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><path d="M12 8v8" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><path d="M8 12h8" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>}
                  {it.iconId === 'sparkles' && <svg width="1em" height="1em" viewBox="0 0 24 24" fill="none"><path d="M9.937 15.5A2 2 0 0 0 8.5 14.063l-6.135-1.582a.5.5 0 0 1 0-.962L8.5 9.936A2 2 0 0 0 9.937 8.5l1.582-6.135a.5.5 0 0 1 .963 0L14.063 8.5A2 2 0 0 0 15.5 9.937l6.135 1.581a.5.5 0 0 1 0 .964L15.5 14.063a2 2 0 0 0-1.437 1.437l-1.582 6.135a.5.5 0 0 1-.963 0z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><path d="M20 3v4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><path d="M22 5h-4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><path d="M4 17v2" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><path d="M5 18H3" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>}
                  {it.iconId === 'box' && <svg width="1em" height="1em" viewBox="0 0 24 24" fill="none"><path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><path d="m3.3 7 8.7 5 8.7-5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><path d="M12 22V12" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>}
                  {it.iconId === 'heart' && <svg width="1em" height="1em" viewBox="0 0 24 24" fill="none"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>}
                  {it.iconId === 'store' && <svg width="1em" height="1em" viewBox="0 0 24 24" fill="none"><path d="m2 7 4.41-4.41A2 2 0 0 1 7.83 2h8.34a2 2 0 0 1 1.42.59L22 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><path d="M15 22v-4a2 2 0 0 0-2-2h-2a2 2 0 0 0-2 2v4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><path d="M2 7h20" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><path d="M22 7v3a2 2 0 0 1-2 2v0a2.7 2.7 0 0 1-1.59-.63.7.7 0 0 0-.82 0A2.7 2.7 0 0 1 16 12a2.7 2.7 0 0 1-1.59-.63.7.7 0 0 0-.82 0A2.7 2.7 0 0 1 12 12a2.7 2.7 0 0 1-1.59-.63.7.7 0 0 0-.82 0A2.7 2.7 0 0 1 8 12a2.7 2.7 0 0 1-1.59-.63.7.7 0 0 0-.82 0A2.7 2.7 0 0 1 4 12a2 2 0 0 1-2-2V7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>}
                  {it.iconId === 'plane' && <svg width="1em" height="1em" viewBox="0 0 24 24" fill="none"><path d="M17.8 19.2 16 11l3.5-3.5C21 6 21.5 4 21 3c-1-.5-3 0-4.5 1.5L13 8 4.8 6.2c-.5-.1-.9.2-1.1.7l-1.2 3.6 7.2 4.5-3.2 3.2-3.1-.8L2 19l4.5 1.5L8 25l1.6-1.4-.8-3.1 3.2-3.2 4.5 7.2 3.6-1.2c.5-.2.8-.6.7-1.1z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>}
                  {it.iconId === 'graduation-cap' && <svg width="1em" height="1em" viewBox="0 0 24 24" fill="none"><path d="M21.42 10.922a2 2 0 0 0-.019-3.838L12.83 4.34a2 2 0 0 0-1.66 0L2.6 7.08a2 2 0 0 0 0 3.832l8.57 3.698a2 2 0 0 0 1.66 0z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><path d="M22 10v6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><path d="M6 12.5V16a6 3 0 0 0 12 0v-3.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>}
                  {it.iconId === 'utensils' && <svg width="1em" height="1em" viewBox="0 0 24 24" fill="none"><path d="M3 2v7c0 1.1.9 2 2 2h4a2 2 0 0 0 2-2V2" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><path d="M7 2v20" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><path d="M21 15V2v0a5 5 0 0 0-5 5v6c0 1.1.9 2 2 2h3Zm0 0v7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>}
                </span>
              </div>
            </div>
          ) : (
            <div class="default-icon-wrap" aria-hidden="true">
              <span class="industri-icon">
                  {it.iconId === 'bottle' && <svg width="1em" height="1em" viewBox="0 0 24 24" fill="none"><path d="M7 10a5 5 0 0 1 10 0v10a2 2 0 0 1-2 2H9a2 2 0 0 1-2-2V10Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><path d="M12 2v3" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><path d="M10 2h4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>}
                  {it.iconId === 'shirt' && <svg width="1em" height="1em" viewBox="0 0 24 24" fill="none"><path d="M20.38 3.46L16 2a8.5 8.5 0 0 1-8 0L3.62 3.46a2 2 0 0 0-1.34 2.23l.58 3.47a1 1 0 0 0 .99.84H6v10c0 1.1.9 2 2 2h8a2 2 0 0 0 2-2V10h2.15a1 1 0 0 0 .99-.84l.58-3.47a2 2 0 0 0-1.34-2.23z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>}
                  {it.iconId === 'shield-cross' && <svg width="1em" height="1em" viewBox="0 0 24 24" fill="none"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><path d="M12 8v8" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><path d="M8 12h8" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>}
                  {it.iconId === 'sparkles' && <svg width="1em" height="1em" viewBox="0 0 24 24" fill="none"><path d="M9.937 15.5A2 2 0 0 0 8.5 14.063l-6.135-1.582a.5.5 0 0 1 0-.962L8.5 9.936A2 2 0 0 0 9.937 8.5l1.582-6.135a.5.5 0 0 1 .963 0L14.063 8.5A2 2 0 0 0 15.5 9.937l6.135 1.581a.5.5 0 0 1 0 .964L15.5 14.063a2 2 0 0 0-1.437 1.437l-1.582 6.135a.5.5 0 0 1-.963 0z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><path d="M20 3v4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><path d="M22 5h-4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><path d="M4 17v2" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><path d="M5 18H3" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>}
                  {it.iconId === 'box' && <svg width="1em" height="1em" viewBox="0 0 24 24" fill="none"><path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><path d="m3.3 7 8.7 5 8.7-5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><path d="M12 22V12" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>}
                  {it.iconId === 'heart' && <svg width="1em" height="1em" viewBox="0 0 24 24" fill="none"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>}
                  {it.iconId === 'store' && <svg width="1em" height="1em" viewBox="0 0 24 24" fill="none"><path d="m2 7 4.41-4.41A2 2 0 0 1 7.83 2h8.34a2 2 0 0 1 1.42.59L22 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><path d="M15 22v-4a2 2 0 0 0-2-2h-2a2 2 0 0 0-2 2v4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><path d="M2 7h20" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><path d="M22 7v3a2 2 0 0 1-2 2v0a2.7 2.7 0 0 1-1.59-.63.7.7 0 0 0-.82 0A2.7 2.7 0 0 1 16 12a2.7 2.7 0 0 1-1.59-.63.7.7 0 0 0-.82 0A2.7 2.7 0 0 1 12 12a2.7 2.7 0 0 1-1.59-.63.7.7 0 0 0-.82 0A2.7 2.7 0 0 1 8 12a2.7 2.7 0 0 1-1.59-.63.7.7 0 0 0-.82 0A2.7 2.7 0 0 1 4 12a2 2 0 0 1-2-2V7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>}
                  {it.iconId === 'plane' && <svg width="1em" height="1em" viewBox="0 0 24 24" fill="none"><path d="M17.8 19.2 16 11l3.5-3.5C21 6 21.5 4 21 3c-1-.5-3 0-4.5 1.5L13 8 4.8 6.2c-.5-.1-.9.2-1.1.7l-1.2 3.6 7.2 4.5-3.2 3.2-3.1-.8L2 19l4.5 1.5L8 25l1.6-1.4-.8-3.1 3.2-3.2 4.5 7.2 3.6-1.2c.5-.2.8-.6.7-1.1z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>}
                  {it.iconId === 'graduation-cap' && <svg width="1em" height="1em" viewBox="0 0 24 24" fill="none"><path d="M21.42 10.922a2 2 0 0 0-.019-3.838L12.83 4.34a2 2 0 0 0-1.66 0L2.6 7.08a2 2 0 0 0 0 3.832l8.57 3.698a2 2 0 0 0 1.66 0z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><path d="M22 10v6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><path d="M6 12.5V16a6 3 0 0 0 12 0v-3.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>}
                  {it.iconId === 'utensils' && <svg width="1em" height="1em" viewBox="0 0 24 24" fill="none"><path d="M3 2v7c0 1.1.9 2 2 2h4a2 2 0 0 0 2-2V2" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><path d="M7 2v20" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><path d="M21 15V2v0a5 5 0 0 0-5 5v6c0 1.1.9 2 2 2h3Zm0 0v7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>}
              </span>
            </div>
          )}
          <h3 class="industri-label">{it.label}</h3>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .industri-section {
    padding-top: 80px;
    padding-bottom: 80px;
    position: relative;
    overflow: hidden;
  }
  .bg-warm {
    background: var(--bg-warm);
  }
  
  .section-title {
    text-align: center;
    margin-bottom: 12px;
  }
  .section-sub {
    text-align: center;
    margin-bottom: 44px;
    color: var(--ink-600);
  }

  .relative-z {
    position: relative;
    z-index: 2;
  }

  /* Premium Variant Background */
  .premium-variant {
    background: #f8fafc; /* matching the design's very light cool grey */
    padding-top: 100px;
    padding-bottom: 100px;
  }
  .premium-variant .section-title {
    font-size: 42px;
    font-weight: 800;
    color: var(--ink-900);
  }
  .premium-variant .section-sub {
    margin-bottom: 24px; /* closer to accent */
    font-size: 16.5px;
  }

  .premium-decor-bg {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
  }
  .decor-left {
    position: absolute;
    top: -50px;
    left: -50px;
    width: 400px;
    height: 400px;
  }
  .decor-right {
    position: absolute;
    bottom: -50px;
    right: -50px;
    width: 400px;
    height: 400px;
  }
  .dots-tl {
    position: absolute;
    top: 40px;
    left: 40px;
  }
  .dots-br {
    position: absolute;
    bottom: 40px;
    right: 40px;
  }

  /* Title Accent */
  .title-accent {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    margin-bottom: 48px;
  }
  .title-accent .dash {
    width: 24px;
    height: 3px;
    background: var(--orange-400);
    border-radius: 4px;
  }
  .title-accent .dot {
    width: 4px;
    height: 4px;
    background: var(--orange-400);
    border-radius: 50%;
  }

  /* Grid & Cards */
  .industri-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
    max-width: 980px;
    margin: 0 auto;
  }
  
  .industri-card {
    background: white;
    border: 1.5px solid var(--orange-100);
    border-radius: var(--radius-xl);
    padding: 28px 24px;
    min-height: 132px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 12px;
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
  }
  .industri-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
    border-color: var(--orange-400);
  }

  /* Premium Card Styles */
  .card-premium {
    border: 1.5px solid var(--orange-100);
    box-shadow: 0 10px 30px rgba(0,0,0,0.03);
    padding: 36px 24px;
    align-items: center;
    gap: 20px;
  }
  .card-premium:hover {
    box-shadow: 0 15px 40px rgba(249, 115, 22, 0.08);
    border-color: var(--orange-400);
  }

  .icon-orbit-wrapper {
    position: relative;
    width: 76px;
    height: 76px;
    border-radius: 50%;
    border: 1px dashed var(--orange-200);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  
  .orbit-dot {
    position: absolute;
    width: 4.5px;
    height: 4.5px;
    background: var(--orange-400);
    border-radius: 50%;
  }
  .dot-1 { top: -2.25px; left: 50%; transform: translateX(-50%); }
  .dot-2 { bottom: -2.25px; left: 50%; transform: translateX(-50%); }
  .dot-3 { left: -2.25px; top: 50%; transform: translateY(-50%); }
  .dot-4 { right: -2.25px; top: 50%; transform: translateY(-50%); }

  .icon-inner {
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: var(--orange-50);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .industri-icon {
    font-size: 32px;
    line-height: 1;
    display: inline-flex;
  }
  
