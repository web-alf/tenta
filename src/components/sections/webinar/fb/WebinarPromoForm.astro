---
interface Props {
  scriptUrl: string;
  waNumber: string;
  heading?: string;
  ctaText?: string;
  footnote?: string;
  eventPrice?: string;
  trackLead?: boolean;
}
const {
  scriptUrl,
  waNumber,
  heading = "Form Registrasi",
  ctaText = "Daftar Sekarang",
  footnote = "Kuota peserta terbatas.",
  eventPrice = "Rp 0",
  trackLead = true,
} = Astro.props;
---

<div
  class="bg-white p-7 md:p-9 rounded-[2rem] shadow-2xl border border-slate-100"
  id="form-registrasi"
>
  <h3
    class="text-2xl md:text-[26px] font-extrabold text-[#0B1527] mb-7 text-center"
    style="margin-bottom: 1.5rem;"
  >
    {heading}
  </h3>

  <form
    id="webinar-promo-form"
    class="space-y-6"
    data-script-url={scriptUrl}
    data-wa-number={waNumber}
    data-track-lead={String(trackLead)}
    novalidate
  >
    <input
      type="text"
      name="website"
      tabindex="-1"
      autocomplete="off"
      class="absolute left-[-9999px] w-[1px] h-[1px] opacity-0"
      aria-hidden="true"
    />

    <div class="flex flex-col gap-5">
      <div class="flex flex-col gap-2">
        <label for="wbf-nama" class="text-[14px] font-bold text-[#0B1527]"
          >Nama Lengkap <span class="text-[#D31F1F]">*</span></label
        >
        <input
          id="wbf-nama"
          type="text"
          name="nama"
          placeholder="Masukkan nama lengkap"
          class="px-4 py-3.5 rounded-xl border border-slate-200 bg-slate-50/50 focus:bg-white focus:border-[#D31F1F] focus:ring-4 focus:ring-[#D31F1F]/10 outline-none transition-all w-full text-[15px]"
          required
          maxlength="100"
          autocomplete="name"
        />
      </div>

      <div class="flex flex-col gap-2">
        <label for="wbf-wa" class="text-[14px] font-bold text-[#0B1527]"
          >Nomor WhatsApp <span class="text-[#D31F1F]">*</span></label
        >
        <input
          id="wbf-wa"
          type="tel"
          name="whatsapp"
          placeholder="08xxxxxxxxxx"
          class="px-4 py-3.5 rounded-xl border border-slate-200 bg-slate-50/50 focus:bg-white focus:border-[#D31F1F] focus:ring-4 focus:ring-[#D31F1F]/10 outline-none transition-all w-full text-[15px]"
          required
          maxlength="20"
          autocomplete="tel"
        />
      </div>

      <div class="flex flex-col gap-2">
        <label for="wbf-brand" class="text-[14px] font-bold text-[#0B1527]"
          >Nama Bisnis / Brand</label
        >
        <input
          id="wbf-brand"
          type="text"
          name="brand"
          placeholder="Nama bisnis"
          class="px-4 py-3.5 rounded-xl border border-slate-200 bg-slate-50/50 focus:bg-white focus:border-[#D31F1F] focus:ring-4 focus:ring-[#D31F1F]/10 outline-none transition-all w-full text-[15px]"
          maxlength="150"
          autocomplete="organization"
        />
      </div>
    </div>

    <button
      type="submit"
      style="background-color: #D31F1F; color: #ffffff;"
      class="w-full mt-4 hover:bg-[#B31919] font-extrabold py-4 rounded-[14px] shadow-[0_8px_20px_rgba(211,31,31,0.25)] transition-all hover:-translate-y-1 hover:shadow-[0_12px_25px_rgba(211,31,31,0.35)] flex justify-center items-center gap-2.5 disabled:opacity-70 disabled:cursor-progress group"
    >
      <span class="wbf-label flex items-center gap-2 text-[17px]"
        >{ctaText}
        <svg
          class="transition-transform group-hover:translate-x-1"
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="3"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"></path></svg
        ></span
      >
      <span class="wbf-loading hidden items-center gap-2 text-[17px]"
        ><svg
          class="animate-spin"
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          ><line x1="12" y1="2" x2="12" y2="6"></line><line
            x1="12"
            y1="18"
            x2="12"
            y2="22"></line><line x1="4.93" y1="4.93" x2="7.76" y2="7.76"
          ></line><line x1="16.24" y1="16.24" x2="19.07" y2="19.07"></line><line
            x1="2"
            y1="12"
            x2="6"
            y2="12"></line><line x1="18" y1="12" x2="22" y2="12"></line><line
            x1="4.93"
            y1="19.07"
            x2="7.76"
            y2="16.24"></line><line x1="16.24" y1="7.76" x2="19.07" y2="4.93"
          ></line></svg
        > Mengirim...</span
      >
    </button>

    <p
      class="text-center text-xs font-medium text-slate-500 flex items-center justify-center gap-1"
    >
      <svg
        width="12"
        height="12"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        ><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path
          d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg
      >
      {footnote}
    </p>

    <p
      class="wb-msg-sent text-green-700 text-sm font-semibold text-center hidden"
    >
      &#10003; Pendaftaran berhasil!
    </p>
    <p class="wb-msg-err text-red-600 text-sm font-semibold text-center hidden">
    </p>
  </form>
</div>

<!-- Payment Modal Premium Kemerdekaan -->
<div id="payment-modal-promo" class="wb-modal" aria-hidden="true">
  <div class="wb-modal-overlay" tabindex="-1"></div>
  <div class="wb-modal-content" role="dialog" aria-labelledby="wb-modal-title">
    <button class="wb-modal-close" aria-label="Tutup popup">&times;</button>
    
    <!-- Header Merah -->
    <div class="wb-modal-header">
      <div class="wb-modal-icon-wrapper">
        <div class="wb-modal-icon-glow"></div>
        <svg class="wb-modal-icon" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
          <polyline points="22 4 12 14.01 9 11.01"/>
        </svg>
      </div>
    </div>

    <div class="wb-modal-body">
      <h3 id="wb-modal-title" class="wb-modal-title">Pendaftaran Berhasil!</h3>
      <p class="wb-modal-desc">Selesaikan pembayaran untuk mengamankan kursi diskon kemerdekaan Anda.</p>
      
      <!-- Box Tagihan Premium -->
      <div class="wb-pay-card">
        <div class="wb-pay-header">
          <span class="wb-pay-label">Total Tagihan</span>
          <strong class="wb-pay-total">{eventPrice}</strong>
        </div>
        
        <div class="wb-bank-details">
          <div class="wb-bank-info">
            <span class="wb-bank-logo">BCA</span>
            <span class="wb-bank-owner">PT Media Pro Indonesia</span>
          </div>
          
          <div class="wb-acc-group">
            <div class="wb-acc-number" id="wb-bank-acc">7831988855</div>
            <button class="wb-copy-badge" id="wb-copy-btn" aria-label="Copy nomor rekening">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
              <span>Salin</span>
            </button>
          </div>
        </div>
      </div>

      <!-- Custom Steps -->
      <div class="wb-steps-container">
        <div class="wb-step">
          <div class="wb-step-num">1</div>
          <div class="wb-step-text">Transfer sesuai nominal <b>Promo Kemerdekaan</b> di atas.</div>
        </div>
        <div class="wb-step">
          <div class="wb-step-num">2</div>
          <div class="wb-step-text">Simpan bukti transfer (screenshot/foto).</div>
        </div>
        <div class="wb-step">
          <div class="wb-step-num">3</div>
          <div class="wb-step-text">Kirim ke CS kami untuk konfirmasi & akses grup.</div>
        </div>
      </div>

      <a href="#" id="wb-confirm-btn" class="wb-confirm-btn" target="_blank" rel="noopener noreferrer">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 0 0-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"/></svg>
        <span>Konfirmasi via WhatsApp</span>
      </a>
    </div>
  </div>
</div>

<style>
  /* ── Modal Premium Redesign ────────────────────────────────── */
  .wb-modal { position: fixed; inset: 0; z-index: 9999; display: flex; align-items: center; justify-content: center; padding: 16px; opacity: 0; visibility: hidden; transition: opacity 0.3s ease, visibility 0.3s ease; }
  .wb-modal.is-open { opacity: 1; visibility: visible; }
  .wb-modal-overlay { position: absolute; inset: 0; background: rgba(11, 21, 39, 0.75); backdrop-filter: blur(8px); }
  
  .wb-modal-content {
    position: relative; background: #fff; width: 100%; max-width: 440px;
    border-radius: 28px; overflow: hidden;
    box-shadow: 0 40px 80px -20px rgba(0, 0, 0, 0.5);
    transform: translateY(20px) scale(0.96); transition: transform 0.4s cubic-bezier(0.2, 0.9, 0.3, 1.15);
    display: flex; flex-direction: column;
  }
  .wb-modal.is-open .wb-modal-content { transform: translateY(0) scale(1); }
  
  .wb-modal-close {
    position: absolute; top: 12px; right: 12px; z-index: 10;
    width: 36px; height: 36px; display: flex; align-items: center; justify-content: center;
    background: rgba(255, 255, 255, 0.2); border: none; font-size: 24px; line-height: 1;
    color: #fff; cursor: pointer; border-radius: 50%; backdrop-filter: blur(4px);
    transition: background 0.2s ease, transform 0.2s ease;
  }
  .wb-modal-close:hover { background: rgba(255, 255, 255, 0.3); transform: scale(1.05); }

  /* Header Merah */
  .wb-modal-header {
    background: linear-gradient(135deg, #E60000 0%, #B30000 100%);
    padding: 32px 24px 48px; display: flex; align-items: center; justify-content: center;
    position: relative;
  }
  .wb-modal-header::after {
    content: ''; position: absolute; bottom: 0; left: 0; right: 0; height: 24px;
    background: #fff; border-radius: 24px 24px 0 0;
  }
  .wb-modal-icon-wrapper {
    position: relative; width: 64px; height: 64px;
    display: flex; align-items: center; justify-content: center;
    background: #fff; border-radius: 50%;
    box-shadow: 0 8px 24px rgba(0,0,0,0.15); z-index: 2;
  }
  .wb-modal-icon-glow {
    position: absolute; inset: -8px; border-radius: 50%;
    background: rgba(255,255,255,0.3); animation: wb-pulse 2s infinite ease-out;
  }
  .wb-modal-icon { color: #D31F1F; }
  @keyframes wb-pulse { 0% { transform: scale(0.9); opacity: 1; } 100% { transform: scale(1.4); opacity: 0; } }

  .wb-modal-body { padding: 0 28px 32px; display: flex; flex-direction: column; align-items: center; }
  .wb-modal-title { font-size: 24px; font-weight: 900; letter-spacing: -0.02em; color: #0f172a; margin: 0 0 8px; text-align: center; }
  .wb-modal-desc { font-size: 15px; line-height: 1.5; color: #64748b; margin: 0 0 24px; text-align: center; max-width: 320px; }

  /* Premium Card Box */
  .wb-pay-card {
    width: 100%; background: #ffffff; border: 1.5px solid #f1f5f9; border-radius: 20px;
    box-shadow: 0 10px 30px -10px rgba(15, 23, 42, 0.05); overflow: hidden; margin-bottom: 28px;
    position: relative;
  }
  .wb-pay-card::before {
    content: ''; position: absolute; top: 0; left: 0; width: 4px; height: 100%;
    background: #D31F1F;
  }
  .wb-pay-header {
    padding: 16px 20px; background: #f8fafc; border-bottom: 1px dashed #cbd5e1;
    display: flex; align-items: center; justify-content: space-between;
  }
  .wb-pay-label { font-size: 13px; font-weight: 700; color: #64748b; text-transform: uppercase; letter-spacing: 0.05em; }
  .wb-pay-total { font-size: 24px; font-weight: 900; color: #D31F1F; letter-spacing: -0.02em; }
  
  .wb-bank-details { padding: 20px; display: flex; flex-direction: column; gap: 12px; }
  .wb-bank-info { display: flex; justify-content: space-between; align-items: center; }
  .wb-bank-logo { font-size: 16px; font-weight: 900; color: #0B1527; letter-spacing: 0.02em; font-style: italic;}
  .wb-bank-owner { font-size: 13px; font-weight: 600; color: #94a3b8; }
  
  .wb-acc-group { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
  .wb-acc-number { font-size: 26px; font-weight: 800; color: #0f172a; font-variant-numeric: tabular-nums; letter-spacing: 0.04em; }
  .wb-copy-badge {
    display: flex; align-items: center; gap: 4px; padding: 6px 12px;
    background: #fef2f2; color: #D31F1F; border: none; border-radius: 8px;
    font-size: 12.5px; font-weight: 700; cursor: pointer; transition: all 0.2s;
  }
  .wb-copy-badge:hover { background: #D31F1F; color: #fff; }
  .wb-copy-badge.copied { background: #f0fdf4; color: #16a34a; }

  /* Custom Steps */
  .wb-steps-container { width: 100%; display: flex; flex-direction: column; gap: 14px; margin-bottom: 32px; }
  .wb-step { display: flex; gap: 14px; align-items: flex-start; }
  .wb-step-num {
    width: 24px; height: 24px; border-radius: 50%; background: #fef2f2; color: #D31F1F;
    display: flex; align-items: center; justify-content: center; flex-shrink: 0;
    font-size: 13px; font-weight: 800; border: 1px solid #fee2e2;
  }
  .wb-step-text { font-size: 14px; line-height: 1.5; color: #475569; padding-top: 1px; }
  .wb-step-text b { color: #0f172a; font-weight: 700; }

  /* WA Button */
  .wb-confirm-btn {
    display: flex; align-items: center; justify-content: center; gap: 10px; width: 100%;
    padding: 16px; background: linear-gradient(to right, #25D366, #20BD5A); color: #fff;
    font-size: 16px; font-weight: 800; border-radius: 16px; text-decoration: none;
    box-shadow: 0 12px 28px -8px rgba(37,211,102,0.6); transition: all 0.25s cubic-bezier(0.2, 0.9, 0.3, 1.15);
  }
  .wb-confirm-btn:hover { transform: translateY(-2px) scale(1.02); box-shadow: 0 16px 32px -8px rgba(37,211,102,0.8); }

  @media (max-width: 640px) {
    .wb-modal-content { padding: 0; max-width: 90vw; }
    .wb-modal-body { padding: 0 20px 24px; }
    .wb-modal-title { font-size: 22px; }
    .wb-pay-total { font-size: 22px; }
    .wb-acc-number { font-size: 22px; }
  }
</style>

<script>
  const WB_FORM = document.getElementById(
    "webinar-promo-form",
  ) as HTMLFormElement;
  if (WB_FORM) {
    const btn = WB_FORM.querySelector(
      'button[type="submit"]',
    ) as HTMLButtonElement;
    const msgSent = WB_FORM.querySelector(".wb-msg-sent") as HTMLElement;
    const msgErr = WB_FORM.querySelector(".wb-msg-err") as HTMLElement;
    const scriptUrl = WB_FORM.getAttribute("data-script-url") || "";
    const waNumber = WB_FORM.getAttribute("data-wa-number") || "";
    const hasEp = scriptUrl.startsWith("http");
    let busy = false;

    const NAME_RE = /^[\p{L}\p{M}\d\s.\-']{2,100}$/u;
    const PHONE_RE = /^[0-9+\-\s()]{6,20}$/;

    function clip(v: any, n: number) {
      return String(v)
        .replace(/[\u0000-\u001F\u007F]/g, " ")
        .slice(0, n)
        .trim();
    }
    function showErr(t: string) {
      if (msgErr) {
        msgErr.textContent = t;
        msgErr.classList.remove("hidden");
        setTimeout(() => {
          if (msgErr) msgErr.classList.add("hidden");
        }, 6000);
      }
    }
    function setLoad(on: boolean) {
      busy = on;
      if (btn) {
        btn.disabled = on;
        const label = btn.querySelector(".wbf-label");
        const loading = btn.querySelector(".wbf-loading");
        if (label && loading) {
          if (on) {
            label.classList.add("hidden");
            loading.classList.remove("hidden");
            loading.classList.add("flex");
          } else {
            label.classList.remove("hidden");
            loading.classList.add("hidden");
            loading.classList.remove("flex");
          }
        }
      }
    }

    WB_FORM.addEventListener("submit", function (e) {
      e.preventDefault();
      if (busy) return;
      if (msgSent) msgSent.classList.add("hidden");

      const fd = new FormData(WB_FORM);
      if (String(fd.get("website") || "").length > 0) return;

      const nama = clip(fd.get("nama") || "", 100);
      let wa = clip(fd.get("whatsapp") || "", 20);
      const brand = clip(fd.get("brand") || "", 150);

      if (!NAME_RE.test(nama)) {
        showErr("Nama tidak valid (2–100 karakter).");
        return;
      }
      if (!PHONE_RE.test(wa)) {
        showErr("Nomor WhatsApp tidak valid.");
        return;
      }

      wa = wa.replace(/[^\d+]/g, "");
      if (!hasEp) {
        showErr("Form belum aktif. Coba lagi nanti.");
        return;
      }

      setLoad(true);
      const params = new URLSearchParams({
        nama,
        whatsapp: "'" + wa,
        brand,
        source: window.location.href.split("#")[0],
        _t: Date.now().toString(),
      });
      const waMsg =
        "Halo Tentaklik! Saya " +
        nama +
        ', ingin mendaftar Webinar Meta Ads "Dari Boncos ke Profit".' +
        (brand ? "\nBrand: " + brand : "");
      const waUrl = waNumber
        ? "https://wa.me/" + waNumber + "?text=" + encodeURIComponent(waMsg)
        : "";

      const trackLeadStr = WB_FORM.getAttribute("data-track-lead") || "true";
      const shouldTrackLead = trackLeadStr === "true";

      const w = window as any;
      if (shouldTrackLead) {
        console.log("Mencoba mengirim event Lead ke Meta...");
        if (typeof w.fbq === "function") {
          console.log("Meta Pixel (fbq) ditemukan. Mengirim event Lead...");
          w.fbq("track", "Lead", {
            content_name: "Webinar Meta Promo",
            content_category: "Webinar",
          });
        } else {
          console.log("ERROR: Meta Pixel (fbq) tidak ditemukan di window!");
        }
      }

      fetch(scriptUrl + "?" + params.toString(), {
        mode: "no-cors",
        keepalive: true,
      }).catch(() => {});

      setTimeout(function () {
        WB_FORM.reset();
        if (msgSent) msgSent.classList.remove("hidden");
        setLoad(false);
        w.dataLayer = w.dataLayer || [];
        w.dataLayer.push({
          event: "generate_lead",
          form_platform: "meta",
          form_kategori: "webinar_promo",
          form_source: window.location.pathname,
        });

        const modal = document.getElementById("payment-modal-promo");
        const btnConfirm = document.getElementById("wb-confirm-btn");
        if (modal && btnConfirm && waUrl) {
          btnConfirm.setAttribute("href", waUrl);
          modal.classList.add("is-open");
          document.body.style.overflow = "hidden";
          
          // Confetti ledakan (merah putih) ketika berhasil
          const wConfetti = window as any;
          if (typeof wConfetti.confetti === "function") {
            const defaults = { colors: ["#cc0000", "#ffffff"], zIndex: 10000 };
            wConfetti.confetti(Object.assign({}, defaults, { particleCount: 70, angle: 60, spread: 80, origin: { x: 0, y: 0.6 } }));
            wConfetti.confetti(Object.assign({}, defaults, { particleCount: 70, angle: 120, spread: 80, origin: { x: 1, y: 0.6 } }));
          }
        } else if (waUrl) {
          window.location.href = waUrl;
        }
      }, 1500);
    });
  }

  // Modal interactions
  const wbModal = document.getElementById("payment-modal-promo");
  if (wbModal) {
    const closeBtn = wbModal.querySelector(".wb-modal-close") as HTMLButtonElement;
    const overlay = wbModal.querySelector(".wb-modal-overlay") as HTMLElement;
    const copyBtn = document.getElementById("wb-copy-btn") as HTMLButtonElement;
    const accText = document.getElementById("wb-bank-acc") as HTMLElement;
    const confirmBtn = document.getElementById("wb-confirm-btn") as HTMLAnchorElement;

    function closeWbModal() {
      if (wbModal) wbModal.classList.remove("is-open");
      document.body.style.overflow = "";
    }

    if (closeBtn) closeBtn.addEventListener("click", closeWbModal);
    if (overlay) overlay.addEventListener("click", closeWbModal);
    if (confirmBtn) confirmBtn.addEventListener("click", closeWbModal);
    document.addEventListener("keydown", function (e) {
      if (e.key === "Escape" && wbModal && wbModal.classList.contains("is-open")) closeWbModal();
    });

    if (copyBtn && accText) {
      copyBtn.addEventListener("click", function () {
        const text = accText.textContent || "";
        navigator.clipboard.writeText(text).then(function () {
          const originalHtml = copyBtn.innerHTML;
          copyBtn.classList.add("copied");
          copyBtn.innerHTML = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg><span>Tersalin</span>';
          setTimeout(function () {
            copyBtn.classList.remove("copied");
            copyBtn.innerHTML = originalHtml;
          }, 2000);
        });
      });
    }
  }
</script>
