---
interface Problem { icon: string; title: string; desc: string; }
interface Props { heading: string; sub: string; items: Problem[]; }
const { heading, sub, items } = Astro.props;

const ICONS: Record<string, string> = {
  'trending-down': '<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 18 13.5 8.5 8.5 13.5 1 6"/><polyline points="17 18 23 18 23 12"/></svg>',
  'target': '<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="2"/></svg>',
  'compass': '<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"/></svg>',
  'palette': '<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10c.9 0 1.5-.7 1.5-1.5 0-.4-.1-.7-.4-1-.3-.3-.4-.7-.4-1.1 0-.8.7-1.5 1.5-1.5H16c3.3 0 6-2.7 6-6 0-5-4.5-9-10-9z"/><circle cx="7.5" cy="11.5" r="1.5"/><circle cx="10.5" cy="7.5" r="1.5"/><circle cx="14.5" cy="7.5" r="1.5"/><circle cx="17.5" cy="11.5" r="1.5"/></svg>',
  'cursor-click': '<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M9 9l5 12 1.8-5.2L21 14z"/><path d="M7.2 2.2L8 5.1"/><path d="M2.2 7.2l2.9.8"/><path d="M3.5 3.5l2.1 2.1"/></svg>',
  'wallet': '<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="6" width="22" height="14" rx="2"/><path d="M1 10h22"/><circle cx="17" cy="14" r="1"/><path d="M5 6V4a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v2"/></svg>',
  'chart-bar': '<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>',
  'search': '<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>',
};
---
<section class="wb-problems" aria-labelledby="wb-problems-heading">
  <div class="container">
    <h2 id="wb-problems-heading" class="section-title">{heading}</h2>
    <p class="section-sub" style="margin-bottom:44px;">{sub}</p>
    <div class="wb-problems-grid">
      {items.map((p) => (
        <article class="wb-problem-card reveal">
          <div class="wb-problem-icon-wrap" aria-hidden="true">
            <Fragment set:html={ICONS[p.icon] || ''} />
          </div>
          <h3 class="wb-problem-title">{p.title}</h3>
          <p class="wb-problem-desc">{p.desc}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .wb-problems { background: white; }
  .wb-problems-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 18px;
  }
  .wb-problem-card {
    background: white;
    border: 1.5px solid var(--orange-100, #FFE8D6);
    border-radius: var(--radius-xl, 16px);
    padding: 28px 24px 24px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
    position: relative;
  }
  .wb-problem-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 16px 40px rgba(255,107,26,0.10);
    border-color: var(--orange-400, #FB923C);
  }
  .wb-problem-icon-wrap {
    width: 48px; height: 48px;
    border-radius: 12px;
    background: linear-gradient(135deg, var(--orange-50, #FFF4EC), var(--orange-100, #FFE8D6));
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--orange-600, #EA580C);
    flex-shrink: 0;
  }
  .wb-problem-title {
    font-size: 16px; font-weight: 700;
    color: var(--ink-900, #0F172A);
    margin: 0; line-height: 1.3;
  }
  .wb-problem-desc {
    font-size: 13.5px;
    color: var(--ink-500, #64748B);
    line-height: 1.55; margin: 0;
  }
  @media (max-width: 900px) {
    .wb-problems-grid { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 520px) {
    .wb-problems-grid { grid-template-columns: 1fr; }
    .wb-problem-card { padding: 22px 20px 20px; }
    .wb-problem-title { font-size: 15px; }
  }
</style>
