---
/**
 * GadsCurriculum — 2 kolom: kiri heading sticky, kanan daftar materi bernomor.
 * Komponen terpisah dari WebinarCurriculum (dipakai LP Meta) agar style tak bentrok.
 */
interface CurriculumItem { number: string; title: string; desc: string; }
interface Props { heading: string; items: CurriculumItem[]; eventPlatform: string; eventTime: string; }
const { heading, items, eventPlatform, eventTime } = Astro.props;
---
<section class="gd-curr" aria-labelledby="gd-curr-heading">
  <div class="container">
    <div class="gd-curr-grid">

      <div class="gd-curr-aside">
        <div class="gd-curr-card-wrap">
          <div class="gd-curr-card-border">
            <div class="gd-curr-card-inner">
              <div class="gd-curr-glow"></div>
              
              <div class="gd-curr-card-header">
                <div class="gd-curr-icon">
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1 0-5H20"/><path d="M12 2v20"/></svg>
                </div>
                <div class="gd-curr-title-wrap">
                  <span class="gd-curr-eyebrow">Materi</span>
                  <h2 id="gd-curr-heading" class="gd-curr-h2">{heading}</h2>
                </div>
              </div>

              <div class="gd-curr-divider">
                <div class="gd-curr-div-orange"></div>
                <div class="gd-curr-div-gray"></div>
              </div>

              <div class="gd-curr-meta-row">
                <span class="meta-item">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" width="16" height="16"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                  {items.length} sesi pembahasan
                </span>
                <span class="meta-item">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" width="16" height="16"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
                  {eventTime}
                </span>
                <span class="meta-item">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" width="16" height="16"><rect x="2" y="7" width="16" height="10" rx="2"/><path d="M22 8l-4 3v2l4 3z"/></svg>
                  {eventPlatform}
                </span>
              </div>

              <svg class="gd-curr-chevron" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="var(--gd-orange, #FF7A1A)" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M9 18l6-6-6-6"/>
              </svg>
            </div>
          </div>
        </div>
      </div>

      <ol class="gd-curr-list" role="list">
        {items.map((item) => (
          <li class="gd-curr-item reveal">
            <span class="gd-curr-num" aria-hidden="true">{item.number}</span>
            <div class="gd-curr-body">
               <h3 class="gd-curr-title">{item.title}</h3>
               <p class="gd-curr-desc">{item.desc}</p>
            </div>
          </li>
        ))}
      </ol>

    </div>
  </div>
</section>
<style>
  .gd-curr { background: var(--gd-cream, #FDFAF7); border-bottom: 1px solid var(--gd-line, #ECE5DE); }
  .gd-curr-grid {
    max-width: 1180px; margin: 0 auto;
    display: grid; grid-template-columns: minmax(0, 0.75fr) minmax(0, 1fr);
    gap: 72px; align-items: start;
  }
  .gd-curr-aside { position: sticky; top: 96px; z-index: 10; }
  
  /* New Card UI */
  .gd-curr-card-wrap {
    filter: drop-shadow(0 15px 30px rgba(255,122,26,0.12));
  }
  .gd-curr-card-border {
    background: var(--gd-orange, #FF7A1A);
    padding: 1.5px;
    clip-path: polygon(0 0, calc(100% - 50px) 0, 100% 50%, calc(100% - 50px) 100%, 0 100%);
    border-radius: 12px 0 0 12px;
  }
  .gd-curr-card-inner {
    background: #fff;
    clip-path: polygon(0 0, calc(100% - 49px) 0, 100% 50%, calc(100% - 49px) 100%, 0 100%);
    border-radius: 11px 0 0 11px;
    padding: 32px 76px 32px 32px;
    position: relative;
    overflow: hidden;
  }
  .gd-curr-glow {
    position: absolute;
    top: -50px; right: 0; bottom: -50px; width: 140px;
    background: radial-gradient(circle at right center, rgba(255,122,26,0.2) 0%, transparent 60%);
    pointer-events: none;
  }
  .gd-curr-card-header {
    display: flex; align-items: center; gap: 16px;
    position: relative; z-index: 2;
  }
  .gd-curr-icon {
    width: 48px; height: 48px; border-radius: 12px;
    background: var(--gd-orange-soft, #FFF1E4); color: var(--gd-orange, #FF7A1A);
    display: flex; align-items: center; justify-content: center;
    flex-shrink: 0;
  }
  .gd-curr-title-wrap { display: flex; flex-direction: column; gap: 2px; }
  .gd-curr-eyebrow { font-size: 14px; color: var(--gd-ink-3, #6B7280); letter-spacing: 0.02em; }
  .gd-curr-h2 { font-size: 24px; font-weight: 800; color: var(--gd-ink, #0E1B2A); margin: 0; letter-spacing: -0.02em; }
  
  .gd-curr-divider {
    display: flex; align-items: center; margin: 20px 0;
    position: relative; z-index: 2;
  }
  .gd-curr-div-orange { height: 2px; width: 56px; background: var(--gd-orange, #FF7A1A); }
  .gd-curr-div-gray { height: 1px; flex: 1; background: var(--gd-line, #ECE5DE); }

  .gd-curr-meta-row {
    display: flex; align-items: center; gap: 16px; flex-wrap: wrap;
    position: relative; z-index: 2;
  }
  .meta-item {
    display: flex; align-items: center; gap: 8px;
    font-size: 13.5px; font-weight: 500; color: var(--gd-ink-3, #6B7280);
  }
  .meta-item svg { color: var(--gd-ink-4, #8B95A3); }
  .meta-item:not(:last-child)::after {
    content: ''; display: block; width: 1px; height: 12px;
    background: var(--gd-line, #ECE5DE); margin-left: 16px;
  }
  
  .gd-curr-chevron {
    position: absolute; top: 50%; right: 12px;
    transform: translateY(-50%);
    pointer-events: none; z-index: 2;
  }

  .gd-curr-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 12px; counter-reset: none; }
  .gd-curr-item {
    display: flex; gap: 20px; align-items: flex-start;
    background: #fff; border: 1px solid var(--gd-line, #ECE5DE);
    border-radius: 16px; padding: 22px 24px;
    transition: transform 0.22s ease, box-shadow 0.22s ease, border-color 0.22s ease;
  }
  .gd-curr-item:hover {
    transform: translateY(-2px); border-color: var(--gd-orange-200, #FFD7B5);
    box-shadow: 0 14px 34px -20px rgba(14,27,42,0.22);
  }
  .gd-curr-num {
    font-size: 13px; font-weight: 700; letter-spacing: 0.04em; flex-shrink: 0;
    color: var(--gd-orange, #FF7A1A); font-variant-numeric: tabular-nums;
    width: 34px; height: 34px; border-radius: 10px;
    display: flex; align-items: center; justify-content: center;
    background: var(--gd-orange-soft, #FFF1E4);
  }
  .gd-curr-body { min-width: 0; }
  .gd-curr-title {
    font-size: 17px; font-weight: 700; line-height: 1.3; letter-spacing: -0.02em;
    color: var(--gd-ink, #0E1B2A); margin: 4px 0 0;
  }
  .gd-curr-desc { font-size: 14.5px; line-height: 1.6; color: var(--gd-ink-3, #6B7280); margin: 6px 0 0; }

  @media (max-width: 1040px) {
    .gd-curr-grid { grid-template-columns: 1fr; gap: 36px; max-width: 680px; }
    .gd-curr-aside { position: static; }
  }
  @media (max-width: 640px) {
    .gd-curr-item { padding: 18px; gap: 14px; border-radius: 14px; }
    .gd-curr-num { width: 30px; height: 30px; font-size: 12px; }
    .gd-curr-title { font-size: 16px; }
    .gd-curr-desc { font-size: 14px; }
    
    .gd-curr-card-inner { padding: 24px 64px 24px 20px; }
    .gd-curr-h2 { font-size: 20px; }
    .gd-curr-icon { width: 40px; height: 40px; }
    .gd-curr-icon svg { width: 20px; height: 20px; }
    .meta-item:not(:last-child)::after { display: none; }
    .gd-curr-meta-row { gap: 10px; flex-direction: column; align-items: flex-start; }
  }
</style>
