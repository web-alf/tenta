---
/**
 * GadsHero — redesign 2 kolom (kiri: copy, kanan: ticket card).
 * Kiri  : hook pill → H1 → desc → sublines → meta event → speaker
 * Kanan : sticky ticket card (harga, countdown, CTA, notes)
 * Copy mengikuti eventgads.md — tidak ada copy baru.
 */
interface Props {
  hook: string;
  title: string;
  titleAccent: string;
  desc: string;
  subLines: string[];
  ctaText: string;
  ctaHref: string;
  speakerName: string;
  speakerTitle: string;
  speakerPhoto: string;
  eventDate: string;
  eventTime: string;
  eventPlatform: string;
  earlyBirdDeadline: string;
  seatLeft: number;
  priceEarlyBird: string;
  priceRegular: string;
  priceOriginal: string;
}
const {
  hook, title, titleAccent, desc, subLines,
  ctaText, ctaHref,
  speakerName, speakerTitle, speakerPhoto,
  eventDate, eventTime, eventPlatform,
  earlyBirdDeadline, seatLeft,
  priceEarlyBird, priceRegular, priceOriginal,
} = Astro.props;
const hasPhoto = speakerPhoto && speakerPhoto.length > 0;
---

<!-- Announcement bar -->
<div class="gd-bar">
  <div class="gd-bar-inner">
    <span class="gd-bar-dot" aria-hidden="true"></span>
    <p class="gd-bar-text">
      <strong>Early Bird {priceEarlyBird}</strong>
      <span class="gd-bar-sep" aria-hidden="true">·</span>
      hanya {seatLeft} kursi pertama
    </p>
    <a href={ctaHref} class="gd-bar-cta">Amankan kursi</a>
  </div>
</div>

<section class="gd-hero" aria-labelledby="gd-hero-heading">
  <div class="gd-hero-diagonal" aria-hidden="true"></div>
  <div class="gd-hero-dots" aria-hidden="true"></div>
  <div class="container">
    <div class="gd-hero-grid">

      <!-- ── KIRI: copy ─────────────────────────────── -->
      <div class="gd-hero-copy">
        <!-- TODO: ganti dengan ilustrasi asli saat aset tersedia -->
        <div class="gd-hero-illu" aria-hidden="true">
          <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v18h18"/><path d="m19 9-5 5-4-4-4 4"/></svg>
          <span>Live campaign teardown</span>
        </div>
        <span class="gd-pill">{hook}</span>

        <h1 id="gd-hero-heading" class="gd-h1">
          {title}
          <span class="gd-h1-accent">{titleAccent}</span>
        </h1>

        <p class="gd-lead">{desc}</p>

        <ul class="gd-lines" role="list">
          {subLines.map((line) => <li class="gd-line">{line}</li>)}
        </ul>

        <div class="gd-facts" role="list" aria-label="Detail webinar">
          <span class="gd-fact" role="listitem">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4.5" width="18" height="17" rx="2.5"/><path d="M8 2.5v4M16 2.5v4M3 10h18"/></svg>
            {eventDate}
          </span>
          <span class="gd-fact" role="listitem">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5.5l3.5 2"/></svg>
            {eventTime}
          </span>
          <span class="gd-fact" role="listitem">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2.5" y="4" width="19" height="13" rx="2.5"/><path d="M8.5 21h7M12 17v4"/></svg>
            {eventPlatform}
          </span>
        </div>

        <div class="gd-speaker">
          <div class="gd-speaker-ava">
            {hasPhoto ? (
              <img src={speakerPhoto} alt={`Foto ${speakerName}`} width="56" height="56" loading="eager" decoding="async" />
            ) : (
              <span class="gd-speaker-ph" aria-hidden="true">
                <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4"/><path d="M4 20c0-4 3.6-7 8-7s8 3 8 7"/></svg>
              </span>
            )}
          </div>
          <div class="gd-speaker-txt">
            <span class="gd-speaker-kicker">Pemateri</span>
            <strong class="gd-speaker-name">{speakerName}</strong>
            <span class="gd-speaker-role">{speakerTitle}</span>
          </div>
        </div>
      </div>

      <!-- ── KANAN: ticket card ─────────────────────── -->
      <aside class="gd-ticket-col" aria-label="Investasi dan pendaftaran">
        <div class="gd-ticket reveal">
          <div class="gd-ticket-head">
            <span class="gd-ticket-kicker">Investasi</span>
            <span class="gd-ticket-seat">{seatLeft} kursi</span>
          </div>

          <div class="gd-price">
            <div class="gd-price-strike">
              <s>{priceOriginal}</s>
              <span class="gd-price-reg">{priceRegular}</span>
            </div>
            <div class="gd-price-main">
              <span class="gd-price-eb">{priceEarlyBird}</span>
              <span class="gd-price-tag">Early bird</span>
            </div>
            <p class="gd-price-note">Untuk {seatLeft} peserta tercepat, setelah itu {priceRegular}.</p>
          </div>

          <div class="gd-cd" id="gd-countdown-wrap" aria-live="polite">
            <span class="gd-cd-kicker">Early bird berakhir dalam</span>
            <div class="gd-cd-row">
              <span class="gd-cd-unit"><b class="gd-cd-num" id="gd-cd-days">--</b><i>Hari</i></span>
              <span class="gd-cd-unit"><b class="gd-cd-num" id="gd-cd-hours">--</b><i>Jam</i></span>
              <span class="gd-cd-unit"><b class="gd-cd-num" id="gd-cd-mins">--</b><i>Menit</i></span>
              <span class="gd-cd-unit"><b class="gd-cd-num" id="gd-cd-secs">--</b><i>Detik</i></span>
            </div>
          </div>

          <a href={ctaHref} class="gd-btn gd-btn-primary" id="gd-hero-cta">
            {ctaText}
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h13M12.5 5.5 19 12l-6.5 6.5"/></svg>
          </a>

          <ul class="gd-ticket-notes" role="list">
            <li>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="10.5" width="16" height="10.5" rx="2.5"/><path d="M8 10.5V7a4 4 0 0 1 8 0v3.5"/></svg>
              Akses Zoom dikirim setelah pembayaran
            </li>
            <li>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M13 2 4 14h7l-1 8 9-12h-7l1-8Z"/></svg>
              Kuota early bird terbatas
            </li>
          </ul>
        </div>
      </aside>

    </div>
  </div>
</section>

<style>
  /* ── Announcement bar ─────────────────────────── */
  .gd-bar {
    position: sticky; top: 0; z-index: 100;
    background: var(--gd-ink, #0E1B2A);
    border-bottom: 1px solid rgba(255,255,255,0.08);
  }
  .gd-bar-inner {
    max-width: 1180px; margin: 0 auto; padding: 10px 24px;
    display: flex; align-items: center; justify-content: center; gap: 14px; flex-wrap: wrap;
  }
  .gd-bar-dot {
    width: 7px; height: 7px; border-radius: 50%; flex-shrink: 0;
    background: var(--gd-orange, #FF7A1A);
    box-shadow: 0 0 0 4px rgba(255,122,26,0.18);
  }
  .gd-bar-text { font-size: 13.5px; color: rgba(255,255,255,0.72); margin: 0; letter-spacing: -0.01em; }
  .gd-bar-text strong { color: #fff; font-weight: 600; }
  .gd-bar-sep { color: rgba(255,255,255,0.3); margin: 0 4px; }
  .gd-bar-cta {
    display: inline-flex; align-items: center; justify-content: center;
    min-height: 32px; font-size: 12.5px; font-weight: 700; color: #fff; text-decoration: none;
    padding: 6px 14px; border-radius: 999px; white-space: nowrap;
    background: var(--gd-orange, #FF7A1A);
    transition: background 0.18s ease;
  }
  /* Perbesar area sentuh tanpa menggemukkan bar (pseudo-element, bukan padding) */
  .gd-bar-cta { position: relative; }
  .gd-bar-cta::after {
    content: ''; position: absolute; left: 0; right: 0;
    top: 50%; transform: translateY(-50%); height: 44px;
  }
  .gd-bar-cta:hover { background: var(--gd-orange-700, #C94E0E); }

  /* ── Hero shell ───────────────────────────────── */
  .gd-hero {
    position: relative; overflow: hidden;
    background: var(--gd-cream, #FDFAF7);
    border-bottom: 1px solid var(--gd-line, #ECE5DE);
    padding: 84px 0 96px;
  }
  .gd-hero-diagonal {
    position: absolute; inset: 0; pointer-events: none;
    clip-path: polygon(64% 0, 100% 0, 100% 100%, 48% 100%);
    background:
      radial-gradient(ellipse 70% 60% at 85% 15%, rgba(255,148,71,0.5) 0%, transparent 60%),
      linear-gradient(155deg, #2A1608 0%, var(--gd-orange-700, #C94E0E) 42%, var(--gd-orange, #FF7A1A) 100%);
  }
  .gd-hero-dots {
    position: absolute; left: -24px; bottom: 8%;
    width: 168px; height: 220px; opacity: 0.16; pointer-events: none;
    background-image: radial-gradient(var(--gd-orange, #FF7A1A) 1.5px, transparent 1.5px);
    background-size: 14px 14px;
  }
  .gd-hero-grid {
    position: relative; z-index: 1;
    max-width: 1180px; margin: 0 auto;
    display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 400px);
    gap: 72px; align-items: start;
  }

  /* ── Kiri ─────────────────────────────────────── */
  .gd-hero-copy { padding-top: 4px; min-width: 0; }
  .gd-hero-illu {
    display: inline-flex; align-items: center; gap: 9px;
    font-size: 12px; font-weight: 700; color: var(--gd-orange-700, #C94E0E);
    background: var(--gd-orange-soft, #FFF1E4); border: 1px solid var(--gd-orange-200, #FFD7B5);
    border-radius: 12px; padding: 8px 14px 8px 10px; margin-bottom: 16px;
  }
  .gd-hero-illu svg { flex-shrink: 0; }
  .gd-pill {
    display: inline-flex; align-items: center;
    font-size: 11.5px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase;
    color: var(--gd-orange-700, #C94E0E);
    background: var(--gd-orange-soft, #FFF1E4);
    border: 1px solid var(--gd-orange-200, #FFD7B5);
    padding: 7px 14px; border-radius: 999px;
  }
  .gd-h1 {
    font-size: clamp(36px, 4.4vw, 60px); font-weight: 800; line-height: 1.03;
    letter-spacing: -0.035em; color: var(--gd-ink, #0E1B2A);
    margin: 22px 0 0; text-wrap: balance;
  }
  .gd-h1-accent {
    display: block;
    background: linear-gradient(100deg, var(--gd-orange, #FF7A1A) 10%, #FF9E52 95%);
    -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent;
  }
  .gd-lead {
    font-size: 17.5px; line-height: 1.6; color: var(--gd-ink-3, #6B7280);
    max-width: 46ch; margin: 20px 0 0; overflow-wrap: break-word;
  }
  .gd-lines {
    list-style: none; margin: 28px 0 0; padding: 0 0 0 20px;
    border-left: 2px solid var(--gd-orange-200, #FFD7B5);
    display: flex; flex-direction: column; gap: 5px; max-width: 52ch; min-width: 0;
  }
  .gd-line { font-size: 15.5px; line-height: 1.6; color: var(--gd-ink-2, #2D3D52); font-weight: 500; overflow-wrap: break-word; }
  .gd-line:last-child { color: var(--gd-ink, #0E1B2A); font-weight: 600; }

  .gd-facts {
    display: flex; flex-wrap: wrap; align-items: center; gap: 10px 22px;
    margin-top: 30px; padding-top: 26px; min-width: 0;
    border-top: 1px solid var(--gd-line, #ECE5DE);
  }
  .gd-fact {
    display: inline-flex; align-items: center; gap: 8px; max-width: 100%;
    font-size: 14px; font-weight: 600; color: var(--gd-ink-2, #2D3D52); letter-spacing: -0.01em;
    overflow-wrap: break-word;
  }
  .gd-fact svg { color: var(--gd-orange, #FF7A1A); flex-shrink: 0; }

  .gd-speaker { display: flex; align-items: center; gap: 14px; margin-top: 26px; min-width: 0; }
  .gd-speaker-ava { flex-shrink: 0; }
  .gd-speaker-ava img, .gd-speaker-ph {
    width: 56px; height: 56px; border-radius: 50%; object-fit: cover; display: block;
    background: var(--gd-orange-soft, #FFF1E4); color: var(--gd-orange, #FF7A1A);
    box-shadow: 0 0 0 1px var(--gd-line, #ECE5DE);
  }
  .gd-speaker-ph { display: flex; align-items: center; justify-content: center; }
  .gd-speaker-txt { display: flex; flex-direction: column; gap: 1px; min-width: 0; }
  .gd-speaker-kicker {
    font-size: 10.5px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase;
    color: var(--gd-ink-4, #8B95A3);
  }
  .gd-speaker-name { font-size: 16px; font-weight: 700; color: var(--gd-ink, #0E1B2A); letter-spacing: -0.015em; }
  .gd-speaker-role { font-size: 13px; color: var(--gd-ink-3, #6B7280); line-height: 1.4; overflow-wrap: break-word; }

  /* ── Kanan: ticket card ───────────────────────── */
  .gd-ticket-col { position: sticky; top: 68px; }
  .gd-ticket {
    background: #fff; border: 1px solid rgba(255,255,255,0.6);
    border-radius: 22px; padding: 26px;
    box-shadow: 0 1px 2px rgba(0,0,0,0.06), 0 30px 60px -20px rgba(42,22,8,0.55);
  }
  .gd-ticket-head { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
  .gd-ticket-kicker {
    font-size: 10.5px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase;
    color: var(--gd-ink-4, #8B95A3);
  }
  .gd-ticket-seat {
    font-size: 11.5px; font-weight: 700; color: var(--gd-orange-700, #C94E0E);
    background: var(--gd-orange-soft, #FFF1E4); border-radius: 999px; padding: 4px 10px;
  }

  .gd-price { margin-top: 14px; }
  .gd-price-strike { display: flex; align-items: baseline; gap: 10px; }
  .gd-price-strike s { font-size: 14px; color: var(--gd-ink-4, #8B95A3); }
  .gd-price-reg { font-size: 15px; font-weight: 600; color: var(--gd-ink-3, #6B7280); }
  .gd-price-main { display: flex; align-items: baseline; gap: 10px; margin-top: 2px; }
  .gd-price-eb {
    font-size: 42px; font-weight: 800; letter-spacing: -0.04em; line-height: 1.05;
    color: var(--gd-ink, #0E1B2A);
  }
  .gd-price-tag {
    font-size: 11px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase;
    color: var(--gd-orange-700, #C94E0E); background: var(--gd-orange-soft, #FFF1E4);
    border-radius: 6px; padding: 4px 8px;
  }
  .gd-price-note { font-size: 13px; line-height: 1.5; color: var(--gd-ink-3, #6B7280); margin: 10px 0 0; }

  .gd-cd {
    margin: 22px 0; padding: 16px;
    background: var(--gd-cream, #FDFAF7); border: 1px solid var(--gd-line, #ECE5DE);
    border-radius: 14px;
  }
  .gd-cd-kicker {
    display: block; font-size: 10.5px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase;
    color: var(--gd-ink-4, #8B95A3); margin-bottom: 10px;
  }
  .gd-cd-row { display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px; }
  .gd-cd-unit { display: flex; flex-direction: column; align-items: center; gap: 3px; }
  .gd-cd-num {
    font-size: 22px; font-weight: 700; line-height: 1; letter-spacing: -0.03em;
    color: var(--gd-ink, #0E1B2A); font-variant-numeric: tabular-nums;
  }
  .gd-cd-unit i {
    font-style: normal; font-size: 9.5px; font-weight: 600; letter-spacing: 0.08em;
    text-transform: uppercase; color: var(--gd-ink-4, #8B95A3);
  }

  .gd-btn {
    display: flex; align-items: center; justify-content: center; gap: 9px;
    width: 100%; padding: 15px 20px; border-radius: 14px;
    font-size: 15.5px; font-weight: 700; letter-spacing: -0.01em; text-decoration: none;
    transition: transform 0.18s ease, box-shadow 0.18s ease, background 0.18s ease;
  }
  .gd-btn-primary {
    background: var(--gd-orange, #FF7A1A); color: #fff;
    box-shadow: 0 10px 24px -12px rgba(255,122,26,0.6);
  }
  .gd-btn-primary:hover { background: var(--gd-orange-700, #C94E0E); transform: translateY(-1px); box-shadow: 0 14px 30px -12px rgba(255,122,26,0.65); }
  .gd-btn svg { transition: transform 0.18s ease; }
  .gd-btn:hover svg { transform: translateX(3px); }

  .gd-ticket-notes { list-style: none; margin: 16px 0 0; padding: 0; display: flex; flex-direction: column; gap: 8px; }
  .gd-ticket-notes li {
    display: flex; align-items: center; gap: 9px;
    font-size: 12.5px; color: var(--gd-ink-3, #6B7280); line-height: 1.4;
  }
  .gd-ticket-notes svg { color: var(--gd-orange, #FF7A1A); flex-shrink: 0; }

  /* ── Responsive ───────────────────────────────── */
  @media (max-width: 1040px) {
    .gd-hero-grid { grid-template-columns: 1fr; gap: 44px; max-width: 680px; }
    .gd-ticket-col { position: static; }
    .gd-hero { padding: 60px 0 72px; }
    .gd-lead, .gd-lines { max-width: none; }
    .gd-hero-diagonal { display: none; }
  }
  @media (max-width: 640px) {
    .gd-hero { padding: 44px 0 56px; }
    .gd-hero-dots { display: none; }
    .gd-h1 { letter-spacing: -0.03em; }
    .gd-lead { font-size: 16px; }
    .gd-facts { gap: 10px 18px; margin-top: 24px; padding-top: 20px; }
    .gd-fact { font-size: 13.5px; }
    .gd-ticket { padding: 20px; border-radius: 18px; }
    .gd-price-eb { font-size: 36px; }
  }
  @media (max-width: 420px) {
    .gd-bar-inner { padding: 9px 16px; gap: 10px; }
    .gd-bar-text { font-size: 12.5px; }
    .gd-bar-cta { font-size: 12px; padding: 5px 12px; }
    .gd-pill { font-size: 10.5px; padding: 6px 12px; }
    .gd-lines { padding-left: 16px; }
    .gd-line { font-size: 14.5px; }
    .gd-cd-num { font-size: 19px; }
    .gd-cd-row { gap: 4px; }
  }
</style>

<script define:vars={{ earlyBirdDeadline }} is:inline>
  (function() {
    var deadline = new Date(earlyBirdDeadline).getTime();
    var elD = document.getElementById('gd-cd-days');
    var elH = document.getElementById('gd-cd-hours');
    var elM = document.getElementById('gd-cd-mins');
    var elS = document.getElementById('gd-cd-secs');
    var wrap = document.getElementById('gd-countdown-wrap');
    function pad(n) { return String(n).padStart(2, '0'); }
    function tick() {
      var diff = deadline - Date.now();
      if (diff <= 0) { if (wrap) wrap.style.display = 'none'; return; }
      if (elD) elD.textContent = pad(Math.floor(diff / 86400000));
      if (elH) elH.textContent = pad(Math.floor((diff % 86400000) / 3600000));
      if (elM) elM.textContent = pad(Math.floor((diff % 3600000) / 60000));
      if (elS) elS.textContent = pad(Math.floor((diff % 60000) / 1000));
    }
    tick();
    var iv = setInterval(tick, 1000);
    document.addEventListener('astro:before-swap', function() { clearInterval(iv); }, { once: true });
  })();
</script>
