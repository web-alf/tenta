---
interface Props { name: string; title: string; bio: string; photoSrc?: string; credentials?: string[]; }
const { name, title, bio, photoSrc = '', credentials = [] } = Astro.props;
const hasPhoto = photoSrc && photoSrc.length > 0;
---
<section class="wb-speaker" aria-labelledby="wb-speaker-heading">
  <div class="container wb-speaker-inner">
    <span class="wb-speaker-eyebrow">Meet the Speaker</span>
    <h2 id="wb-speaker-heading" class="section-title" style="margin-bottom:48px;">Siapa yang Akan Membimbing Anda?</h2>
    <div class="wb-speaker-card reveal">
      <div class="wb-speaker-avatar-wrap">
        {hasPhoto ? (
          <img src={photoSrc} alt={`Foto ${name}`} class="wb-speaker-photo" width="160" height="160" loading="lazy" />
        ) : (
          <div class="wb-speaker-placeholder" aria-hidden="true">
            <svg width="72" height="72" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4"/><path d="M4 20c0-4 3.6-7 8-7s8 3 8 7"/></svg>
          </div>
        )}
        <div class="wb-speaker-ring" aria-hidden="true"></div>
      </div>
      <div class="wb-speaker-info">
        <h3 class="wb-speaker-name">{name}</h3>
        <p class="wb-speaker-role">{title}</p>
        <p class="wb-speaker-bio">{bio}</p>
        {credentials.length > 0 && (
          <div class="wb-speaker-creds" role="list">
            {credentials.map((c) => (
              <span class="wb-cred-pill" role="listitem">&#10003; {c}</span>
            ))}
          </div>
        )}
      </div>
    </div>
  </div>
</section>
<style>
  .wb-speaker { background: var(--bg-warm, #FFF8F3); text-align: center; }
  .wb-speaker-eyebrow {
    display: inline-block; background: var(--orange-100, #FFE8D6); color: var(--orange-700, #C2410C);
    font-size: 12px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase;
    padding: 5px 14px; border-radius: 999px; margin-bottom: 16px;
  }
  .wb-speaker-inner { display: flex; flex-direction: column; align-items: center; }
  .wb-speaker-card {
    display: flex; align-items: center; gap: 48px;
    background: white; border: 1.5px solid var(--orange-100, #FFE8D6);
    border-radius: var(--radius-xl, 20px); padding: 40px 48px;
    max-width: 800px; width: 100%;
    box-shadow: 0 4px 24px rgba(255,107,26,0.07); text-align: left;
  }
  .wb-speaker-avatar-wrap { position: relative; flex-shrink: 0; }
  .wb-speaker-photo { width: 160px; height: 160px; border-radius: 50%; object-fit: cover; position: relative; z-index: 1; display: block; }
  .wb-speaker-placeholder {
    width: 160px; height: 160px; border-radius: 50%; background: var(--orange-50, #FFF4EC);
    display: flex; align-items: center; justify-content: center; color: var(--orange-300, #FD9A6F); position: relative; z-index: 1;
  }
  .wb-speaker-ring { position: absolute; inset: -6px; border-radius: 50%; background: linear-gradient(135deg, #FF6B1A, #FF9A3C, #FEC89A); z-index: 0; opacity: 0.7; }
  .wb-speaker-name { font-size: 22px; font-weight: 800; color: var(--ink-900, #0F172A); margin: 0 0 4px; }
  .wb-speaker-role { font-size: 14px; font-weight: 600; color: var(--orange-600, #EA580C); margin: 0 0 16px; }
  .wb-speaker-bio { font-size: 15px; color: var(--ink-600, #475569); line-height: 1.65; margin: 0 0 20px; }
  .wb-speaker-creds { display: flex; flex-wrap: wrap; gap: 8px; }
  .wb-cred-pill { background: var(--orange-50, #FFF4EC); border: 1px solid var(--orange-200, #FFCBA4); border-radius: 999px; padding: 5px 12px; font-size: 12.5px; font-weight: 600; color: var(--orange-700, #C2410C); }
  @media (max-width: 700px) {
    .wb-speaker-card { flex-direction: column; text-align: center; padding: 32px 24px; gap: 24px; }
    .wb-speaker-creds { justify-content: center; }
  }
  @media (max-width: 480px) {
    .wb-speaker-card { padding: 28px 20px; gap: 20px; }
    .wb-speaker-photo { width: 120px; height: 120px; }
    .wb-speaker-placeholder { width: 120px; height: 120px; }
    .wb-speaker-placeholder svg { width: 56px; height: 56px; }
    .wb-speaker-name { font-size: 19px; }
    .wb-speaker-role { font-size: 13px; }
    .wb-speaker-bio { font-size: 14px; }
    .wb-cred-pill { font-size: 11.5px; padding: 4px 10px; }
  }
</style>
