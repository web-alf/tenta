---
interface Props {
  eyebrow: string; title: string; titleAccent: string; desc: string;
  ctaText: string; ctaHref: string;
  eventDate: string; eventTime: string; eventPlatform: string;
  earlyBirdDeadline: string; seatLeft: number;
  priceEarlyBird: string; priceRegular: string; priceOriginal: string;
}
const { eyebrow, title, titleAccent, desc, ctaText, ctaHref,
  eventDate, eventTime, eventPlatform,
  earlyBirdDeadline, seatLeft, priceEarlyBird, priceRegular, priceOriginal } = Astro.props;
---
<div class="wb-earlybird-bar" id="wb-earlybird-bar">
  <span class="wb-eb-icon" aria-hidden="true"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg></span>
  <span>Early Bird <strong>{priceEarlyBird}</strong> &mdash; hanya untuk <strong>{seatLeft}</strong> orang pertama!</span>
  <a href={ctaHref} class="wb-eb-btn">Amankan Kursi</a>
</div>

<section class="wb-hero" aria-labelledby="wb-hero-heading">
  <div class="wb-blob wb-blob-1" aria-hidden="true"></div>
  <div class="wb-blob wb-blob-2" aria-hidden="true"></div>
  <div class="container wb-hero-inner">
    <span class="wb-eyebrow">{eyebrow}</span>
    <h1 id="wb-hero-heading" class="wb-hero-title">
      {title} <span class="wb-title-accent">{titleAccent}</span>
    </h1>
    <p class="wb-hero-desc">{desc}</p>
    <div class="wb-meta-badges" role="list" aria-label="Detail webinar">
      <div class="wb-badge" role="listitem"><span class="wb-badge-svg" aria-hidden="true"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg></span><span>{eventDate}</span></div>
      <div class="wb-badge" role="listitem"><span class="wb-badge-svg" aria-hidden="true"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg></span><span>{eventTime}</span></div>
      <div class="wb-badge" role="listitem"><span class="wb-badge-svg" aria-hidden="true"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 10l5 5-5 5"/><path d="M4 4v7a4 4 0 0 0 4 4h12"/></svg></span><span>{eventPlatform}</span></div>
    </div>
    <div class="wb-pricing-row">
      <span class="wb-price-original"><s>{priceOriginal}</s></span>
      <span class="wb-price-regular">{priceRegular}</span>
      <span class="wb-price-eb">{priceEarlyBird}</span>
      <span class="wb-price-label">untuk {seatLeft} orang pertama</span>
    </div>
    <a href={ctaHref} class="wb-cta-btn" id="wb-hero-cta">
      {ctaText} &mdash; {priceEarlyBird}
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
    </a>
    <div class="wb-countdown-wrap" id="wb-countdown-wrap" aria-live="polite">
      <p class="wb-countdown-label">Early bird berakhir dalam:</p>
      <div class="wb-countdown">
        <div class="wb-cd-unit"><span class="wb-cd-num" id="wb-cd-days">--</span><span class="wb-cd-lbl">Hari</span></div>
        <span class="wb-cd-sep" aria-hidden="true">:</span>
        <div class="wb-cd-unit"><span class="wb-cd-num" id="wb-cd-hours">--</span><span class="wb-cd-lbl">Jam</span></div>
        <span class="wb-cd-sep" aria-hidden="true">:</span>
        <div class="wb-cd-unit"><span class="wb-cd-num" id="wb-cd-mins">--</span><span class="wb-cd-lbl">Menit</span></div>
        <span class="wb-cd-sep" aria-hidden="true">:</span>
        <div class="wb-cd-unit"><span class="wb-cd-num" id="wb-cd-secs">--</span><span class="wb-cd-lbl">Detik</span></div>
      </div>
    </div>
  </div>
</section>

<style>
  .wb-earlybird-bar {
    position: sticky; top: 0; z-index: 100;
    background: #0F172A; color: #fff;
    display: flex; align-items: center; justify-content: center; gap: 10px;
    padding: 10px 16px; font-size: 14px; flex-wrap: wrap; text-align: center;
  }
  .wb-eb-btn {
    background: #FF6B1A; color: #fff; padding: 5px 14px; border-radius: 999px;
    font-size: 13px; font-weight: 700; text-decoration: none; white-space: nowrap;
    transition: background 0.18s;
  }
  .wb-eb-btn:hover { background: #e55c0e; }
  .wb-eb-icon { display: inline-flex; color: #FF9A3C; }
  .wb-badge-svg { display: inline-flex; color: var(--orange-500, #FF6B1A); }
  .wb-hero {
    position: relative; overflow: hidden;
    background: var(--bg-warm, #FFF8F3);
    padding: 80px 0 88px; text-align: center;
  }
  .wb-blob { position: absolute; border-radius: 50%; pointer-events: none; filter: blur(80px); opacity: 0.35; }
  .wb-blob-1 { width: 500px; height: 500px; background: radial-gradient(circle, #FF9A3C 0%, #FF6B1A 60%, transparent 100%); bottom: -160px; left: -120px; }
  .wb-blob-2 { width: 380px; height: 380px; background: radial-gradient(circle, #FEC89A 0%, transparent 70%); top: -80px; right: -80px; }
  .wb-hero-inner { position: relative; z-index: 1; display: flex; flex-direction: column; align-items: center; }
  .wb-eyebrow {
    display: inline-block; background: var(--orange-100, #FFE8D6); color: var(--orange-700, #C2410C);
    font-size: 12.5px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase;
    padding: 6px 16px; border-radius: 999px; margin-bottom: 24px;
  }
  .wb-hero-title {
    font-size: clamp(38px, 6vw, 68px); font-weight: 900; line-height: 1.1;
    color: var(--ink-900, #0F172A); margin: 0 0 20px; max-width: 820px; letter-spacing: -0.02em;
  }
  .wb-title-accent {
    background: linear-gradient(135deg, #FF6B1A 0%, #FF9A3C 100%);
    -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;
  }
  .wb-hero-desc { font-size: 18px; color: var(--ink-600, #475569); max-width: 600px; line-height: 1.65; margin: 0 0 32px; }
  .wb-meta-badges { display: flex; align-items: center; justify-content: center; gap: 10px; flex-wrap: wrap; margin-bottom: 28px; }
  .wb-badge {
    display: inline-flex; align-items: center; gap: 7px; background: white;
    border: 1.5px solid var(--orange-200, #FFCBA4); border-radius: 999px;
    padding: 8px 16px; font-size: 14px; font-weight: 600; color: var(--ink-800, #1E293B);
    box-shadow: 0 1px 4px rgba(0,0,0,0.06);
  }
  .wb-pricing-row { display: flex; align-items: center; justify-content: center; gap: 10px; margin-bottom: 24px; flex-wrap: wrap; }
  .wb-price-original { font-size: 14px; color: var(--ink-400, #94A3B8); }
  .wb-price-regular { font-size: 16px; font-weight: 600; color: var(--ink-700, #334155); }
  .wb-price-eb { font-size: 22px; font-weight: 800; color: var(--orange-600, #EA580C); }
  .wb-price-label { font-size: 13px; color: var(--ink-500, #64748B); background: var(--orange-50, #FFF4EC); border: 1px solid var(--orange-200, #FFCBA4); border-radius: 999px; padding: 3px 12px; }
  .wb-cta-btn {
    display: inline-flex; align-items: center; gap: 10px;
    background: linear-gradient(135deg, #FF6B1A 0%, #FF8C3A 100%);
    color: #fff; font-size: 17px; font-weight: 700; padding: 16px 36px;
    border-radius: var(--radius-xl, 16px); text-decoration: none;
    box-shadow: 0 8px 24px rgba(255,107,26,0.35);
    transition: transform 0.2s, box-shadow 0.2s; margin-bottom: 32px;
  }
  .wb-cta-btn:hover { transform: translateY(-2px); box-shadow: 0 12px 32px rgba(255,107,26,0.45); }
  .wb-countdown-wrap { display: flex; flex-direction: column; align-items: center; gap: 12px; }
  .wb-countdown-label { font-size: 13px; font-weight: 600; color: var(--ink-500, #64748B); text-transform: uppercase; letter-spacing: 0.06em; margin: 0; }
  .wb-countdown { display: flex; align-items: center; gap: 8px; }
  .wb-cd-unit {
    display: flex; flex-direction: column; align-items: center; gap: 4px;
    background: white; border: 1.5px solid var(--orange-200, #FFCBA4);
    border-radius: 12px; padding: 12px 18px; min-width: 64px;
    box-shadow: 0 2px 8px rgba(255,107,26,0.08);
  }
  .wb-cd-num { font-size: 28px; font-weight: 800; color: var(--orange-600, #EA580C); line-height: 1; font-variant-numeric: tabular-nums; }
  .wb-cd-lbl { font-size: 10px; font-weight: 600; color: var(--ink-400, #94A3B8); text-transform: uppercase; letter-spacing: 0.08em; }
  .wb-cd-sep { font-size: 24px; font-weight: 700; color: var(--orange-400, #FB923C); margin-bottom: 12px; }
  /* Tablet */
  @media (max-width: 768px) {
    .wb-hero { padding: 64px 0 72px; }
    .wb-hero-desc { font-size: 16px; padding: 0 16px; }
    .wb-meta-badges { gap: 8px; padding: 0 16px; }
    .wb-badge { font-size: 13px; padding: 6px 12px; }
    .wb-cta-btn { font-size: 15px; padding: 14px 28px; }
    .wb-pricing-row { padding: 0 16px; }
  }

  /* Mobile */
  @media (max-width: 480px) {
    .wb-earlybird-bar { font-size: 12.5px; padding: 8px 12px; gap: 6px; }
    .wb-eb-btn { font-size: 12px; padding: 4px 12px; }
    .wb-hero { padding: 48px 0 56px; }
    .wb-eyebrow { font-size: 11px; padding: 5px 12px; margin-bottom: 16px; }
    .wb-hero-title { margin-bottom: 14px; }
    .wb-hero-desc { font-size: 15px; margin-bottom: 24px; line-height: 1.55; }
    .wb-meta-badges { flex-direction: column; gap: 8px; }
    .wb-badge { width: 100%; justify-content: center; font-size: 13px; }
    .wb-pricing-row { flex-direction: column; gap: 6px; }
    .wb-price-eb { font-size: 20px; }
    .wb-cta-btn { font-size: 14px; padding: 14px 20px; width: calc(100% - 32px); justify-content: center; box-sizing: border-box; }
    .wb-countdown { gap: 4px; }
    .wb-cd-unit { padding: 8px 10px; min-width: 48px; border-radius: 10px; }
    .wb-cd-num { font-size: 20px; }
    .wb-cd-sep { font-size: 18px; }
    .wb-cd-lbl { font-size: 9px; }
  }
</style>

<script define:vars={{ earlyBirdDeadline }} is:inline>
  (function() {
    var deadline = new Date(earlyBirdDeadline).getTime();
    var elD = document.getElementById('wb-cd-days');
    var elH = document.getElementById('wb-cd-hours');
    var elM = document.getElementById('wb-cd-mins');
    var elS = document.getElementById('wb-cd-secs');
    var wrap = document.getElementById('wb-countdown-wrap');
    function pad(n) { return String(n).padStart(2, '0'); }
    function tick() {
      var diff = deadline - Date.now();
      if (diff <= 0) { if (wrap) wrap.style.display = 'none'; return; }
      if (elD) elD.textContent = pad(Math.floor(diff / 86400000));
      if (elH) elH.textContent = pad(Math.floor((diff % 86400000) / 3600000));
      if (elM) elM.textContent = pad(Math.floor((diff % 3600000) / 60000));
      if (elS) elS.textContent = pad(Math.floor((diff % 60000) / 1000));
    }
    tick();
    var iv = setInterval(tick, 1000);
    document.addEventListener('astro:before-swap', function() { clearInterval(iv); }, { once: true });
  })();
</script>
