---
import { getLang } from '@i18n/utils';

const lang = getLang(Astro.currentLocale);

const benefits = lang === 'en' ? [
  {
    icon: '/assets/v2/images/animation-step-3.svg',
    alt: 'support vector icon',
    title: '1-on-1 Support',
    desc: 'Direct support from an experienced team of specialists in their field'
  },
  {
    icon: '/assets/v2/images/animation-step-1.svg',
    alt: 'platform vector icon',
    title: 'Direct Platform Access',
    desc: 'Connect directly with representatives from Google, Meta, and TikTok according to your business needs'
  },
  {
    icon: '/assets/v2/images/icon-arrow.svg',
    alt: 'rewards vector icon',
    title: 'Rewards Office Visit',
    desc: 'Eligible spending accounts get invited to Google, Meta, and TikTok offices to learn directly and gain insights from HQ'
  },
  {
    icon: '/assets/v2/images/animation-main.svg',
    alt: 'partnership vector icon',
    title: 'Long-Term Partnership',
    desc: 'We focus beyond transactions, building long-term relationships to help your business grow continuously.'
  },
  {
    icon: '/assets/v2/images/animation-step-2.svg',
    alt: 'consultation vector icon',
    title: 'Strategic Consultation',
    desc: 'Not just managing accounts, but providing strategic insights and recommendations to support your advertising decisions.'
  },
  {
    icon: '/assets/v2/images/animation-step-4.svg',
    alt: 'discount vector icon',
    title: 'Save 11% More',
    desc: 'Stable ad performance without worrying about an extra 11% fee, making your budget more efficient'
  }
] : [
  {
    icon: '/assets/v2/images/animation-step-3.svg',
    alt: 'support vector icon',
    title: 'Support 1-on-1',
    desc: 'Kita berikan dukungan langsung dari tim berpengalaman dan spesialis di bidangnya'
  },
  {
    icon: '/assets/v2/images/animation-step-1.svg',
    alt: 'platform vector icon',
    title: 'Akses ke platform langsung',
    desc: 'Terhubung langsung dengan orang google,meta dan tiktok sesuai kebutuhan bisnis kamu'
  },
  {
    icon: '/assets/v2/images/icon-arrow.svg',
    alt: 'rewards vector icon',
    title: 'Rewards Office Visit',
    desc: 'Buat kamu yang memenuhi syarat spending kita ajak ke kantor google,meta dan tiktok untuk belajar langsung sambil nambah insight dari pusatnya'
  },
  {
    icon: '/assets/v2/images/animation-main.svg',
    alt: 'partnership vector icon',
    title: 'Long-Term Partnership',
    desc: 'Kami tidak hanya fokus pada transaksi, tetapi membangun hubungan jangka panjang untuk membantu bisnis kamu terus berkembang.'
  },
  {
    icon: '/assets/v2/images/animation-step-2.svg',
    alt: 'consultation vector icon',
    title: 'Strategic Consultation',
    desc: 'Bukan hanya membantu akun, tetapi memberikan insight dan rekomendasi untuk mendukung keputusan advertising kamu.'
  },
  {
    icon: '/assets/v2/images/animation-step-4.svg',
    alt: 'discount vector icon',
    title: 'Lebih Hemat 11%',
    desc: 'Iklan stabil tanpa khawatir biaya tambahan 11%, budget jadi lebih efisien'
  }
];
---

<section class="why-us-section" style="padding: 64px 0; position: relative;">
  <div class="container">
    <div class="why-us-header" style="text-align: center; margin-bottom: 48px;">
      {lang === 'en' ? (
        <h2 class="why-us-title">
          Why clients choose <span style="color: var(--orange-500, #FF7A1A);">Tentaklik</span>
        </h2>
      ) : (
        <h2 class="why-us-title">
          Kenapa klien memilih <span style="color: var(--orange-500, #FF7A1A);">Tentaklik</span>
        </h2>
      )}
    </div>

    <div class="why-us-grid">
      {benefits.map((b) => (
        <div class="why-us-card reveal">
          <div class="why-us-card-icon">
            <img src={b.icon} alt={b.alt} loading="lazy" width="40" height="40" />
          </div>
          <h3 class="why-us-card-title">{b.title}</h3>
          <p class="why-us-card-desc">{b.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .why-us-title {
    font-size: clamp(26px, 4vw, 36px);
    font-weight: 800;
    color: var(--ink-900, #1F1A17);
    line-height: 1.2;
    letter-spacing: -0.02em;
  }

  .why-us-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  .why-us-card {
    background: #FFFDF9;
    border: 1px solid rgba(255, 122, 26, 0.12);
    border-radius: 20px;
    padding: 32px 28px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
  }

  .why-us-card:hover {
    transform: translateY(-4px);
    border-color: rgba(255, 122, 26, 0.32);
    box-shadow: 0 14px 32px rgba(255, 122, 26, 0.08);
  }

  .why-us-card-icon {
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: flex-start;
    margin-bottom: 20px;
  }

  .why-us-card-icon img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
  }

  .why-us-card-title {
    font-size: 19px;
    font-weight: 700;
    color: var(--ink-900, #1F1A17);
    margin-bottom: 10px;
    line-height: 1.35;
  }

  .why-us-card-desc {
    font-size: 14.5px;
    color: var(--ink-500, #666);
    line-height: 1.6;
    margin: 0;
  }

  @media (max-width: 992px) {
    .why-us-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 20px;
    }
  }

  @media (max-width: 640px) {
    .why-us-grid {
      grid-template-columns: 1fr;
      gap: 16px;
    }
    .why-us-card {
      padding: 24px 20px;
      align-items: center;
      text-align: center;
    }
    .why-us-card-icon {
      justify-content: center;
    }
  }
</style>
