---
const portfolios = [
  {
    title: 'PT. Grajevan',
    category: 'Company Profile',
    desc: 'Company profile perusahaan konstruksi & manufaktur lengkap dengan katalog layanan, visi misi, dan desain elegan.',
    image: '/assets/redesign/grajevan-mockup-min.png',
  },
  {
    title: 'PT. Media Pelajar',
    category: 'Lembaga Pendidikan & Jasa',
    desc: 'Website resmi jasa ujian persamaan dan kejar paket kesetaraan legal berstandar nasional dengan formulir pendaftaran online.',
    image: '/assets/redesign/jasa-ujian-persamaan-mockup-min.png',
  },
  {
    title: 'Rumah Yatim Indonesia',
    category: 'Organisasi & Crowdfunding',
    desc: 'Platform lembaga sosial dengan sistem donasi online, laporan program transparan, dan integrasi payment gateway.',
    image: '/assets/redesign/rumah-yatim-indonesia-mockup-min.png',
  },
  {
    title: 'PT. Karya Kita',
    category: 'Arsitektur & Interior',
    desc: 'Showcase portofolio visual arsitektur & interior dengan galeri interaktif dan tombol konsultasi WhatsApp langsung.',
    image: '/assets/redesign/karya-kita-desain-mockup-min.png',
  },
  {
    title: 'PT. Tunas Mobilindo',
    category: 'Otomotif & Dealer Showroom',
    desc: 'Website katalog mobil premium dengan spesifikasi mendalam, perbandingan tipe, simulasi kredit, dan daftar harga.',
    image: '/assets/redesign/promo-bmw-mockup-min.png',
  },
  {
    title: 'Aksi Indonesia',
    category: 'Event & Yayasan Sosial',
    desc: 'Website organisasi sosial untuk publikasi kegiatan kerelawanan, kampanye sosial, dan galang dana publik.',
    image: '/assets/redesign/aksi-indonesia-mockup-min.png',
  },
];
---

<section id="portofolio" class="py-20 lg:py-28 bg-gray-50/60 relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-orange-50 border border-orange-200 text-[#FF7A1A] text-xs font-bold uppercase tracking-wider mb-4">
        Hasil Karya Nyata
      </div>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-[#0E1B2A] tracking-tight mb-4">
        Portofolio Proyek Klien Kami
      </h2>
      <p class="text-gray-600 text-base sm:text-lg">
        Berbagai website yang telah kami bangun dengan desain modern, kecepatan tinggi, dan teroptimasi untuk konversi di berbagai lini industri.
      </p>
    </div>

    <!-- 6 Portfolios Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 mb-14">
      {portfolios.map((item) => (
        <div class="bg-white rounded-2xl overflow-hidden border border-gray-100 shadow-sm hover:shadow-xl hover:border-orange-200 transition-all duration-300 group flex flex-col">
          <!-- Mockup Image Preview -->
          <div class="relative bg-gradient-to-tr from-gray-100 to-gray-50 p-6 flex items-center justify-center overflow-hidden">
            <img
              src={item.image}
              alt={`Mockup ${item.title}`}
              class="w-full h-auto object-contain rounded-lg shadow-sm transform group-hover:scale-105 transition-transform duration-300"
              loading="lazy"
            />
            <span class="absolute top-4 left-4 px-2.5 py-1 rounded-full text-[11px] font-bold bg-white/90 backdrop-blur-xs text-[#0E1B2A] shadow-2xs border border-gray-100">
              {item.category}
            </span>
          </div>

          <!-- Card Content -->
          <div class="p-6 flex-1 flex flex-col justify-between">
            <div>
              <h3 class="text-xl font-bold text-[#0E1B2A] group-hover:text-[#FF7A1A] transition-colors mb-2">
                {item.title}
              </h3>
              <p class="text-gray-600 text-sm leading-relaxed">
                {item.desc}
              </p>
            </div>
            
            <div class="mt-6 pt-4 border-t border-gray-100 flex items-center justify-between text-xs font-semibold text-gray-500">
              <span class="text-emerald-600 flex items-center gap-1.5 font-bold">
                <span class="w-2 h-2 rounded-full bg-emerald-500"></span> Live & Teruji
              </span>
              <span class="text-[#FF7A1A] group-hover:translate-x-1 transition-transform inline-flex items-center gap-1 font-bold">
                Lihat Detail &rarr;
              </span>
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- Section Bottom CTA -->
    <div class="text-center">
      <p class="text-sm font-medium text-gray-600 mb-4">
        Ingin website bisnis Anda tampil sekeren dan seprofesional ini?
      </p>
      <a
        href="#harga"
        class="inline-flex items-center gap-2 px-6 py-3.5 rounded-xl bg-[#FF7A1A] hover:bg-[#F26416] text-white font-bold text-sm shadow-md shadow-orange-500/20 hover:shadow-lg transition-all"
      >
        <span>Pilih Paket Website Anda Sekarang</span>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
        </svg>
      </a>
    </div>

  </div>
</section>
