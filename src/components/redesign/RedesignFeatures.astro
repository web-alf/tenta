---
const features = [
  {
    title: 'Desain Elegan & Eksklusif',
    desc: 'Tampilan website modern yang disesuaikan dengan identitas brand Anda, bukan template pasaran yang kaku.',
    icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01"></path></svg>`,
  },
  {
    title: 'Hosting Super Stabil & Cepat',
    desc: 'Infrastruktur cloud berkecepatan tinggi dengan garansi uptime 99.9% agar website selalu siap melayani pelanggan.',
    icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2m-2-4h.01M17 16h.01"></path></svg>`,
  },
  {
    title: '100% Mobile-First Responsive',
    desc: 'Tampilan diatur rapi untuk smartphone, tablet, dan laptop. Mayoritas traffic berasal dari HP, jadi responsivitas adalah prioritas.',
    icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"></path></svg>`,
  },
  {
    title: 'Panduan & Dashboard Mudah',
    desc: 'Anda mendapatkan akses admin 100% dan tutorial panduan sederhana untuk memperbarui teks, foto, maupun produk mandiri.',
    icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path></svg>`,
  },
  {
    title: 'User Experience Berorientasi Konversi',
    desc: 'Struktur informasi dibuat rapi dengan tombol WhatsApp dan call-to-action strategis agar pengunjung mudah menghubungi Anda.',
    icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.828 14.828a4 4 0 01-5.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>`,
  },
  {
    title: 'SEO Friendly & Terindeks Google',
    desc: 'Dilengkapi meta tag lengkap, sitemap XML, dan schema markup agar website Anda cepat dikenali mesin pencari Google.',
    icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>`,
  },
];
---

<section id="fitur" class="py-20 lg:py-28 bg-white relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Heading -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-orange-50 border border-orange-200 text-[#FF7A1A] text-xs font-bold uppercase tracking-wider mb-4">
        Bisnis Online Lebih Nyaman
      </div>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-[#0E1B2A] tracking-tight mb-4">
        Fitur Unggulan Yang Anda Dapatkan
      </h2>
      <p class="text-gray-600 text-base sm:text-lg">
        Seluruh paket website Tentaklik sudah dilengkapi teknologi terkini yang siap pakai tanpa biaya tersembunyi.
      </p>
    </div>

    <!-- 6 Features Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {features.map((f) => (
        <div class="rounded-2xl p-8 bg-gray-50/70 border border-gray-100 hover:border-orange-200 hover:bg-white hover:shadow-xl transition-all duration-300 group flex flex-col justify-between">
          <div>
            <div class="w-12 h-12 rounded-xl bg-orange-100/70 text-[#FF7A1A] group-hover:bg-[#FF7A1A] group-hover:text-white transition-all duration-200 flex items-center justify-center mb-6">
              <Fragment set:html={f.icon} />
            </div>
            <h3 class="text-xl font-bold text-[#0E1B2A] group-hover:text-[#FF7A1A] transition-colors mb-3">
              {f.title}
            </h3>
            <p class="text-gray-600 text-sm leading-relaxed">
              {f.desc}
            </p>
          </div>
          <div class="mt-6 pt-4 border-t border-gray-200/50 flex items-center gap-1 text-xs font-bold text-emerald-600">
            <span>✓ Sudah Termasuk</span>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
