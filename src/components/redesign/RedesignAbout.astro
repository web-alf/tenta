---
const values = [
  {
    icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"></path></svg>`,
    title: 'Trafik & Leads Lebih Melimpah',
    desc: 'Pelanggan modern mencari solusi secara online lewat Google dan media sosial. Website profesional memastikan bisnis Anda mudah ditemukan dan siap menyambut prospek kapan saja.',
  },
  {
    icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path></svg>`,
    title: 'Jangkauan Target Market Luas',
    desc: 'Tak lagi dibatasi toko fisik atau jangkauan lokal. Website membuka akses pasar nasional hingga internasional tanpa perlu menambah biaya sewa tempat operasional.',
  },
  {
    icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>`,
    title: 'Bisnis Makin Tersistem & Otomatis',
    desc: 'Website bukan sekadar pajangan. Integrasi formulir pemesanan, WhatsApp chatbot, katalog produk, dan laporan terpusat membuat operasional bisnis jauh lebih tertata.',
  },
];
---

<section id="tentang" class="py-20 lg:py-28 bg-white relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Part 1: Main About Split (Image + Copy) -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center mb-24">
      <!-- Left: High quality illustration -->
      <div class="lg:col-span-6 order-2 lg:order-1">
        <div class="relative rounded-2xl bg-orange-50/50 p-4 border border-orange-100 shadow-xl overflow-hidden group">
          <img
            src="/assets/redesign/jasa-pembuatan-website-after-sales-terbaik-min.webp"
            alt="Solusi Digital Marketing dan Website Tentaklik"
            class="w-full h-auto rounded-xl object-cover transform group-hover:scale-105 transition-transform duration-500"
            width="960"
            height="640"
            loading="lazy"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-black/20 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity"></div>
        </div>
      </div>

      <!-- Right: Content -->
      <div class="lg:col-span-6 order-1 lg:order-2">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-orange-50 border border-orange-200 text-[#FF7A1A] text-xs font-bold uppercase tracking-wider mb-4">
          Kenapa Harus Website?
        </div>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-[#0E1B2A] tracking-tight leading-tight mb-6">
          Solusi Terbaik Buat Sukses Di Era Digital
        </h2>
        <div class="space-y-4 text-gray-600 text-base sm:text-lg leading-relaxed mb-8">
          <p>
            Perkembangan teknologi membuat bisnis tidak lagi optimal jika hanya mengandalkan cara konvensional yang menyita waktu dan biaya operasional besar.
          </p>
          <p>
            Bisnis Anda bakal jauh lebih cepat bertumbuh dan dipercaya calon klien jika mampu beradaptasi memanfaatkan kehadiran digital yang kredibel. Bersama <strong class="text-[#0E1B2A] font-semibold">Tentaklik</strong>, bangun aset website yang bekerja 24 jam nonstop untuk bisnis Anda!
          </p>
        </div>

        <a
          href="#harga"
          class="inline-flex items-center gap-2 px-6 py-3.5 rounded-xl bg-[#0E1B2A] hover:bg-[#1A2A3D] text-white font-semibold text-sm shadow-md hover:shadow-lg transition-all duration-200 hover:-translate-y-0.5"
        >
          <span>Lihat Pilihan Paket</span>
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
      </div>
    </div>

    <!-- Part 2: 3 Value Proposition Cards -->
    <div class="bg-gradient-to-b from-orange-50/50 to-white rounded-3xl p-8 sm:p-12 border border-orange-100/80 shadow-sm">
      <div class="text-center max-w-3xl mx-auto mb-14">
        <span class="text-xs font-bold uppercase tracking-widest text-[#FF7A1A]">Dampak Nyata Untuk Bisnis</span>
        <h3 class="text-2xl sm:text-4xl font-extrabold text-[#0E1B2A] mt-2 mb-4">
          Bukan Sekadar Tampil Keren, Tapi Menghasilkan
        </h3>
        <p class="text-gray-600 text-base sm:text-lg">
          Kami memastikan setiap baris kode dan rancangan desain memiliki fungsi konversi yang terukur untuk pertumbuhan bisnis Anda.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {values.map((v) => (
          <div class="bg-white rounded-2xl p-8 border border-gray-100 shadow-sm hover:shadow-md hover:border-orange-200 transition-all duration-200 group flex flex-col justify-between">
            <div>
              <div class="w-14 h-14 rounded-2xl bg-orange-50 text-[#FF7A1A] group-hover:bg-[#FF7A1A] group-hover:text-white transition-all duration-200 flex items-center justify-center mb-6 shadow-2xs">
                <Fragment set:html={v.icon} />
              </div>
              <h4 class="text-xl font-bold text-[#0E1B2A] mb-3 group-hover:text-[#FF7A1A] transition-colors">
                {v.title}
              </h4>
              <p class="text-gray-600 text-sm leading-relaxed">
                {v.desc}
              </p>
            </div>
            <div class="mt-6 pt-4 border-t border-gray-50 flex items-center gap-1 text-xs font-bold text-[#FF7A1A]">
              <span>Benefit Unggulan</span>
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" />
              </svg>
            </div>
          </div>
        ))}
      </div>
    </div>

  </div>
</section>
