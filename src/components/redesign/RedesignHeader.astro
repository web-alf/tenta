---
import TentaklikLogo from '@components/brand/TentaklikLogo.astro';
import WhatsApp from '@components/icons/WhatsApp.astro';
import { waLink } from '@data/site';

const navLinks = [
  { label: 'Beranda', href: '#beranda' },
  { label: 'Tentang', href: '#tentang' },
  { label: 'Portofolio', href: '#portofolio' },
  { label: 'Fitur', href: '#fitur' },
  { label: 'Harga', href: '#harga' },
  { label: 'FAQ', href: '#faq' },
];

const consultationWaUrl = waLink('Halo Tentaklik, saya ingin konsultasi pembuatan website');
---

<header class="sticky top-0 z-50 w-full bg-white/95 backdrop-blur-md border-b border-gray-100 shadow-xs transition-all duration-200" id="redesign-header">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
    <!-- Brand Logo -->
    <a href="#beranda" class="flex items-center gap-2 group transition-transform duration-200 hover:scale-[1.02]" aria-label="Tentaklik Beranda">
      <TentaklikLogo size={24} />
    </a>

    <!-- Desktop Navigation -->
    <nav class="hidden md:flex items-center gap-8" aria-label="Menu Navigasi">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class="text-sm font-semibold text-gray-700 hover:text-[#FF7A1A] transition-colors duration-150 py-1 relative after:absolute after:bottom-0 after:left-0 after:w-0 after:h-0.5 after:bg-[#FF7A1A] hover:after:w-full after:transition-all after:duration-200"
        >
          {link.label}
        </a>
      ))}
    </nav>

    <!-- Header Action Button -->
    <div class="hidden md:flex items-center gap-4">
      <a
        href={consultationWaUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-[#FF7A1A] hover:bg-[#F26416] text-white text-sm font-semibold shadow-md shadow-orange-500/20 hover:shadow-lg hover:shadow-orange-500/30 transition-all duration-200 hover:-translate-y-0.5"
      >
        <WhatsApp size={16} class="text-white" />
        <span>Konsultasi</span>
      </a>
    </div>

    <!-- Mobile Hamburger Button -->
    <button
      type="button"
      id="redesign-mobile-btn"
      class="md:hidden inline-flex items-center justify-center p-2.5 rounded-xl text-gray-700 hover:text-[#FF7A1A] hover:bg-orange-50/80 transition-colors"
      aria-label="Buka menu navigasi"
      aria-expanded="false"
    >
      <svg id="icon-menu-open" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
      <svg id="icon-menu-close" class="w-6 h-6 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <!-- Mobile Menu Dropdown -->
  <div id="redesign-mobile-menu" class="hidden md:hidden border-t border-gray-100 bg-white/98 px-6 py-5 shadow-xl transition-all">
    <div class="flex flex-col gap-4">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class="mobile-nav-link text-base font-semibold text-gray-800 hover:text-[#FF7A1A] py-1 transition-colors"
        >
          {link.label}
        </a>
      ))}
      <div class="pt-2 border-t border-gray-100">
        <a
          href={consultationWaUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="w-full inline-flex items-center justify-center gap-2 px-5 py-3 rounded-full bg-[#FF7A1A] hover:bg-[#F26416] text-white text-sm font-semibold shadow-md shadow-orange-500/20"
        >
          <WhatsApp size={18} class="text-white" />
          <span>Konsultasi Sekarang</span>
        </a>
      </div>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById('redesign-mobile-btn');
  const menu = document.getElementById('redesign-mobile-menu');
  const openIcon = document.getElementById('icon-menu-open');
  const closeIcon = document.getElementById('icon-menu-close');
  const mobileLinks = document.querySelectorAll('.mobile-nav-link');

  if (btn && menu && openIcon && closeIcon) {
    btn.addEventListener('click', () => {
      const isExpanded = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', String(!isExpanded));
      menu.classList.toggle('hidden');
      openIcon.classList.toggle('hidden');
      closeIcon.classList.toggle('hidden');
    });

    mobileLinks.forEach((link) => {
      link.addEventListener('click', () => {
        menu.classList.add('hidden');
        openIcon.classList.remove('hidden');
        closeIcon.classList.add('hidden');
        btn.setAttribute('aria-expanded', 'false');
      });
    });
  }
</script>
